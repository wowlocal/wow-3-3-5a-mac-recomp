+COMPAT_TEST(compat_client_index_snapshots) {
+    clear();
+    pixelProjection();
+    const GLfloat positions[] = {0, 0, 32, 0, 32, 64, 0, 64, 32, 0, 64, 0, 64, 64, 32, 64};
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+    glVertexPointer(2, GL_FLOAT, 0, positions);
+    glEnableClientState(GL_VERTEX_ARRAY);
+    const GLushort left[] = {0, 1, 2, 0, 2, 3};
+    const GLuint right[] = {4, 5, 6, 4, 6, 7};
+    alignas(4) uint8_t storage[sizeof(right) + 1] = {};
+    std::memcpy(storage + 1, left, sizeof(left));
+    glColor3f(1, 0, 0);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, storage + 1);
+    std::memcpy(storage + 1, right, sizeof(right));
+    glColor3f(0, 1, 0);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_INT, storage + 1);
+    std::memset(storage + 1, 0, sizeof(right));
+    CHECK(pixel(16, 32, kRed));
+    CHECK(pixel(48, 32, kGreen));
+
+    // A genuine 0xffff index with primitive restart disabled must survive.
+    clear();
+    std::vector<GLfloat> large(65536 * 2, 0);
+    large[2] = 64;
+    large[65535 * 2 + 1] = 64;
+    glVertexPointer(2, GL_FLOAT, 0, large.data());
+    glColor3f(0, 0, 1);
+    const GLushort largest[] = {0, 1, 65535};
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, largest);
+    CHECK(pixel(16, 16, kBlue));
+    glDisableClientState(GL_VERTEX_ARRAY);
