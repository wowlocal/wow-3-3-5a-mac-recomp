+/* Private render-item descriptors for the verified i386 scene dispatcher. */
+#define RAID_DESC_OFF(member) ((uint32_t)offsetof(OcerzCPU, raid_descriptor.member))
+enum {
+    RAID_DESC_BEGIN = 0x97d31d, RAID_DESC_PREFIX = 0x97d331,
+    RAID_DESC_PUBLISH = 0x97d3fe, RAID_DESC_END = 0x97d404,
+    RAID_DESC_COUNTERS = 16,
+};
+
+_Static_assert(offsetof(OcerzCPU, raid_descriptor.read_context) < 16384,
+               "descriptor fields must fit four-byte scaled offsets");
+
+static int raid_desc_enabled(void)
+{
+    return ocerz_tcache_mode() == OCERZ_TC_OFF && ENV_ON("OCERZ_M32_RAID_DESCRIPTOR");
+}
+
+static int raid_desc_marker(uint64_t pc)
+{
+    return pc == RAID_DESC_BEGIN || pc == RAID_DESC_PREFIX || pc == RAID_DESC_PUBLISH || pc == RAID_DESC_END;
+}
+
+static void *raid_desc_counters(void)
+{
+    static int initialized;
+    static void *mapping;
+    if (initialized) return mapping;
+    initialized = 1;
+    const char *path = getenv("OCERZ_M32_RAID_DESCRIPTOR_LOG");
+    if (!path || !*path) return NULL;
+    int lse = 0;
+    size_t length = sizeof lse;
+    if (sysctlbyname("hw.optional.arm.FEAT_LSE", &lse, &length, NULL, 0) || !lse)
+        return NULL;
+    int fd = open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) return NULL;
+    const size_t bytes = RAID_DESC_COUNTERS * sizeof(uint64_t);
+    if (ftruncate(fd, (off_t)bytes) == 0) {
+        void *result = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (result != MAP_FAILED) mapping = result;
+    }
+    close(fd);
+    return mapping;
+}
+
+static void emit_raid_desc_count(A64Buf *b, unsigned slot)
+{
+    void *mapping = raid_desc_counters();
+    if (!mapping) return;
+    a64_mov_imm64(b, JTA, (uintptr_t)mapping + slot * sizeof(uint64_t));
+    a64_movz(b, JTU, 1, 0);
+    a64_emit32(b, 0xf8200000u | (JTU << 16) | (JTA << 5) | A64_ZR); /* STADD X14, [X15] */
+}
+
+static uint32_t *emit_raid_desc_check(A64Buf *b, uint32_t offset, int value)
+{
+    a64_ldr(b, 4, JTT, 20, offset);
+    a64_eor_reg(b, 0, JTT, JTT, value, 0);
+    uint32_t *failure = a64_label(b);
+    a64_cbnz(b, 0, JTT, 0);
+    return failure;
+}
+
+static void emit_raid_desc_begin(A64Buf *b)
+{
+    int context = pin_hreg(pin_slot(OCERZ_RAX));
+    int item = pin_hreg(pin_slot(OCERZ_RDX));
+    int frame = pin_hreg(pin_slot(OCERZ_RBP));
+    int index = pin_hreg(pin_slot(OCERZ_RBX));
+    int tag = pin_hreg(pin_slot(OCERZ_RCX));
+    emit_raid_desc_count(b, 0);
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(read_context));
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(pending_context));
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(pending_has_prefix));
+    uint32_t *miss_context = emit_raid_desc_check(b, RAID_DESC_OFF(prior_context), context);
+    uint32_t *miss_frame = emit_raid_desc_check(b, RAID_DESC_OFF(prior_frame), frame);
+    uint32_t *miss_index = emit_raid_desc_check(b, RAID_DESC_OFF(prior_next_index), index);
+    a64_str(b, 4, context, 20, RAID_DESC_OFF(read_context));
+    a64_patch_cbz(miss_context, a64_label(b));
+    a64_patch_cbz(miss_frame, a64_label(b));
+    a64_patch_cbz(miss_index, a64_label(b));
+    /* A skipped late publication cannot leave this descriptor eligible for a later item. */
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(prior_context));
+
+    a64_ubfx(b, 0, JTT, item, 0, 12);
+    a64_add_imm(b, 0, JTT, JTT, 0x2f);
+    uint32_t *page = a64_label(b); a64_tbnz(b, JTT, 12, 0);
+    a64_lsr_imm(b, 0, JTT, tag, 2);
+    uint32_t *small_tag = a64_label(b); a64_cbz(b, 0, JTT, 0);
+    a64_movz(b, JTT, 4, 0);
+    a64_eor_reg(b, 0, JTT, JTT, tag, 0);
+    uint32_t *unsupported_tag = a64_label(b); a64_cbnz(b, 0, JTT, 0);
+    a64_patch_cbz(small_tag, a64_label(b));
+
+    a64_add_ext_uxtw(b, JTA, JGB, item, 0);
+    a64_ldr(b, 4, JTT, JTA, 4);
+    a64_str(b, 4, tag, 20, RAID_DESC_OFF(pending_words[0]));
+    a64_str(b, 4, JTT, 20, RAID_DESC_OFF(pending_words[1]));
+    a64_lsr_imm(b, 0, JTT, tag, 2);
+    a64_movz(b, JTU, 3, 0);
+    a64_eor_reg(b, 0, JTU, JTU, tag, 0);
+    uint32_t *zero_tag_four = a64_label(b); a64_cbnz(b, 0, JTT, 0);
+    uint32_t *zero_tag_three = a64_label(b); a64_cbz(b, 0, JTU, 0);
+    a64_ldr(b, 4, JTT, JTA, 0x2c);
+    uint32_t *save_item_word = a64_label(b); a64_b(b, 0);
+    a64_patch_cbz(zero_tag_four, a64_label(b));
+    a64_patch_cbz(zero_tag_three, a64_label(b));
+    a64_movz(b, JTT, 0, 0);
+    a64_patch_b(save_item_word, a64_label(b));
+    a64_str(b, 4, JTT, 20, RAID_DESC_OFF(pending_words[2]));
+    a64_str(b, 4, frame, 20, RAID_DESC_OFF(pending_frame));
+    a64_str(b, 4, context, 20, RAID_DESC_OFF(pending_context));
+    emit_raid_desc_count(b, 1);
+    a64_patch_tbz(page, a64_label(b));
+    a64_patch_cbz(unsupported_tag, a64_label(b));
+}
+
+static void emit_raid_desc_prefix(A64Buf *b)
+{
+    int context = pin_hreg(pin_slot(OCERZ_RCX));
+    int frame = pin_hreg(pin_slot(OCERZ_RBP));
+    int value = pin_hreg(pin_slot(OCERZ_RDX)); /* original material word already loaded */
+    uint32_t *miss_context = emit_raid_desc_check(b, RAID_DESC_OFF(pending_context), context);
+    uint32_t *miss_frame = emit_raid_desc_check(b, RAID_DESC_OFF(pending_frame), frame);
+    a64_str(b, 4, value, 20, RAID_DESC_OFF(pending_words[3]));
+    a64_movz(b, JTT, 1, 0);
+    a64_str(b, 4, JTT, 20, RAID_DESC_OFF(pending_has_prefix));
+    emit_raid_desc_count(b, 2);
+    a64_patch_cbz(miss_context, a64_label(b));
+    a64_patch_cbz(miss_frame, a64_label(b));
+}
+
+static void emit_raid_desc_publish(A64Buf *b)
+{
+    int context = pin_hreg(pin_slot(OCERZ_RDX));
+    int frame = pin_hreg(pin_slot(OCERZ_RBP));
+    int index = pin_hreg(pin_slot(OCERZ_RBX));
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(read_context));
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(prior_context));
+    uint32_t *miss_context = emit_raid_desc_check(b, RAID_DESC_OFF(pending_context), context);
+    uint32_t *miss_frame = emit_raid_desc_check(b, RAID_DESC_OFF(pending_frame), frame);
+    a64_ldr(b, 4, JTT, 20, RAID_DESC_OFF(pending_has_prefix));
+    uint32_t *miss_prefix = a64_label(b); a64_cbz(b, 0, JTT, 0);
+
+    for (int i = 0; i < 4; i++) {
+        a64_ldr(b, 4, JTT, 20, RAID_DESC_OFF(pending_words[0]) + 4 * i);
+        a64_str(b, 4, JTT, 20, RAID_DESC_OFF(prior_words[0]) + 4 * i);
+    }
+    a64_add_imm(b, 0, JTT, index, 1);
+    a64_str(b, 4, JTT, 20, RAID_DESC_OFF(prior_next_index));
+    a64_str(b, 4, frame, 20, RAID_DESC_OFF(prior_frame));
+    a64_str(b, 4, context, 20, RAID_DESC_OFF(prior_context));
+    emit_raid_desc_count(b, 3);
+
+    a64_patch_cbz(miss_context, a64_label(b));
+    a64_patch_cbz(miss_frame, a64_label(b));
+    a64_patch_cbz(miss_prefix, a64_label(b));
+    a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(pending_context));
+}
+
+static int raid_desc_access_supported(void)
+{
+    return g_pin_class == 3 && jgb_usable() && ocerz_guest_base &&
+           pin_slot(OCERZ_RAX) >= 0 && pin_slot(OCERZ_RBX) >= 0 && pin_slot(OCERZ_RCX) >= 0 &&
+           pin_slot(OCERZ_RDX) >= 0 && pin_slot(OCERZ_RDI) >= 0 && pin_slot(OCERZ_RBP) >= 0;
+}
+
+static void emit_raid_desc_marker(A64Buf *b, const X86Insn *insn)
+{
+    if (!raid_desc_access_supported() || insn->nops < 1) return;
+    const X86Operand *dest = &insn->ops[0];
+    if (insn->rip == RAID_DESC_END) {
+        if (insn->op == OCERZ_OP_INC && dest->kind == OCERZ_OPK_REG && dest->reg == OCERZ_RBX &&
+            dest->size == 4) {
+            a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(read_context));
+            a64_str(b, 4, A64_ZR, 20, RAID_DESC_OFF(pending_context));
+        }
+        return;
+    }
+    const X86Operand *src = &insn->ops[1];
+    if (insn->op != OCERZ_OP_MOV || insn->nops != 2 || insn->seg != OCERZ_SEG_NONE || insn->addrsize != 4 ||
+        dest->kind != OCERZ_OPK_MEM || dest->size != 4 || dest->index != OCERZ_REG_NONE ||
+        src->kind != OCERZ_OPK_REG || src->size != 4)
+        return;
+    switch (insn->rip) {
+    case RAID_DESC_BEGIN:
+        if (dest->base == OCERZ_RAX && dest->disp == 0x50 && src->reg == OCERZ_RDX) emit_raid_desc_begin(b);
+        break;
+    case RAID_DESC_PREFIX:
+        if (dest->base == OCERZ_RCX && dest->disp == 0x68 && src->reg == OCERZ_RDX) emit_raid_desc_prefix(b);
+        break;
+    case RAID_DESC_PUBLISH:
+        if (dest->base == OCERZ_RDX && dest->disp == 0x9c && src->reg == OCERZ_RAX) emit_raid_desc_publish(b);
+        break;
+    }
+}
+
+static int emit_raid_desc_load(A64Buf *b, const X86Insn *insn, const X86Operand *mem, int size, int rd)
+{
+    int slot, displacement, destination, opcode = OCERZ_OP_CMP;
+    switch (insn->rip) {
+    case 0x9791bf: slot = 0; displacement = 0x5c; destination = OCERZ_RCX; break;
+    case 0x979523: slot = 1; displacement = 0x64; destination = OCERZ_RAX; break;
+    case 0x979532: slot = 2; displacement = 0x94; destination = OCERZ_RDX; opcode = OCERZ_OP_MOV; break;
+    case 0x979553: slot = 3; displacement = 0x6c; destination = OCERZ_RDX; break;
+    default: return 0;
+    }
+    if (!insn->mode32 || !raid_desc_enabled() || !raid_desc_access_supported() ||
+        insn->seg != OCERZ_SEG_NONE || insn->addrsize != 4 || insn->op != opcode || insn->nops != 2 ||
+        insn->ops[0].kind != OCERZ_OPK_REG || insn->ops[0].size != 4 || insn->ops[0].reg != destination ||
+        mem != &insn->ops[1] || mem->kind != OCERZ_OPK_MEM || size != 4 || mem->disp != displacement ||
+        mem->base != OCERZ_RDI || mem->index != OCERZ_REG_NONE || mem->riprel ||
+        rd == JTT || rd == JTU || rd == JTA)
+        return 0;
+
+    /* Keep the original fault and memory order. Use the private operand only
+     * after its value and owning dispatcher frame pass the equality gate. */
+    if (!emit_mem_ea(b, insn, mem, JTA)) return 0;
+    uint32_t *skip = emit_commpage_guard(b, insn, JTA, NULL, NULL);
+    emit_add_const(b, JTA, ocerz_guest_base - ea_fold());
+    emit_guest_load_ordered(b, size, rd, JTA, JTU);
+    patch_guard_skip(skip, a64_label(b));
+    ea_cache_reset();
+
+    int context = pin_hreg(pin_slot(OCERZ_RDI));
+    int callee_frame = pin_hreg(pin_slot(OCERZ_RBP));
+    uint32_t *no_context = emit_raid_desc_check(b, RAID_DESC_OFF(read_context), context);
+    a64_add_ext_uxtw(b, JTA, JGB, callee_frame, 0);
+    a64_ldr(b, 4, JTU, JTA, 0);
+    uint32_t *no_frame = emit_raid_desc_check(b, RAID_DESC_OFF(prior_frame), JTU);
+    a64_ldr(b, 4, JTT, 20, RAID_DESC_OFF(prior_words[0]) + 4 * slot);
+    a64_eor_reg(b, 0, JTU, rd, JTT, 0);
+    uint32_t *mismatch = a64_label(b); a64_cbnz(b, 0, JTU, 0);
+    a64_mov_reg(b, 0, rd, JTT);
+    emit_raid_desc_count(b, 4 + 3 * slot);
+    uint32_t *used = a64_label(b); a64_b(b, 0);
+    a64_patch_cbz(mismatch, a64_label(b));
+    emit_raid_desc_count(b, 5 + 3 * slot);
+    uint32_t *kept = a64_label(b); a64_b(b, 0);
+    a64_patch_cbz(no_context, a64_label(b));
+    a64_patch_cbz(no_frame, a64_label(b));
+    emit_raid_desc_count(b, 6 + 3 * slot);
+    a64_patch_b(used, a64_label(b));
+    a64_patch_b(kept, a64_label(b));
+    return 1;
+}
