 static int raid_prep_memory_site(uint64_t pc)
 {
+    pthread_once(&raid_scene_pcs_once, raid_scene_load_pcs);
+    if (raid_scene_pcs) {
+        size_t first = 0, end = raid_scene_pc_count;
+        while (first < end) {
+            size_t middle = first + (end - first) / 2;
+            if (raid_scene_pcs[middle] < pc)
+                first = middle + 1;
+            else
+                end = middle;
+        }
+        return first < raid_scene_pc_count && raid_scene_pcs[first] == pc;
+    }
     return (pc >= 0x880c70 && pc < 0x882f20) ||
