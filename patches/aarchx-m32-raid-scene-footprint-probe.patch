+/* The optional little-endian PC table contains original instruction starts
+ * reached by the direct-call closure of the scene passes. */
+static pthread_once_t raid_scene_pcs_once = PTHREAD_ONCE_INIT;
+static const uint32_t *raid_scene_pcs;
+static size_t raid_scene_pc_count;
+
+static void raid_scene_load_pcs(void)
+{
+    const char *path = getenv("OCERZ_M32_RAID_SCENE_PCS");
+    if (!path) return;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    off_t bytes = fd < 0 ? -1 : lseek(fd, 0, SEEK_END);
+    if (bytes <= 0 || bytes > 1024 * 1024 || bytes % sizeof(uint32_t))
+        abort();
+    void *mapping = mmap(NULL, (size_t)bytes, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (mapping == MAP_FAILED)
+        abort();
+    raid_scene_pcs = mapping;
+    raid_scene_pc_count = (size_t)bytes / sizeof(uint32_t);
+    for (size_t i = 1; i < raid_scene_pc_count; i++)
+        if (raid_scene_pcs[i - 1] >= raid_scene_pcs[i])
+            abort();
+}
