diff --git a/src/m32_particle_plan.c b/src/m32_particle_plan.c
new file mode 100644
--- /dev/null
+++ b/src/m32_particle_plan.c
@@ -0,0 +1,362 @@
+/* Read-only diagnostic at the original mapped particle group boundaries. */
+#include "ocerz/interp.h"
+
+#include "ocerz/m32.h"
+#include "ocerz/mem.h"
+#include "ocerz/types.h"
+
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+enum {
+    MAP_RETURN = 0x97c8c3, FILL = 0x97c9fb, ADVANCE = 0x97ca30, UNMAP = 0x97c906,
+    TEXTURE_RETURN = 0x88303b, QUAD_CALL = 0x8831a9, QUAD_RETURN = 0x8831ae,
+    PARTICLE_READY = 0xda2e00, PARTICLE_LIMIT = 0xd2ff58,
+    PLAN = 1, CAPACITY = 1 << 22, MAX_GROUP = 128,
+};
+
+typedef struct {
+    uint64_t sequence, tick, cpu;
+    uint32_t site, frame, ordinal, ready;
+    uint32_t word[22];
+} Row;
+
+_Static_assert(sizeof(Row) == 128, "particle plan row");
+
+typedef union {
+    Row header;
+    struct {
+        _Atomic uint64_t count, armed, busy;
+    } state;
+} Header;
+
+static Header *header;
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+static pthread_once_t memory_once = PTHREAD_ONCE_INIT;
+static _Atomic uint64_t *memory_header;
+
+static void start_memory_log(void)
+{
+    const char *path = getenv("OCERZ_M32_PARTICLE_MEMORY_LOG");
+    if (!path || !*path) return;
+    int fd = open(path, O_CREAT | O_EXCL | O_RDWR | O_CLOEXEC, 0600);
+    if (fd < 0) return;
+    const size_t length = 64 * ((1ull << 25) + 1);
+    if (!ftruncate(fd, (off_t)length)) {
+        void *mapped = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (mapped != MAP_FAILED)
+            memory_header = mapped;
+    }
+    close(fd);
+}
+
+void *m32_particle_memory_ring(void)
+{
+    pthread_once(&memory_once, start_memory_log);
+    return memory_header;
+}
+
+static void start_log(void)
+{
+    const char *path = getenv("OCERZ_M32_PARTICLE_PLAN_LOG");
+    if (!path || !*path) return;
+    const int fd = open(path, O_CREAT | O_EXCL | O_RDWR | O_CLOEXEC, 0600);
+    if (fd < 0) return;
+    const size_t length = (CAPACITY + 1ull) * sizeof(Row);
+    if (!ftruncate(fd, (off_t)length)) {
+        void *mapped = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (mapped != MAP_FAILED)
+            header = mapped;
+    }
+    close(fd);
+}
+
+static int word(uint64_t guest, uint32_t *out)
+{
+    if (guest < 4096 || guest > UINT32_MAX - 3 || !ocerz_addr_readable(guest) ||
+        ((guest & 4095) > 4092 && !ocerz_addr_readable(guest + 3)))
+        return 0;
+    *out = m32_rd((uint32_t)guest);
+    return 1;
+}
+
+static void append(Row row)
+{
+    uint64_t index = atomic_fetch_add_explicit(&header->state.count, 1, memory_order_relaxed);
+    Row *destination = (Row *)header + 1 + (index & (CAPACITY - 1));
+    row.sequence = index + 1;
+    *destination = row;
+}
+
+typedef struct {
+    Row boundary;
+    uint32_t records;
+    Row plans[MAX_GROUP];
+    uint32_t eax, edx, esi, edi, esp, mxcsr, fcw;
+} Capture;
+
+static int texture_words(uint64_t texture, uint32_t *data)
+{
+    if (!texture)
+        return 1;
+    if (!word(texture + 0x28, &data[0]) || !word(texture + 0x40, &data[1]) ||
+        !word(texture + 0x44, &data[2]) || !word(texture + 0x5c, &data[3]))
+        return 0;
+    return !data[3] || (word((uint64_t)data[3] + 2, &data[4]) &&
+                        word((uint64_t)data[3] + 0x18, &data[5]));
+}
+
+/* Multiply as IEEE binary32, then round to a signed integer as the
+ * original FISTP does under the guarded nearest-even controls. The
+ * integer implementation leaves guest FP status and controls alone. */
+static uint64_t round_shift(uint64_t value, unsigned shift)
+{
+    if (!shift) return value;
+    if (shift >= 64) return 0;
+    uint64_t half = UINT64_C(1) << (shift - 1);
+    uint64_t whole = value >> shift;
+    uint64_t remainder = value & ((half << 1) - 1);
+    return whole + (remainder > half || (remainder == half && (whole & 1)));
+}
+
+static int finite_float(uint32_t bits)
+{
+    return (bits & 0x7f800000u) != 0x7f800000u;
+}
+
+static uint32_t float_order(uint32_t bits)
+{
+    if (!(bits & 0x7fffffffu))
+        bits = 0;
+    return bits ^ (bits >> 31 ? UINT32_MAX : 0x80000000u);
+}
+
+static uint32_t phase_index(uint32_t a, uint32_t b)
+{
+    unsigned ae = (a >> 23) & 255, be = (b >> 23) & 255;
+    uint32_t am = (a & 0x7fffffu) | (ae ? 0x800000u : 0);
+    uint32_t bm = (b & 0x7fffffu) | (be ? 0x800000u : 0);
+    uint64_t product = (uint64_t)am * bm;
+    if (!product)
+        return 0;
+    unsigned width = 64 - __builtin_clzll(product);
+    unsigned shift = width > 24 ? width - 24 : 0;
+    uint64_t mantissa = round_shift(product, shift);
+    int power = (int)(ae ? ae : 1) + (int)(be ? be : 1) - 300 + (int)shift;
+    unsigned sign = (a ^ b) >> 31;
+    uint64_t limit = 0x7fffffffull + sign;
+    if (power >= 0) {
+        if (power > 31 || mantissa > (limit >> power))
+            return 0x80000000u;
+        mantissa <<= power;
+    } else {
+        mantissa = round_shift(mantissa, (unsigned)-power);
+        if (mantissa > limit)
+            return 0x80000000u;
+    }
+    return sign ? 0u - (uint32_t)mantissa : (uint32_t)mantissa;
+}
+
+enum { CULL_NONE, CULL_COUNTED, CULL_UNSUPPORTED, MAX_CULL_PARTICLES = 1024 };
+
+static void cull_plan(const Capture *capture, uint32_t *data, uint64_t emitter, uint32_t gate)
+{
+    data[19] = CULL_UNSUPPORTED;
+    data[21] = gate;
+    if (!word(emitter + 0x140, &data[20]) || !finite_float(data[20]) || !finite_float(gate))
+        return;
+    if (float_order(data[20]) >= float_order(gate)) {
+        data[19] = CULL_NONE;
+        return;
+    }
+    if ((capture->mxcsr & 0xffc0u) != 0x1f80u || (capture->fcw & 0xc00u) ||
+        !data[7] || (data[10] & 0x20))
+        return;
+    uint32_t selected = data[3] / data[7];
+    if (selected > data[4])
+        selected = data[4];
+    uint32_t phases, order, scale;
+    if (selected > MAX_CULL_PARTICLES || !word(emitter + 0x34, &phases) ||
+        !word(emitter + 0x54, &order) || !word(emitter + 0x13c, &scale) || !finite_float(scale))
+        return;
+    uint32_t contributing = 0;
+    for (uint32_t i = 0; i < selected; i++) {
+        uint32_t index, phase, lookup;
+        if (!word((uint64_t)order + 4ull * i, &index))
+            return;
+        uint64_t particle = (uint64_t)phases + 32ull * index;
+        if (!word(particle, &phase) || !finite_float(phase))
+            return;
+        unsigned slot = ((uint32_t)(particle >> 5) + phase_index(phase, scale)) & 127;
+        if (!word(0xf4aae0ull + 4 * slot, &lookup) || !finite_float(lookup))
+            return;
+        contributing += float_order(lookup) <= float_order(data[20]);
+    }
+    data[18] = contributing;
+    data[19] = CULL_COUNTED;
+}
+
+static int map_plan(Capture *capture)
+{
+    const uint32_t frame = capture->boundary.frame;
+    uint32_t count, table, indices, starting_offset, stride, enabled, limit, gate;
+    if (!word(frame - 0xe0ull, &count) || !word(frame - 0xfcull, &starting_offset) ||
+        !word(frame - 0xf4ull, &stride) || !word(frame + 0x10ull, &table) ||
+        !word(frame + 0x14ull, &indices) || !word(PARTICLE_READY, &enabled) || !word(PARTICLE_LIMIT, &limit) || !word(0xd2f8b8, &gate))
+        return 0;
+    uint32_t *map = capture->boundary.word;
+    map[0] = capture->eax;
+    map[1] = count;
+    map[2] = stride;
+    capture->boundary.ready = 1;
+    if (count > MAX_GROUP)
+        return 1;
+    for (uint32_t i = 0; i < count; i++) {
+        Row *plan = &capture->plans[capture->records++];
+        *plan = capture->boundary;
+        plan->site = PLAN;
+        plan->ordinal = i;
+        plan->ready = 0;
+        uint32_t *data = plan->word;
+        *data = 0;
+        uint32_t index, item;
+        if (!word((uint64_t)indices + starting_offset + 4ull * i, &index) ||
+            !word((uint64_t)table + 68ull * index + 0x18, &item) || !item)
+            continue;
+        data[0] = item;
+        data[1] = stride;
+        data[2] = enabled;
+        data[3] = limit;
+        uint64_t object = item;
+        if (!word(object + 0x50, &data[4]) || !word(object + 0x98, &data[5]) ||
+            !word(object + 0x1c, &data[6]) || !word(object + 0x8c, &data[7]) ||
+            !word(object + 0x90, &data[8]) || !word(object + 0xd4, &data[9]) ||
+            !word(object + 0x134, &data[10]) || !word(object + 0x128, &data[11]) ||
+            !texture_words(data[11], data + 12))
+            continue;
+        cull_plan(capture, data, object, gate);
+        plan->ready = 1;
+    }
+    return 1;
+}
+
+static int quad_arguments(const Capture *capture, uint32_t *data)
+{
+    uint32_t emitter, layout, matrix;
+    uint64_t stack = capture->esp;
+    if (!word(stack, &emitter) || emitter != capture->esi ||
+        !word(stack + 4, &layout) || !word(stack + 8, &data[1]) ||
+        !word(stack + 12, &matrix))
+        return 0;
+    data[0] = emitter;
+    data[2] = layout;
+    data[3] = matrix;
+    data[4] = capture->esp;
+    for (unsigned i = 0; i < 9; i++)
+        if (!word((uint64_t)layout + 4 * i, &data[6 + i]))
+            return 0;
+    if (!data[11])
+        for (unsigned i = 0; i < 3; i++)
+            if (!word((uint64_t)data[7] + 4 * i, &data[15 + i]))
+                return 0;
+    return word((uint64_t)capture->boundary.frame - 0x10c, &data[5]) &&
+           word((uint64_t)emitter + 0x134, &data[18]) &&
+           word((uint64_t)emitter + 0x1c, &data[19]);
+}
+
+static int capture_words(void *opaque)
+{
+    Capture *capture = opaque;
+    Row *row = &capture->boundary;
+    const uint32_t frame = row->frame;
+    uint32_t *data = row->word;
+    switch (row->site) {
+    case MAP_RETURN:
+        return map_plan(capture);
+    case FILL:
+        data[0] = capture->edi;
+        data[1] = capture->esi;
+        return word(frame - 0xe4ull, &row->ordinal) && word(frame - 0xf4ull, &data[2]);
+    case ADVANCE:
+        data[0] = capture->edi;
+        data[1] = capture->esi;
+        data[2] = capture->edx;
+        if (!word(frame - 0xe4ull, &row->ordinal) || !row->ordinal)
+            return 0;
+        row->ordinal--;
+        return word(capture->edi + 0x1cull, &data[3]) &&
+               word(capture->edi + 0x8cull, &data[4]) &&
+               word(capture->edi + 0x90ull, &data[5]);
+    case TEXTURE_RETURN:
+        data[0] = capture->esi;
+        data[1] = capture->eax;
+        return 1;
+    case QUAD_CALL:
+    case QUAD_RETURN:
+        if (memory_header)
+            return quad_arguments(capture, data);
+        data[0] = capture->esi;
+        return row->site == QUAD_CALL ? word(capture->esp + 8ull, &data[1])
+                                      : word(frame - 0x1cull, &data[1]);
+    default:
+        return 1;
+    }
+}
+
+int m32_particle_plan_site(uint64_t pc)
+{
+    switch (pc) {
+    case MAP_RETURN: case FILL: case ADVANCE: case UNMAP:
+    case TEXTURE_RETURN: case QUAD_CALL: case QUAD_RETURN:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+int m32_particle_plan_instruction(const X86Insn *insn)
+{
+    if (!insn->mode32 || !m32_particle_plan_site(insn->rip))
+        return 0;
+    const char *path = getenv("OCERZ_M32_PARTICLE_PLAN_LOG");
+    return path && *path;
+}
+
+void m32_particle_plan_hook(OcerzCPU *cpu, const X86Insn *insn)
+{
+    if (insn->rip == QUAD_CALL || insn->rip == QUAD_RETURN) {
+        _Atomic uint64_t *memory = m32_particle_memory_ring();
+        if (memory)
+            atomic_store_explicit(&memory[2], insn->rip == QUAD_CALL ? (uintptr_t)cpu : 0,
+                                  memory_order_release);
+    }
+    pthread_once(&init_once, start_log);
+    if (!header || !atomic_load_explicit(&header->state.armed, memory_order_relaxed))
+        return;
+    Capture capture;
+    capture.boundary = (Row){
+        .cpu = (uintptr_t)cpu, .site = insn->rip, .frame = cpu->gpr[OCERZ_RBP],
+        .tick = clock_gettime_nsec_np(CLOCK_UPTIME_RAW),
+    };
+    capture.records = 0;
+    capture.eax = cpu->gpr[OCERZ_RAX];
+    capture.edx = cpu->gpr[OCERZ_RDX];
+    capture.esi = cpu->gpr[OCERZ_RSI];
+    capture.edi = cpu->gpr[OCERZ_RDI];
+    capture.esp = cpu->gpr[OCERZ_RSP];
+    capture.mxcsr = cpu->mxcsr;
+    capture.fcw = cpu->fcw;
+    int result = ocerz_mem_try_snapshot(capture_words, &capture);
+    capture.boundary.ready = result == 1;
+    if (result < 0)
+        atomic_fetch_add_explicit(&header->state.busy, 1, memory_order_relaxed);
+    append(capture.boundary);
+    for (uint32_t i = 0; i < capture.records; i++)
+        append(capture.plans[i]);
+}
