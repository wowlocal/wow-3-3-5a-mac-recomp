+static pthread_once_t particle_pcs_once = PTHREAD_ONCE_INIT;
+static const uint32_t *particle_pcs;
+static size_t particle_pc_count;
+
+static void load_particle_pcs(void)
+{
+    const char *path = getenv("OCERZ_M32_PARTICLE_MEMORY_PCS");
+    if (!path) return;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    off_t bytes = fd < 0 ? -1 : lseek(fd, 0, SEEK_END);
+    if (bytes <= 0 || bytes > 1024 * 1024 || bytes % sizeof(uint32_t))
+        abort();
+    void *mapping = mmap(NULL, (size_t)bytes, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (mapping == MAP_FAILED)
+        abort();
+    particle_pcs = mapping;
+    particle_pc_count = (size_t)bytes / sizeof(uint32_t);
+    for (size_t i = 1; i < particle_pc_count; i++)
+        if (particle_pcs[i - 1] >= particle_pcs[i])
+            abort();
+}
+
+static int particle_memory_site(uint64_t pc)
+{
+    pthread_once(&particle_pcs_once, load_particle_pcs);
+    size_t first = 0, end = particle_pc_count;
+    while (first < end) {
+        size_t middle = first + (end - first) / 2;
+        if (particle_pcs[middle] < pc)
+            first = middle + 1;
+        else
+            end = middle;
+    }
+    return first < particle_pc_count && particle_pcs[first] == pc;
+}
+
+static int particle_string_access(unsigned op)
+{
+    return op == OCERZ_OP_MOVS || op == OCERZ_OP_STOS || op == OCERZ_OP_LODS ||
+           op == OCERZ_OP_SCAS || op == OCERZ_OP_CMPS;
+}
+
+static int particle_memory_instruction(const X86Insn *insn)
+{
+    if (insn->op == OCERZ_OP_LEA) return 0;
+    if (insn->op == OCERZ_OP_CALL || insn->op == OCERZ_OP_JMP || particle_string_access(insn->op))
+        return 1;
+    for (unsigned i = 0; i < insn->nops; i++)
+        if (insn->ops[i].kind == OCERZ_OPK_MEM)
+            return 1;
+    return 0;
+}
+
+static unsigned particle_memory_effect(unsigned op, unsigned operand)
+{
+    if (operand != 0) return 1;
+    switch (op) {
+    case OCERZ_OP_MOV: case OCERZ_OP_MOVSS: case OCERZ_OP_MOVSDX:
+    case OCERZ_OP_MOVAPS: case OCERZ_OP_MOVUPS: case OCERZ_OP_MOVD:
+    case OCERZ_OP_MOVDQA: case OCERZ_OP_MOVDQU: case OCERZ_OP_MOVQX:
+    case OCERZ_OP_MOVLPS: case OCERZ_OP_MOVHPS: case OCERZ_OP_MOVNTI:
+    case OCERZ_OP_POP: case OCERZ_OP_SETCC: case OCERZ_OP_FST:
+    case OCERZ_OP_FSTP: case OCERZ_OP_FIST: case OCERZ_OP_FISTP:
+    case OCERZ_OP_FNSTCW: case OCERZ_OP_FNSTSW: case OCERZ_OP_STMXCSR:
+        return 2;
+    case OCERZ_OP_CMP: case OCERZ_OP_TEST: case OCERZ_OP_PUSH:
+    case OCERZ_OP_DIV: case OCERZ_OP_IDIV: case OCERZ_OP_MUL:
+    case OCERZ_OP_IMUL: case OCERZ_OP_JMP: case OCERZ_OP_CALL:
+    case OCERZ_OP_FLD: case OCERZ_OP_FILD: case OCERZ_OP_FADD:
+    case OCERZ_OP_FMUL: case OCERZ_OP_FSUB: case OCERZ_OP_FSUBR:
+    case OCERZ_OP_FDIV: case OCERZ_OP_FDIVR: case OCERZ_OP_FCOM:
+    case OCERZ_OP_FCOMP: case OCERZ_OP_FLDCW: case OCERZ_OP_LDMXCSR:
+        return 1;
+    case OCERZ_OP_ADD: case OCERZ_OP_ADC: case OCERZ_OP_SUB:
+    case OCERZ_OP_SBB: case OCERZ_OP_AND: case OCERZ_OP_OR:
+    case OCERZ_OP_XOR: case OCERZ_OP_INC: case OCERZ_OP_DEC:
+    case OCERZ_OP_NEG: case OCERZ_OP_NOT: case OCERZ_OP_SHL:
+    case OCERZ_OP_SHR: case OCERZ_OP_SAR: case OCERZ_OP_XCHG:
+    case OCERZ_OP_XADD: case OCERZ_OP_CMPXCHG:
+        return 3;
+    default:
+        return 4;
+    }
+}
+
+static void emit_particle_memory(A64Buf *b, const X86Insn *insn)
+{
+    if (g_pin_class != 3 || insn->op == OCERZ_OP_LEA) return;
+    const X86Operand *mem = NULL;
+    unsigned operand = 0;
+    for (; operand < insn->nops; operand++) {
+        if (insn->ops[operand].kind == OCERZ_OPK_MEM) {
+            mem = &insn->ops[operand];
+            break;
+        }
+    }
+    const int direct = insn->nops && insn->ops[0].kind == OCERZ_OPK_IMM;
+    const int escape = (insn->op == OCERZ_OP_CALL || insn->op == OCERZ_OP_JMP) &&
+                       (!direct || !particle_memory_site(insn->ops[0].imm));
+    const int string_access = particle_string_access(insn->op);
+    if (!mem && !escape && !string_access) return;
+    const int flat = mem && !string_access && !mem->riprel && insn->seg == OCERZ_SEG_NONE &&
+                     insn->addrsize == 4 && mem->size && mem->size <= 16;
+    void *mapping = m32_particle_memory_ring();
+    if (!mapping) return;
+    a64_mov_imm64(b, JT0, (uint64_t)(uintptr_t)mapping);
+    a64_ldr(b, 8, JT1, JT0, 8);
+    uint32_t *disabled = a64_label(b); a64_cbz(b, 1, JT1, 0);
+    a64_ldr(b, 8, JT1, JT0, 16);
+    a64_eor_reg(b, 1, JT1, JT1, 20, 0);
+    uint32_t *other_cpu = a64_label(b); a64_cbnz(b, 1, JT1, 0);
+    a64_movz(b, JT1, 1, 0);
+    a64_emit32(b, 0xf82a012bu); /* LDADD X10, X11, [X9] */
+    a64_ubfx(b, 0, JTT, JT2, 0, 25);
+    a64_add_reg(b, 1, JT0, JT0, JTT, 6);
+    a64_add_imm(b, 1, JT0, JT0, 64);
+    a64_emit32(b, 0xd53be04au); /* MRS X10, CNTVCT_EL0 */
+    a64_str(b, 8, JT1, JT0, 8);
+    a64_str(b, 8, 20, JT0, 16);
+    a64_mov_imm64(b, JT1, insn->rip);
+    a64_str(b, 4, JT1, JT0, 24);
+    if (flat) {
+        a64_mov_imm64(b, JTA, (uint32_t)mem->disp);
+        if (mem->base != OCERZ_REG_NONE) {
+            emit_gpr_rd(b, 0, JTU, mem->base);
+            a64_add_reg(b, 0, JTA, JTA, JTU, 0);
+        }
+        if (mem->index != OCERZ_REG_NONE) {
+            emit_gpr_rd(b, 0, JTU, mem->index);
+            a64_add_reg(b, 0, JTA, JTA, JTU, mem->scale & 3);
+        }
+        a64_str(b, 4, JTA, JT0, 28);
+        a64_movz(b, JT1, mem->size, 0);
+        a64_str(b, 4, JT1, JT0, 32);
+        a64_movz(b, JT1, particle_memory_effect(insn->op, operand), 0);
+        a64_str(b, 4, JT1, JT0, 36);
+    }
+    emit_gpr_rd(b, 0, JT1, OCERZ_RSP);
+    a64_str(b, 4, JT1, JT0, 40);
+    if (escape && direct)
+        a64_mov_imm64(b, JT1, insn->ops[0].imm);
+    else
+        a64_movz(b, JT1, 0, 0);
+    a64_str(b, 4, JT1, JT0, 44);
+    a64_movz(b, JT1, escape ? (flat ? 5 : 2) : (flat ? 1 : 3), 0);
+    a64_str(b, 4, JT1, JT0, 60);
+    a64_add_imm(b, 1, JT2, JT2, 1);
+    a64_stlr(b, 8, JT2, JT0);
+    a64_patch_cbz(other_cpu, a64_label(b));
+    a64_patch_cbz(disabled, a64_label(b));
+}
