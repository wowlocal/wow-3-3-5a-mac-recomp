+ARB_TEST(arb_mixed_parameter_array_selects_uniform_and_literal_elements) {
+    identity();
+    load(GL_VERTEX_PROGRAM_ARB,
+         "!!ARBvp1.0\n"
+         "ADDRESS a;\n"
+         "PARAM selector = program.env[0];\n"
+         "PARAM colors[22] = { {1,0,0,1}, program.env[7..26], {1,1,1,1} };\n"
+         "ARL a.x, selector.x;\n"
+         "MOV result.position, vertex.position;\n"
+         "MOV result.color, colors[a.x];\n"
+         "END\n");
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 7, 0, 1, 0, 1);
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 26, 0, 0, 1, 1);
+    glEnable(GL_VERTEX_PROGRAM_ARB);
+    clear();
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 0, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 1, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kGreen));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 20, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kBlue));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 21, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kWhite));
+    const auto nan = std::numeric_limits<GLfloat>::quiet_NaN();
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 7, nan, nan, nan, nan);
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 26, nan, nan, nan, nan);
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, -4, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 41, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kWhite));
+    glDisable(GL_VERTEX_PROGRAM_ARB);
+    CHECK_GL();
+}
