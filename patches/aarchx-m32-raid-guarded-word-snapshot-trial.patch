+struct SnapshotTest {
+    uint64_t address;
+    uint32_t copied;
+    int nested_result;
+};
+
+static int copy_snapshot_word(void *opaque)
+{
+    struct SnapshotTest *test = opaque;
+    if (!ocerz_addr_readable(test->address))
+        return 0;
+    test->copied = (uint32_t)ocerz_ld(test->address, 4);
+    return 1;
+}
+
+static int copy_word_with_nested_try(void *opaque)
+{
+    struct SnapshotTest *test = opaque;
+    test->nested_result = ocerz_mem_try_snapshot(copy_snapshot_word, test);
+    return copy_snapshot_word(test);
+}
+
+static void test_mapping_snapshot(void)
+{
+    uint64_t page = ocerz_map_anywhere(OCERZ_GUEST_PAGE_SIZE, PROT_READ | PROT_WRITE);
+    check("snapshot has a guest allocation", page != 0);
+    if (!page) return;
+    struct SnapshotTest test = {.address = page};
+    ocerz_st(page, 4, 0x85a9b7cdu);
+    check("snapshot callback returned its result", ocerz_mem_try_snapshot(copy_word_with_nested_try, &test) == 1);
+    check("snapshot read the original word", test.copied == 0x85a9b7cdu);
+    check("busy snapshot did not enter the nested callback", test.nested_result == -1);
+    check("snapshot released the mapping lock", ocerz_protect(page, OCERZ_GUEST_PAGE_SIZE, PROT_NONE) == OCERZ_OK);
+    check("snapshot honors revoked permissions", ocerz_mem_try_snapshot(copy_snapshot_word, &test) == 0);
+    check("snapshot released the lock after a rejected read", ocerz_unmap(page, OCERZ_GUEST_PAGE_SIZE) == OCERZ_OK);
+}
