+int ocerz_mem_try_snapshot(int (*capture)(void *), void *context)
+{
+    if (!capture || ocerz_jit_lock_held_self())
+        return -1;
+    ocerz_critical_depth++;
+    if (pthread_mutex_trylock(&map_lock) != 0) {
+        ocerz_critical_depth--;
+        return -1;
+    }
+    int result = capture(context);
+    map_lock_release();
+    return result;
+}
