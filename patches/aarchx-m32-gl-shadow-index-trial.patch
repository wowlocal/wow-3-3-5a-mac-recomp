+static void test_shadow_slots(const char *gl, uint32_t pf, uint32_t ctx)
+{
+    enum { ARRAY = 0x8892, DYNAMIC = 0x88E8, READ_WRITE = 0x88BA, SLOTS = 256, SIZE = 4096 };
+    const uint32_t names = DATA + 0x1000;
+    cross(gl, "_glGenBuffers", 2, (uint32_t[]){ SLOTS + 1, names });
+    int complete = 1;
+    for (int i = 0; i <= SLOTS; i++) {
+        uint32_t name = m32_rd(names + (uint32_t)i * 4);
+        cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, name });
+        call("_glBufferData", 4, (uint32_t[]){ ARRAY, SIZE, 0, DYNAMIC });
+        uint32_t mapped = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+        if (i == SLOTS) {
+            check("a full shadow table preserves the existing mappings", mapped == 0);
+        } else if (mapped) {
+            m32_wr(mapped, 0x13579b00u + (uint32_t)i);
+        } else {
+            complete = 0;
+        }
+    }
+    check("occupy all shadow slots at once", complete);
+    for (int i = 0; i < SLOTS; i++) {
+        cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, m32_rd(names + (uint32_t)i * 4) });
+        complete &= call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) == 1;
+    }
+    check("read each mapping through its buffer key after changing the binding", complete);
+
+    cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, m32_rd(names + SLOTS * 4) });
+    uint32_t mapped = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+    check("reuse a slot after all old mappings end", mapped != 0);
+    if (mapped) call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY });
+    const uint32_t first = m32_rd(names);
+    cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, first });
+    mapped = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+    check("an evicted buffer reads its own backing on remap", mapped && m32_rd(mapped) == 0x13579b00u);
+    if (mapped) call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY });
+
+    uint32_t other = call("_aglCreateContext", 2, (uint32_t[]){ pf, 0 });
+    check("create another share group", other != 0);
+    if (other) {
+        call("_aglSetCurrentContext", 1, (uint32_t[]){ other });
+        cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, first });
+        call("_glBufferData", 4, (uint32_t[]){ ARRAY, SIZE, 0, DYNAMIC });
+        mapped = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+        check("same buffer name can be mapped in another share group", mapped != 0);
+        if (mapped) m32_wr(mapped, 0x2468ace0);
+        call("_aglSetCurrentContext", 1, (uint32_t[]){ ctx });
+        cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, first });
+        uint32_t original = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+        check("same-numbered live mappings stay separate",
+              original && mapped && original != mapped && m32_rd(original) == 0x13579b00u &&
+              m32_rd(mapped) == 0x2468ace0u);
+        if (original) call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY });
+        call("_aglSetCurrentContext", 1, (uint32_t[]){ other });
+        if (mapped) call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY });
+        call("_glDeleteBuffers", 2, (uint32_t[]){ 1, names });
+        call("_aglSetCurrentContext", 1, (uint32_t[]){ ctx });
+        call("_aglDestroyContext", 1, (uint32_t[]){ other });
+    }
+    call("_glDeleteBuffers", 2, (uint32_t[]){ SLOTS + 1, names });
+}
