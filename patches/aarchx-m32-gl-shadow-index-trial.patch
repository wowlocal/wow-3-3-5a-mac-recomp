+static void shadow_index_remove(const Shadow *s)
+{
+    if (!g_shadow_index || !s->group || !s->buffer) return;
+    const uint16_t slot = (uint16_t)(s - g_shadows + 1);
+    uint16_t *link = &g_shadow_head[shadow_bucket(s->group, s->buffer)];
+    while (*link && *link != slot)
+        link = &g_shadow_next[*link - 1];
+    if (*link) {
+        *link = g_shadow_next[slot - 1];
+        g_shadow_next[slot - 1] = 0;
+    }
+}
+
+static void shadow_index_insert(const Shadow *s)
+{
+    if (!g_shadow_index || !s->group || !s->buffer) return;
+    const size_t slot = (size_t)(s - g_shadows);
+    const unsigned bucket = shadow_bucket(s->group, s->buffer);
+    g_shadow_next[slot] = g_shadow_head[bucket];
+    g_shadow_head[bucket] = (uint16_t)(slot + 1);
+}
+
+static Shadow *shadow_index_lookup(void *group, uint32_t buffer)
+{
+    Shadow *result = NULL;
+    for (uint16_t slot = g_shadow_head[shadow_bucket(group, buffer)]; slot; slot = g_shadow_next[slot - 1]) {
+        Shadow *s = &g_shadows[slot - 1];
+        if (is(s, group, buffer)) {
+            result = s;
+            break;
+        }
+    }
+    if (g_shadow_index_log) {
+        uint64_t count = result ? ++g_index_hits : ++g_index_misses;
+        if (count == 1 || (count & 262143) == 0)
+            fprintf(stderr, "ocerz: GL shadow index hits=%" PRIu64 " misses=%" PRIu64 "\n",
+                    g_index_hits, g_index_misses);
+    }
+    return result;
 }

