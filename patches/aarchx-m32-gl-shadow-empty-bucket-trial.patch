-        if (is(candidate, group, buffer))
+        if (!absent && is(candidate, group, buffer))
             s = candidate;
         /* A direct alias can use an unassigned slot without evicting a shadow. */
-        else if ((!spare || (!size && spare->group && !candidate->group)) && !candidate->host)
+        else if ((!spare || (!size && spare->group && !candidate->group)) && !candidate->host) {
             spare = candidate;
+            if (absent && (size || !spare->group)) break;
+        }
     }
     if (!s && spare) {
         uint32_t guest = 0, cap = 0;
@@ -442,7 +495,7 @@
         } else {
             m32_free(spare->guest);
         }
-        *spare = (Shadow){ .group = group, .buffer = buffer, .guest = guest, .cap = cap };
+        shadow_assign(spare, (Shadow){ .group = group, .buffer = buffer, .guest = guest, .cap = cap });
         s = spare;
     }
     if (s && s->cap < size) {
@@ -740,7 +793,7 @@
             if (s->alias)
                 release_alias(vm, s);
             m32_free(s->guest);
-            *s = (Shadow){ 0 };
+            shadow_assign(s, (Shadow){ 0 });
         }
     }
