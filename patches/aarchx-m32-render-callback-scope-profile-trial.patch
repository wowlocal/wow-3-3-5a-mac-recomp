diff --git a/src/m32_wmgl.m b/src/m32_wmgl.m
--- a/src/m32_wmgl.m
+++ b/src/m32_wmgl.m
@@ -864,6 +864,43 @@
     ++stage;
 }

+static __thread struct {
+    unsigned depth;
+    uint32_t guest_fn;
+    uint64_t swaps, start_swaps, start_ns, sequence;
+} callback_probe;
+
+int m32_wmgl_callback_probe_enabled(void)
+{
+    if (!m32_headless_trial || !pthread_main_np())
+        return 0;
+    const char *value = getenv("OCERZ_M32_HEADLESS_CALLBACK_SAMPLE");
+    return value && !strcmp(value, "1");
+}
+
+void m32_wmgl_callback_probe_begin(uint32_t guest_fn)
+{
+    if (callback_probe.depth++ != 0)
+        return;
+    callback_probe.guest_fn = guest_fn;
+    ++callback_probe.sequence;
+    callback_probe.start_swaps = callback_probe.swaps;
+    callback_probe.start_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+void m32_wmgl_callback_probe_end(void)
+{
+    if (--callback_probe.depth != 0)
+        return;
+    const uint64_t swaps = callback_probe.swaps - callback_probe.start_swaps;
+    if (swaps)
+        fprintf(stderr, "ocerz: trial callback scope=%llu guest=%#x swaps=%llu end_swap=%llu duration_ns=%llu\n",
+                (unsigned long long)callback_probe.sequence, callback_probe.guest_fn,
+                (unsigned long long)swaps,
+                (unsigned long long)callback_probe.swaps,
+                (unsigned long long)(clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - callback_probe.start_ns));
+}
+
 int m32_wmgl_swap(void *agl)
 {
     Sidecar *ctx = find(agl);
@@ -880,6 +917,14 @@
     int presented = driver.swap(ctx->surface);
     if (has_drawable)
         ++ctx->swaps;
+    if (has_drawable && m32_wmgl_callback_probe_enabled()) {
+        callback_probe.swaps++;
+        if ((callback_probe.swaps & 63) == 0)
+            fprintf(stderr, "ocerz: trial callback at_swap=%llu depth=%u scope=%llu guest=%#x within=%llu\n",
+                    (unsigned long long)callback_probe.swaps, callback_probe.depth,
+                    (unsigned long long)callback_probe.sequence, callback_probe.guest_fn,
+                    (unsigned long long)(callback_probe.swaps - callback_probe.start_swaps));
+    }
     if (ctx->layer && ctx->swaps == 1) {
         sync_window(ctx, YES);
         fprintf(stderr, "ocerz: trial WineMetalGL first window swap (presented=%d)\n", presented);
