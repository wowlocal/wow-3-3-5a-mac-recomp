+static void init_guest_runner(void)
+{
+    /* i386 cdecl: preserve EBX/ESI, align the outgoing stack and claim one
+     * input with LOCK XADD. Each iteration copies six words to the stack,
+     * calls the original update, and returns the number of completed calls. */
+    static const uint8_t code[] = {
+        0x55,0x89,0xe5,0x53,0x56,0x83,0xec,0x20,0x31,0xdb,0x8b,0x75,
+        0x08,0x8b,0x45,0x0c,0xeb,0x11,0x8b,0x75,0x08,0xb8,0x01,0x00,
+        0x00,0x00,0xf0,0x0f,0xc1,0x06,0x3b,0x46,0x04,0x73,0x37,0x6b,
+        0xc0,0x30,0x8d,0x74,0x06,0x08,0x8b,0x06,0x89,0x04,0x24,0x8b,
+        0x46,0x04,0x89,0x44,0x24,0x04,0x8b,0x46,0x08,0x89,0x44,0x24,
+        0x08,0x8b,0x46,0x0c,0x89,0x44,0x24,0x0c,0x8b,0x46,0x10,0x89,
+        0x44,0x24,0x10,0x8b,0x46,0x14,0x89,0x44,0x24,0x14,0xe8,0x00,
+        0x00,0x00,0x00,0x43,0xeb,0xb8,0x89,0xd8,0x83,0xc4,0x20,0x5e,
+        0x5b,0xc9,0xc3,
+    };
+    enum { RELATIVE_WORD = 0x53, CALL_NEXT = 0x57 };
+    uint32_t address = guest_page(PROT_READ | PROT_WRITE);
+    if (!address)
+        return;
+    uint8_t *memory = m32_h(address);
+    const uint32_t relative = (uint32_t)UPDATE_TARGET - (address + CALL_NEXT);
+    memcpy(memory, code, sizeof code);
+    memcpy(memory + RELATIVE_WORD, &relative, sizeof relative);
+    if (ocerz_protect(address, vm_page_size, PROT_READ | PROT_EXEC) != OCERZ_OK) {
+        ocerz_unmap(address, vm_page_size);
+        return;
+    }
+    guest_runner = address;
+}
+
+static uint32_t pack_guest_wave(const Wave *wave)
+{
+    pthread_once(&guest_runner_once, init_guest_runner);
+    if (!guest_runner)
+        return 0;
+    if (!guest_wave)
+        guest_wave = guest_page(PROT_READ | PROT_WRITE);
+    if (!guest_wave)
+        return 0;
+    GuestWave *guest = m32_h(guest_wave);
+    atomic_store_explicit(&guest->next, 0, memory_order_relaxed);
+    guest->count = wave->count;
+    for (unsigned i = 0; i < wave->count; i++) {
+        const Task *task = &wave->tasks[i];
+        GuestPacket *packet = &guest->packets[i];
+        uint32_t packet_g = guest_wave + offsetof(GuestWave, packets) + i * sizeof *packet;
+        memcpy(packet->words, task->words, sizeof packet->words);
+        memcpy(packet->scale, task->scale, sizeof packet->scale);
+        memcpy(packet->offset, task->offset, sizeof packet->offset);
+        packet->words[2] = packet_g + offsetof(GuestPacket, scale);
+        packet->words[3] = packet_g + offsetof(GuestPacket, offset);
+    }
+    return guest_wave;
+}
