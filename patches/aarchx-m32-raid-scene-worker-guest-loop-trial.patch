+static uint32_t guest_page(int protection)
+{
+    const uint64_t page = ocerz_map_anywhere_aligned(vm_page_size, protection, vm_page_size);
+    if (page && page <= UINT32_MAX - vm_page_size)
+        return (uint32_t)page;
+    if (page)
+        ocerz_unmap(page, vm_page_size);
+    return 0;
+}
