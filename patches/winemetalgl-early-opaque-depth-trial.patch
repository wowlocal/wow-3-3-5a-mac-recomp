+bool LinkedProgram::earlyDepthEligible() {
+    int8_t eligible = earlyDepthEligible_.load(std::memory_order_relaxed);
+    if (eligible < 0) {
+        const shader::StageOutput& stage = this->stage(shader::Stage::Fragment);
+        const std::string& msl = stage.msl;
+        eligible = stage.present && msl.find("discard_fragment(") != std::string::npos &&
+                   !link.geometry.active && !link.xfbVertexCapture &&
+                   stage.storageArgs.empty() && link.images.empty() && link.atomicBuffers.empty() &&
+                   msl.find("[[depth") == std::string::npos && msl.find("[[sample_mask") == std::string::npos &&
+                   msl.find("[[sample_id") == std::string::npos && msl.find("early_fragment_tests") == std::string::npos &&
+                   msl.find("fragment main0_out main0(") != std::string::npos;
+        earlyDepthEligible_.store(eligible, std::memory_order_relaxed);
+    }
+    return eligible != 0;
+}
+
+id<MTLFunction> LinkedProgram::fragmentEarlyDepth() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    static constexpr const char* key = "opaque-early-depth";
+    if (const auto cached = fragmentVariants_.find(key); cached != fragmentVariants_.end()) return cached->second;
+    const shader::StageOutput& fragment = stage(shader::Stage::Fragment);
+    std::string msl = fragment.msl;
+    const size_t entry = msl.find("fragment main0_out main0(");
+    id<MTLFunction> function = nil;
+    if (entry != std::string::npos) {
+        msl.insert(entry, "[[early_fragment_tests]] ");
+        function = compileFunction(msl, fragment.entryPoint, static_cast<int>(shader::Stage::Fragment));
+    }
+    const char* log = std::getenv("WINEMETALGL_EARLY_OPAQUE_DEPTH_LOG");
+    if (log && log[0] == '1' && !log[1])
+        std::fprintf(stderr, "winemetalgl: opaque early depth shader %llu %s\n",
+                     static_cast<unsigned long long>(uid), function ? "compiled" : "fallback");
+    return fragmentVariants_.emplace(key, function).first->second;
+}
