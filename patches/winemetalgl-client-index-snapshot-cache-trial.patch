+COMPAT_TEST(compat_client_index_cache_changed_bytes) {
+    clear();
+    pixelProjection();
+    const GLfloat positions[] = {0, 0, 32, 0, 32, 64, 0, 64, 32, 0, 64, 0, 64, 64, 32, 64};
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+    glVertexPointer(2, GL_FLOAT, 0, positions);
+    glEnableClientState(GL_VERTEX_ARRAY);
+    GLushort indices[] = {0, 1, 2, 0, 2, 3};
+    glColor3f(1, 0, 0);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, indices);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, indices);
+    for (auto& index : indices) index += 4;
+    glColor3f(0, 1, 0);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, indices);
+    CHECK(pixel(16, 32, kRed));
+    CHECK(pixel(48, 32, kGreen));
+
+    // After the earlier draw completes, the same slot can take the new list.
+    clear();
+    glColor3f(0, 0, 1);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, indices);
+    glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, indices);
+    CHECK(pixel(16, 32, kBlack));
+    CHECK(pixel(48, 32, kBlue));
     glDisableClientState(GL_VERTEX_ARRAY);
     CHECK_GL();
 }
