+bool clientIndexCacheEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_CLIENT_INDEX_CACHE");
+        return value && !std::strcmp(value, "1");
+    }();
+    return enabled;
+}
+
+enum class IndexCacheUse { Hit, Fill, Busy, Bypass };
+
+void recordClientIndexCache(IndexCacheUse use, size_t bytes) {
+    static const unsigned interval = [] {
+        const char* value = std::getenv("WINEMETALGL_CLIENT_INDEX_CACHE_LOG");
+        return value && *value ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : 0u;
+    }();
+    if (!interval) return;
+    static thread_local uint64_t counts[4] = {}, total = 0, hitBytes = 0;
+    ++counts[static_cast<unsigned>(use)];
+    if (use == IndexCacheUse::Hit) hitBytes += bytes;
+    if (++total % interval == 0)
+        std::fprintf(stderr, "wmgl client index cache hit=%llu fill=%llu busy=%llu bypass=%llu hit_bytes=%llu\n",
+                     (unsigned long long)counts[0], (unsigned long long)counts[1],
+                     (unsigned long long)counts[2], (unsigned long long)counts[3],
+                     (unsigned long long)hitBytes);
+}
