diff --git a/include/ocerz/m32_wmgl.h b/include/ocerz/m32_wmgl.h
new file mode 100644
index 0000000..dae0ebd
--- /dev/null
+++ b/include/ocerz/m32_wmgl.h
@@ -0,0 +1,23 @@
+#ifndef OCERZ_M32_WMGL_H
+#define OCERZ_M32_WMGL_H
+
+/* Trial-only WineMetalGL sidecar. The guest still owns an ordinary AGL
+ * context and Carbon window. OpenGL calls use the selected renderer. */
+#ifdef OCERZ_WMGL_TRIAL
+int m32_wmgl_enabled(void);
+int m32_wmgl_symbol(const char *name, void **address);
+int m32_wmgl_create(void *agl, void *share);
+void m32_wmgl_destroy(void *agl);
+int m32_wmgl_set_current(void *agl);
+int m32_wmgl_drawable(void *agl, void *window);
+int m32_wmgl_swap(void *agl);
+#else
+static inline int m32_wmgl_symbol(const char *name, void **address) { return 0; }
+static inline int m32_wmgl_create(void *agl, void *share) { return 1; }
+static inline void m32_wmgl_destroy(void *agl) {}
+static inline int m32_wmgl_set_current(void *agl) { return 1; }
+static inline int m32_wmgl_drawable(void *agl, void *window) { return 1; }
+static inline int m32_wmgl_swap(void *agl) { return 0; }
+#endif
+
+#endif
