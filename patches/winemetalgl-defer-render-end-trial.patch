+void Queue::commit(id<MTLCommandBuffer> buffer, uint64_t serial) {
+    markSubmitted(serial);
+    commitSubmitted(buffer, serial);
+}
+
+void Queue::commitAfterEncoding(id<MTLCommandBuffer> buffer, uint64_t serial,
+                                dispatch_queue_t worker, dispatch_block_t endEncoding) {
+    FILE* log = deferredRenderEndLog();
+    const uint64_t submit = log ? stats::nowNanos() : 0;
+    const auto queueId = reinterpret_cast<uintptr_t>(this);
+    // Prelude buffers are already committed. Reserve this buffer's position
+    // before the caller can submit newer work on the shared Metal queue.
+    [buffer enqueue];
+    markSubmitted(serial);
+    dispatch_async(worker, ^{
+        @autoreleasepool {
+            const uint64_t start = log ? stats::nowNanos() : 0;
+            endEncoding();
+            const uint64_t ended = log ? stats::nowNanos() : 0;
+            commitSubmitted(buffer, serial);
+            if (log)
+                std::fprintf(log, "%llu %llu %llu %llu %llu %llu\n",
+                             static_cast<unsigned long long>(queueId), static_cast<unsigned long long>(serial),
+                             static_cast<unsigned long long>(submit), static_cast<unsigned long long>(start),
+                             static_cast<unsigned long long>(ended), static_cast<unsigned long long>(stats::nowNanos()));
+        }
+    });
+}
