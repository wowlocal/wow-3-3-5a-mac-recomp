+static double reference_math(unsigned op, const uint32_t args[2])
+{
+    float x, y;
+    memcpy(&x, &args[0], sizeof x);
+    memcpy(&y, &args[1], sizeof y);
+    switch (op) {
+    case 0: return sinf(x);
+    case 1: return cosf(x);
+    case 2: return floorf(x);
+    default: return atan2f(x, y);
+    }
+}
+
+static uint64_t test_fpsr(double value)
+{
+    uint64_t result;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(result) : "w"(value) : "memory");
+    return result;
+}
+
+static void set_fp_state(uint64_t fpcr, uint64_t fpsr)
+{
+    __asm__ volatile("msr fpcr, %0; msr fpsr, %1" :: "r"(fpcr), "r"(fpsr) : "memory");
+}
+
+static void test_math_cache(void)
+{
+    static const char *const names[] = { "_sinf", "_cosf", "_floorf", "_atan2f" };
+    static const uint32_t inputs[][2] = {
+        { 0, 0x80000000 }, { 0x80000000, 0 }, { 0x3f800000, 0xbf800000 },
+        { 0xc0880000, 0x40e80000 }, { 0x40490fdb, 0xbeaaaaab }, { 0x4f000001, 0x3f800001 },
+        { 0x00800000, 0x7f7fffff }, { 1, 0x80000001 }, { 0x7f800000, 0xff800000 },
+        { 0x7fc00023, 0x7f800005 }, { 0xff800055, 0x3f800000 }, { 0x3f800000, 0x7fc00023 },
+    };
+    const uint64_t rounding_modes[] = { 0, 0x400000, 0x800000, 0xc00000 };
+    uint64_t saved_fpcr;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(saved_fpcr));
+    uint64_t saved_fpsr = test_fpsr(0);
+    int saved_errno = errno;
+
+    m32_math_trial_init();
+    for (unsigned op = 0; op < sizeof names / sizeof names[0]; ++op) {
+        for (size_t index = 0; index < sizeof inputs / sizeof inputs[0]; ++index) {
+            for (size_t mode = 0; mode < sizeof rounding_modes / sizeof rounding_modes[0]; ++mode) {
+                for (unsigned sticky = 0; sticky < 2; ++sticky) {
+                    const uint64_t initial_fpsr = sticky ? 0x11 : 0;
+                    const int initial_errno = sticky ? EINVAL : 0;
+                    set_fp_state(rounding_modes[mode], initial_fpsr);
+                    errno = initial_errno;
+                    double expected = reference_math(op, inputs[index]);
+                    uint64_t expected_fpsr = test_fpsr(expected);
+                    const int expected_errno = errno;
+                    for (unsigned repeat = 0; repeat < 2; ++repeat) {
+                        set_fp_state(rounding_modes[mode], initial_fpsr);
+                        errno = initial_errno;
+                        call(names[op], op == 3 ? 2 : 1, inputs[index]);
+                        double result = cpu()->fpr[cpu()->ftop];
+                        uint64_t fpsr = test_fpsr(result);
+                        int error = errno;
+                        check("math result bits, FPSR, and errno match the host operation",
+                              !memcmp(&result, &expected, sizeof result) &&
+                              fpsr == expected_fpsr && error == expected_errno);
+                    }
+                }
+            }
+        }
+    }
+    set_fp_state(saved_fpcr, saved_fpsr);
+    errno = saved_errno;
 }

