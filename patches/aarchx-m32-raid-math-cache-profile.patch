+enum MathCall { MATH_SINF, MATH_COSF, MATH_FLOORF, MATH_ATAN2F, MATH_COUNT };
+enum { MATH_CACHE_SLOTS = 256, MATH_PROFILE_SWAPS = 256 };
+static const char *const math_names[MATH_COUNT] = { "sinf", "cosf", "floorf", "atan2f" };
+
+typedef struct {
+    uint64_t input, fpsr_in, fpsr_out;
+    double result;
+    int errno_in, errno_out;
+    int valid;
+} MathCacheEntry;
+
+static _Thread_local MathCacheEntry math_cache[MATH_COUNT][MATH_CACHE_SLOTS];
+static _Thread_local MathCacheEntry math_last[MATH_COUNT];
+static _Thread_local int *math_errno;
+static _Thread_local struct {
+    uint64_t calls, eligible, repeat, hits, mismatches, samples, sampled_ns;
+} math_profile[MATH_COUNT];
+static _Thread_local uint64_t math_swaps;
+static unsigned math_cache_mask;
+int m32_math_profile_enabled;
+
+void m32_math_trial_init(void)
+{
+    const char *mask = getenv("OCERZ_M32_MATH_CACHE");
+    math_cache_mask = mask ? (unsigned)strtoul(mask, NULL, 10) & ((1u << MATH_COUNT) - 1u) : 0;
+    const char *profile = getenv("OCERZ_M32_MATH_PROFILE");
+    m32_math_profile_enabled = profile && strcmp(profile, "1") == 0;
+}
+
+static int ordinary_float(uint32_t bits)
+{
+    uint32_t magnitude = bits & 0x7fffffffu;
+    return magnitude == 0 || (magnitude >= 0x00800000u && magnitude < 0x7f800000u);
+}
+
+static int same_math_input(const MathCacheEntry *entry, uint64_t input, uint64_t fpsr, int error)
+{
+    return entry->valid && entry->input == input && entry->fpsr_in == fpsr && entry->errno_in == error;
+}
+
+static uint64_t math_fpsr_after(double result)
+{
+    uint64_t status;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(status) : "w"(result) : "memory");
+    return status;
+}
+
+static double calculate_math(enum MathCall call, uint64_t args)
+{
+    float x, y;
+    uint32_t lo = (uint32_t)args, hi = (uint32_t)(args >> 32);
+    memcpy(&x, &lo, sizeof x);
+    memcpy(&y, &hi, sizeof y);
+    switch (call) {
+    case MATH_SINF: return sinf(x);
+    case MATH_COSF: return cosf(x);
+    case MATH_FLOORF: return floorf(x);
+    case MATH_ATAN2F: return atan2f(x, y);
+    default: abort();
+    }
+}
+
+static double trial_math(enum MathCall call, uint64_t input)
+{
+    const int profiling = m32_math_profile_enabled;
+    if (profiling) ++math_profile[call].calls;
+    uint64_t fpcr;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+    /* Ordinary binary32 inputs in the default FP mode have no synchronous FP traps. */
+    if (fpcr || !ordinary_float((uint32_t)input) || !ordinary_float((uint32_t)(input >> 32)))
+        return calculate_math(call, input);
+    if (!math_errno) math_errno = &errno;
+    uint64_t fpsr;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(fpsr) :: "memory");
+    const int error = *math_errno;
+    uint64_t hash = (input ^ (input >> 32)) * UINT64_C(11400714819323198485);
+    MathCacheEntry *entry = &math_cache[call][hash >> 56];
+    int hit = same_math_input(entry, input, fpsr, error);
+    if (hit && !profiling) {
+        if (entry->fpsr_out != fpsr)
+            __asm__ volatile("msr fpsr, %0" :: "r"(entry->fpsr_out) : "memory");
+        if (entry->errno_out != error) *math_errno = entry->errno_out;
+        return entry->result;
+    }
+    int sample = profiling && (math_profile[call].calls & 127u) == 0;
+    uint64_t begin = sample ? clock_gettime_nsec_np(CLOCK_UPTIME_RAW) : 0;
+    double result = calculate_math(call, input);
+    uint64_t after_fpsr = math_fpsr_after(result);
+    int after_error = *math_errno;
+    if (profiling) {
+        ++math_profile[call].eligible;
+        math_profile[call].repeat += same_math_input(&math_last[call], input, fpsr, error);
+        math_profile[call].hits += hit;
+        if (hit && (entry->fpsr_out != after_fpsr || entry->errno_out != after_error ||
+                    memcmp(&entry->result, &result, sizeof result)))
+            ++math_profile[call].mismatches;
+        if (sample) {
+            ++math_profile[call].samples;
+            math_profile[call].sampled_ns += clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - begin;
+        }
+    }
+    *entry = (MathCacheEntry){input, fpsr, after_fpsr, result, error, after_error, 1};
+    if (profiling) math_last[call] = *entry;
+    return result;
+}
+
+void m32_math_profile_swap(void)
+{
+    if (++math_swaps % MATH_PROFILE_SWAPS)
+        return;
+    uint64_t thread = 0;
+    pthread_threadid_np(NULL, &thread);
+    fprintf(stderr, "MATH_PROFILE begin thread=%llu swaps=%llu uptime_ns=%llu\n",
+            (unsigned long long)thread, (unsigned long long)math_swaps,
+            (unsigned long long)clock_gettime_nsec_np(CLOCK_UPTIME_RAW));
+    for (unsigned call = 0; call < MATH_COUNT; ++call) {
+        fprintf(stderr, "MATH_PROFILE %s %llu %llu %llu %llu %llu %llu %llu\n", math_names[call],
+                (unsigned long long)math_profile[call].calls, (unsigned long long)math_profile[call].eligible,
+                (unsigned long long)math_profile[call].repeat, (unsigned long long)math_profile[call].hits,
+                (unsigned long long)math_profile[call].mismatches, (unsigned long long)math_profile[call].samples,
+                (unsigned long long)math_profile[call].sampled_ns);
+    }
+    memset(math_profile, 0, sizeof math_profile);
+    fprintf(stderr, "MATH_PROFILE end thread=%llu swaps=%llu\n",
+            (unsigned long long)thread, (unsigned long long)math_swaps);
+}
+
+#define TRIAL_F(name, fn, op) \
+static int sp_##name(struct OcerzVM *vm, OcerzCPU *cpu) \
