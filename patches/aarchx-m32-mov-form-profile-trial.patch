 #define JIT_MAX_EDGES 8

+// Path in bits 0..2, width in 3..4, addressing form in 5..7.
+static uint16_t mov_profile_form(const X86Insn *insn)
+{
+    if (insn->op != OCERZ_OP_MOV || insn->nops != 2)
+        return 0;
+    const X86Operand *dst = &insn->ops[0], *src = &insn->ops[1];
+    const X86Operand *memory = NULL;
+    unsigned path = 0;
+    if (dst->kind == OCERZ_OPK_REG) {
+        if (src->kind == OCERZ_OPK_REG) path = 1;
+        else if (src->kind == OCERZ_OPK_MEM) { path = 2; memory = src; }
+        else if (src->kind == OCERZ_OPK_IMM) path = 4;
+    } else if (dst->kind == OCERZ_OPK_MEM) {
+        memory = dst;
+        if (src->kind == OCERZ_OPK_REG) path = 3;
+        else if (src->kind == OCERZ_OPK_IMM) path = 5;
+    }
+    if (!path) return 0;
+
+    const unsigned size = dst->size;
+    unsigned width;
+    switch (size) {
+    case 1: width = 0; break;
+    case 2: width = 1; break;
+    case 4: width = 2; break;
+    case 8: width = 3; break;
+    default: return 0;
+    }
+
+    unsigned address = 0;
+    if (memory) {
+        if (insn->seg != OCERZ_SEG_NONE) address = 7;
+        else if (memory->index != OCERZ_REG_NONE) address = 5;
+        else if (memory->base == OCERZ_RSP) address = 1;
+        else if (memory->base == OCERZ_RBP) address = 2;
+        else if (memory->riprel || memory->base == OCERZ_REG_NONE) address = 6;
+        else address = memory->disp ? 4 : 3;
+    }
+    return (uint16_t)(path | width << 3 | address << 5);
+}
