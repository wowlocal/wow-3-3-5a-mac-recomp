+static void sync_window(Sidecar *ctx, BOOL reorder)
+{
+    if (!ctx->overlay || !ctx->carbon)
+        return;
+    NSApplication *app = [(id)objc_getClass("NSApplication") sharedApplication];
+    NSRect frame;
+    if (!app.active || app.hidden || windowHost.front() != ctx->carbon ||
+        !windowHost.visible(ctx->carbon) || windowHost.collapsed(ctx->carbon) ||
+        !window_frame(ctx->carbon, &frame)) {
+        [ctx->overlay orderOut:nil];
+        return;
+    }
+    NSRect previous = ctx->overlay.frame;
+    if (frame.origin.x != previous.origin.x || frame.origin.y != previous.origin.y ||
+        frame.size.width != previous.size.width || frame.size.height != previous.size.height)
+        [ctx->overlay setFrame:frame display:NO];
+    const int width = (int)frame.size.width, height = (int)frame.size.height;
+    if (width != ctx->width || height != ctx->height) {
+        driver.flush(ctx->surface, WMGL_FLUSH_UPDATED, width, height, 0);
+        ctx->width = width;
+        ctx->height = height;
+    }
+    if (reorder || !ctx->overlay.visible)
+        [ctx->overlay orderFront:nil];
+}
+
+static void order_overlay(void *opaque)
+{
+    sync_window(opaque, YES);
+}
+
+static void update_overlay_bounds(void *opaque)
+{
+    sync_window(opaque, NO);
+}
+
+static int32_t window_event(void *next, void *event, void *opaque)
+{
+    (void)next;
+    Sidecar *ctx = opaque;
+    const uint32_t kind = windowHost.event_kind(event);
+    if (kind == CarbonWindowClosed) {
+        // Carbon destroys this window's event target after the close notification.
+        ctx->window_handler = NULL;
+        ctx->carbon = NULL;
+        [ctx->overlay orderOut:nil];
+    } else if (kind == CarbonWindowHidden || kind == CarbonWindowCollapsed) {
+        [ctx->overlay orderOut:nil];
+    } else if (kind == CarbonWindowBoundsChanged) {
+        dispatch_async_f(dispatch_get_main_queue(), ctx, update_overlay_bounds);
+    } else {
+        // Complete Carbon's activation or show before ordering against it.
+        dispatch_async_f(dispatch_get_main_queue(), ctx, order_overlay);
+    }
+    return CarbonEventNotHandled;
+}
+
+static int watch_window(void *window, Sidecar *ctx, void **handler)
+{
+    static const CarbonEventType events[] = {
+        {CarbonWindowEvent, CarbonWindowActivated}, {CarbonWindowEvent, CarbonWindowDeactivated},
+        {CarbonWindowEvent, CarbonWindowShown},     {CarbonWindowEvent, CarbonWindowHidden},
+        {CarbonWindowEvent, CarbonWindowBoundsChanged},
+        {CarbonWindowEvent, CarbonWindowCollapsed}, {CarbonWindowEvent, CarbonWindowExpanded},
+        {CarbonWindowEvent, CarbonWindowClosed}
+    };
+    void *target = windowHost.target(window);
+    if (!target || windowHost.install(target, window_event, sizeof events / sizeof events[0], events, ctx, handler))
+        return 0;
+
+    static int observing_application;
+    if (!observing_application) {
+        observing_application = 1;
+        id center = [(id)objc_getClass("NSNotificationCenter") defaultCenter];
+        NSApplication *app = [(id)objc_getClass("NSApplication") sharedApplication];
+        const char *notifications[] = {
+            "NSApplicationDidBecomeActiveNotification", "NSApplicationDidResignActiveNotification",
+            "NSApplicationDidHideNotification", "NSApplicationDidUnhideNotification"
+        };
+        for (size_t i = 0; i < sizeof notifications / sizeof notifications[0]; i++) {
+            id name = [(id)objc_getClass("NSString") stringWithUTF8String:notifications[i]];
+            [center addObserverForName:name object:app queue:nil usingBlock:^(NSNotification *note) {
+                (void)note;
+                for (size_t j = 0; j < sizeof contexts / sizeof contexts[0]; j++)
+                    if (contexts[j].overlay)
+                        dispatch_async_f(dispatch_get_main_queue(), &contexts[j], order_overlay);
+            }];
+        }
+    }
+    return 1;
+}
