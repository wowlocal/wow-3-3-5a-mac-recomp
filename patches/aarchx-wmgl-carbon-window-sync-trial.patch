+static NSWindow *overlay_window(NSRect frame)
+{
+    NSWindow *overlay = [[(id)objc_getClass("NSWindow") alloc] initWithContentRect:frame
                         styleMask:NSWindowStyleMaskBorderless backing:NSBackingStoreBuffered defer:NO];
     overlay.releasedWhenClosed = NO;
     overlay.ignoresMouseEvents = YES;
+    overlay.hidesOnDeactivate = YES;
+    // Carbon and AppKit use different ordering groups within the normal layer.
+    overlay.level = NSNormalWindowLevel + 1;
+    overlay.excludedFromWindowsMenu = YES;
+    overlay.collectionBehavior = NSWindowCollectionBehaviorIgnoresCycle;
     overlay.hasShadow = NO;
     overlay.title = [(id)objc_getClass("NSString") stringWithUTF8String:"WoW Metal Trial Output"];
     return overlay;
 }

+static void remove_overlay(Sidecar *ctx)
+{
+    if (ctx->window_handler)
+        windowHost.remove(ctx->window_handler);
+    ctx->window_handler = NULL;
+    ctx->carbon = NULL;
+    [ctx->layer removeFromSuperlayer];
+    [ctx->layer release];
+    [ctx->overlay close];
+    [ctx->overlay release];
+    ctx->layer = nil;
+    ctx->overlay = nil;
+}
