+static int dep_m32_mov(const X86Insn *insn)
+{
+    const X86Operand *d = &insn->ops[0], *s = &insn->ops[1];
+    return insn->mode32 && insn->addrsize == 4 && insn->op == OCERZ_OP_MOV && insn->nops == 2 &&
+           insn->seg == OCERZ_SEG_NONE && !insn->rep && !insn->lock &&
+           dep_gpr(d) && d->size == 4 && !d->high8 && d->reg != OCERZ_RSP &&
+           pin_slot(d->reg) >= 0 && s->size == 4;
+}
+
+static void dep_m32_mark(const X86Insn *insns, int n)
+{
+    if (!ENV_ON("OCERZ_M32_DEP_PLAIN") || g_pin_class != 3 || !ocerz_guest_base ||
+        !mem_fast_forms_ok() || g_align_any || g_no_ldapr || align_test_all() ||
+        ocerz_tcache_mode() != OCERZ_TC_OFF)
+        return;
+    const int log = ENV_ON("OCERZ_M32_DEP_PLAIN_LOG");
+    for (int i = 0; i < n; i++) {
+        const X86Insn *first = &insns[i];
+        const X86Operand *source = &first->ops[1];
+        if (!dep_m32_mov(first) || source->kind != OCERZ_OPK_MEM || mem_plain_access_ok(source))
+            continue;
+
+        /* Preserve the emitted address dependency through whole-register
+         * copies. All other instructions with effects end the scan. */
+        unsigned carries = 1u << first->ops[0].reg;
+        for (int j = i + 1; j < n && j <= i + DEP_SCAN; j++) {
+            const X86Insn *next = &insns[j];
+            if (next->op == OCERZ_OP_NOP) continue;
+            if (!dep_m32_mov(next)) break;
+            const X86Operand *src = &next->ops[1];
+            if (src->kind == OCERZ_OPK_MEM) {
+                if (!mem_plain_access_ok(src) && dep_addr_from(src, carries)) {
+                    g_dep_plain[i] = 1;
+                    g_dep_by[i] = (int16_t)j;
+                    if (log)
+                        fprintf(stderr, "ocerz: i386 dependent load %#llx %#llx\n",
+                                (unsigned long long)first->rip, (unsigned long long)next->rip);
+                }
+                break;
+            }
+            if (!dep_gpr(src) || src->high8 || src->reg == OCERZ_RSP || pin_slot(src->reg) < 0)
+                break;
+            unsigned copied = (carries >> src->reg) & 1u;
+            unsigned dest = next->ops[0].reg;
+            carries = (carries & ~(1u << dest)) | (copied << dest);
+            if (!carries) break;
+        }
+    }
+}
