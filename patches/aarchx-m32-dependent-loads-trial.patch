+static int test_m32_dependencies(const char *requested)
+{
+    char *end;
+    unsigned long index = strtoul(requested, &end, 10);
+    if (!*requested || *end || index > 7) return 2;
+    switch (index) {
+    case 0:
+        CASE("adjacent dependent reads", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0x8b,0x03, 0x8b,0x10);
+        break;
+    case 1:
+        CASE("dependent read through a copy", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0x8b,0x03, 0x89,0xc6, 0x90, 0x8b,0x16);
+        break;
+    case 2:
+        CASE("independent load before the consumer", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0x8b,0x03, 0x8b,0x7b,0x08, 0x8b,0x10);
+        break;
+    case 3:
+        CASE("immediate overwrite removes the dependency", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0x8b,0x03, 0xb8,0x08,0x00,0x50,0x00, 0x8b,0x10);
+        break;
+    case 4:
+        CASE("dependent read wraps at 4 GiB", M32_CODE, M32_STACK,
+             0xc7,0x03,0xfc,0xff,0xff,0xff, 0x8b,0x03, 0x8b,0x90,0x04,0x00,0x50,0x00);
+        break;
+    case 5:
+        CASE("three dependent reads", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0xc7,0x43,0x04,0x08,0x00,0x50,0x00,
+             0x8b,0x03, 0x8b,0x38, 0x8b,0x17);
+        break;
+    case 6:
+        CASE("frame local stays outside the dependency rule", M32_CODE, M32_STACK,
+             0xc7,0x03,0x04,0x00,0x50,0x00, 0x8b,0x2b, 0x8b,0x55,0xfc);
+        break;
+    case 7:
+        CASE("dependency through a scaled index", M32_CODE, M32_STACK,
+             0xc7,0x03,0x01,0x00,0x00,0x00, 0x8b,0x0b, 0x8b,0x04,0x8b);
+        break;
+    }
+    return g_failures ? 1 : 0;
+}
