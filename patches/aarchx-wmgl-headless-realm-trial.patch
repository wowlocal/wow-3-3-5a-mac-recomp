+static void trial_realm_login(Sidecar *ctx)
+{
+    enum { READ, CLICK_ACCOUNT, TYPE_ACCOUNT, CLICK_PASSWORD, TYPE_PASSWORD, SUBMIT,
+           CHARACTER_READBACK, WAIT_FOR_ENTER, WORLD_READBACK, FINISHED };
+    static unsigned stage;
+    static uint64_t next;
+    static TrialField account, password;
+    if (stage == FINISHED || !ctx->carbon || ctx->swaps < 240)
+        return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (now < next) return;
+    next = now + 280000000ull;
+    switch (stage) {
+    case READ:
+        if (!trial_load_events() || !trial_read_login(&account, &password)) {
+            trial_wipe(&account, sizeof account);
+            trial_wipe(&password, sizeof password);
+            fprintf(stderr, "ocerz: could not read private trial login input from stdin\n");
+            stage = FINISHED;
+            return;
+        }
+        break;
+    case CLICK_ACCOUNT: trial_click(ctx, 0.522); break;
+    case TYPE_ACCOUNT:
+        trial_type(ctx->carbon, account, kVK_ANSI_A);
+        trial_wipe(&account, sizeof account);
+        break;
+    case CLICK_PASSWORD: {
+        TrialField empty = {0};
+        trial_type(ctx->carbon, empty, kVK_Tab);
+        break;
+    }
+    case TYPE_PASSWORD:
+        trial_type(ctx->carbon, password, kVK_ANSI_A);
+        trial_wipe(&password, sizeof password);
+        break;
+    case SUBMIT:
+        if (getenv("OCERZ_HEADLESS_FIELDS_ONLY")) {
+            const char *readback = getenv("OCERZ_HEADLESS_CHARACTER_READBACK");
+            if (readback && *readback) capture_frame(ctx, readback);
+            stage = FINISHED;
+            return;
+        }
+        TrialField submit = { .bytes = {'\r'}, .length = 1 };
+        trial_type(ctx->carbon, submit, kVK_Return);
+        fprintf(stderr, "ocerz: submitted the private trial realm login\n");
+        next = now + 3500000000ull;
+        break;
+    case CHARACTER_READBACK: {
+        const char *request = getenv("OCERZ_HEADLESS_CHARACTER_REQUEST");
+        if (!request || access(request, F_OK)) return;
+        const char *character = getenv("OCERZ_HEADLESS_CHARACTER_READBACK");
+        if (character && *character) capture_frame(ctx, character);
+        break;
+    }
+    case WAIT_FOR_ENTER: {
+        const char *request = getenv("OCERZ_HEADLESS_ENTER_REQUEST");
+        if (!request || access(request, F_OK)) return;
+        TrialField empty = {0};
+        trial_type(ctx->carbon, empty, kVK_Return);
+        fprintf(stderr, "ocerz: dispatched return to the trial character screen\n");
+        next = now + 4000000000ull;
+        break;
+    }
+    case WORLD_READBACK: {
+        const char *world = getenv("OCERZ_HEADLESS_WORLD_READBACK");
+        if (world && *world) capture_frame(ctx, world);
+        break;
+    }
+    default: return;
+    }
+    ++stage;
+}
