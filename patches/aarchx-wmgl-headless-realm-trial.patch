+static struct {
+    __typeof__(&CreateEvent) CreateEvent;
+    __typeof__(&GetCurrentEventTime) GetCurrentEventTime;
+    __typeof__(&SetEventParameter) SetEventParameter;
+    __typeof__(&PostEventToQueue) PostEventToQueue;
+    __typeof__(&GetMainEventQueue) GetMainEventQueue;
+    __typeof__(&ReleaseEvent) ReleaseEvent;
+    __typeof__(&SendEventToEventTarget) SendEventToEventTarget;
+    __typeof__(&GetApplicationEventTarget) GetApplicationEventTarget;
+} trialEvents;
+
+static int trial_load_events(void)
+{
+    void *carbon = dlopen("/System/Library/Frameworks/Carbon.framework/Frameworks/HIToolbox.framework/HIToolbox",
+                          RTLD_LAZY | RTLD_LOCAL);
+    if (!carbon) return 0;
+#define LOAD_EVENT(name) do { \
+    trialEvents.name = dlsym(carbon, #name); \
+    if (!trialEvents.name) return 0; \
+} while (0)
+    LOAD_EVENT(CreateEvent);
+    LOAD_EVENT(GetCurrentEventTime);
+    LOAD_EVENT(SetEventParameter);
+    LOAD_EVENT(PostEventToQueue);
+    LOAD_EVENT(GetMainEventQueue);
+    LOAD_EVENT(ReleaseEvent);
+    LOAD_EVENT(SendEventToEventTarget);
+    LOAD_EVENT(GetApplicationEventTarget);
+#undef LOAD_EVENT
+    return 1;
+}
+
+typedef struct {
+    unsigned char bytes[64];
+    size_t length;
+} TrialField;
+
+static void trial_wipe(void *buffer, size_t size)
+{
+    volatile unsigned char *bytes = buffer;
+    while (size--)
+        *bytes++ = 0;
+}
+
+static int trial_read_login(TrialField *account, TrialField *password)
+{
+    struct stat info;
+    char input[512];
+    if (fstat(STDIN_FILENO, &info) || !S_ISREG(info.st_mode) || info.st_uid != geteuid() ||
+        (info.st_mode & 077) || info.st_size <= 0 || info.st_size >= (off_t)sizeof(input))
+        return 0;
+    ssize_t length = pread(STDIN_FILENO, input, (size_t)info.st_size, 0);
+    if (length != info.st_size) {
+        trial_wipe(input, sizeof input);
+        return 0;
+    }
+    input[length] = 0;
+    char *position = NULL;
+    for (char *line = strtok_r(input, "\r\n", &position); line; line = strtok_r(NULL, "\r\n", &position)) {
+        char *value = strchr(line, ':');
+        if (!value) continue;
+        *value++ = 0;
+        TrialField *field = !strcasecmp(line, "username") ? account :
+                            !strcasecmp(line, "password") ? password : NULL;
+        if (!field) continue;
+        while (*value == ' ' || *value == '\t') ++value;
+        size_t n = strlen(value);
+        while (n && (value[n - 1] == ' ' || value[n - 1] == '\t')) --n;
+        if (!n || n > sizeof field->bytes) continue;
+        size_t i = 0;
+        for (; i < n; ++i)
+            if (!isascii((unsigned char)value[i]) || !isalnum((unsigned char)value[i])) break;
+        if (i != n) continue;
+        memcpy(field->bytes, value, n);
+        field->length = n;
+    }
+    trial_wipe(input, sizeof input);
+    return account->length && password->length;
+}
+
+static void trial_click(Sidecar *ctx, double vertical)
+{
+    CarbonRect bounds;
+    if (windowHost.bounds(ctx->carbon, CarbonContentRegion, &bounds)) return;
+    const HIPoint local = { (bounds.right - bounds.left) * 0.5, (bounds.bottom - bounds.top) * vertical };
+    const HIPoint global = { bounds.left + local.x, bounds.top + local.y };
+    const EventMouseButton button = kEventMouseButtonPrimary;
+    const UInt32 clicks = 1;
+    WindowRef window = ctx->carbon;
+    EventTargetRef target = windowHost.target(window);
+    if (!target) return;
+    const UInt32 kinds[] = { kEventMouseDown, kEventMouseUp };
+    for (size_t i = 0; i < sizeof kinds / sizeof kinds[0]; ++i) {
+        EventRef event = NULL;
+        if (trialEvents.CreateEvent(NULL, kEventClassMouse, kinds[i], trialEvents.GetCurrentEventTime(), kEventAttributeUserEvent, &event))
+            continue;
+        if (!trialEvents.SetEventParameter(event, kEventParamMouseLocation, typeHIPoint, sizeof global, &global) &&
+            !trialEvents.SetEventParameter(event, kEventParamWindowMouseLocation, typeHIPoint, sizeof local, &local) &&
+            !trialEvents.SetEventParameter(event, kEventParamMouseButton, typeMouseButton, sizeof button, &button) &&
+            !trialEvents.SetEventParameter(event, kEventParamClickCount, typeUInt32, sizeof clicks, &clicks) &&
+            !trialEvents.SetEventParameter(event, kEventParamWindowRef, typeWindowRef, sizeof window, &window) &&
+            !trialEvents.SetEventParameter(event, kEventParamPostTarget, typeEventTargetRef, sizeof target, &target))
+            trialEvents.PostEventToQueue(trialEvents.GetMainEventQueue(), event, kEventPriorityStandard);
+        trialEvents.ReleaseEvent(event);
+    }
+}
+
+static OSStatus trial_deliver(EventRef event, EventTargetRef target)
+{
+    const OSStatus status = trialEvents.SendEventToEventTarget(event, target);
+    return status == eventNotHandledErr ? trialEvents.SendEventToEventTarget(event, trialEvents.GetApplicationEventTarget()) : status;
+}
+
+static void trial_type(void *window, TrialField field, UInt32 virtual_key)
+{
+    const EventTargetRef target = windowHost.target(window);
+    if (!target) {
+        trial_wipe(&field, sizeof field);
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        TrialField copy = field;
+        UniChar text[sizeof copy.bytes] = {0};
+        for (size_t i = 0; i < copy.length; ++i) text[i] = copy.bytes[i];
+        const UInt32 modifiers = 0;
+        const UInt32 kinds[] = { kEventRawKeyDown, kEventRawKeyUp };
+        for (size_t i = 0; i < sizeof kinds / sizeof kinds[0]; ++i) {
+            EventRef key = NULL;
+            if (trialEvents.CreateEvent(NULL, kEventClassKeyboard, kinds[i], trialEvents.GetCurrentEventTime(), kEventAttributeUserEvent, &key))
+                continue;
+            OSStatus status = trialEvents.SetEventParameter(key, kEventParamKeyCode, typeUInt32, sizeof virtual_key, &virtual_key);
+            status |= trialEvents.SetEventParameter(key, kEventParamKeyModifiers, typeUInt32, sizeof modifiers, &modifiers);
+            if (copy.length)
+                status |= trialEvents.SetEventParameter(key, kEventParamKeyUnicodes, typeUnicodeText, sizeof text[0], text);
+            if (!status) {
+                trial_deliver(key, target);
+                if (i == 0 && copy.length) {
+                    EventRef typing = NULL;
+                    if (!trialEvents.CreateEvent(NULL, kEventClassTextInput, kEventTextInputUnicodeForKeyEvent,
+                                     trialEvents.GetCurrentEventTime(), kEventAttributeUserEvent, &typing)) {
+                        if (!trialEvents.SetEventParameter(typing, kEventParamTextInputSendKeyboardEvent, typeEventRef,
+                                               sizeof key, &key) &&
+                            !trialEvents.SetEventParameter(typing, kEventParamTextInputSendText, typeUnicodeText,
+                                               copy.length * sizeof text[0], text))
+                            trial_deliver(typing, target);
+                        trialEvents.ReleaseEvent(typing);
+                    }
+                }
+            }
+            trialEvents.ReleaseEvent(key);
+        }
+        trial_wipe(text, sizeof text);
+        trial_wipe(&copy, sizeof copy);
+    });
+    trial_wipe(&field, sizeof field);
+}
