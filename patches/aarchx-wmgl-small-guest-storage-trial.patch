+    static unsigned vertexAllocations, unpackAllocations, smallAllocations;
+    unsigned *allocations = small ? &smallAllocations : vertex ? &vertexAllocations : &unpackAllocations;
+    if (__atomic_add_fetch(allocations, 1, __ATOMIC_RELAXED) == 1) {
+        if (small)
+            fprintf(stderr, "ocerz: WineMetalGL allocated its first guest-backed one-page buffer (%zu bytes)\n", size);
+        else
+            fprintf(stderr, "ocerz: WineMetalGL allocated its first guest-backed %zu MiB buffer\n",
+                    size / (1024 * 1024));
+    }
     return m32_h((uint32_t)start);
 }

