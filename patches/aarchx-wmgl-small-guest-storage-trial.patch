--- a/src/m32_wmgl.m
+++ b/src/m32_wmgl.m
@@ -39,6 +39,7 @@
 static int format;
 static int guestBufferStorage;
 static int guestUnpackStorage;
+static size_t guestSmallStorageSize;

 typedef struct GuestBuffer {
     uint32_t start;
@@ -54,7 +55,8 @@
     // The two sizes have independent trial flags.
     const int vertex = size == 2 * 1024 * 1024 && guestBufferStorage;
     const int unpack = size == 8 * 1024 * 1024 && guestUnpackStorage;
-    if ((!vertex && !unpack) || !ocerz_guest_base)
+    const int small = guestSmallStorageSize && size == guestSmallStorageSize;
+    if ((!vertex && !unpack && !small) || !ocerz_guest_base)
         return NULL;
     uint64_t start = ocerz_map_anywhere_aligned(size, PROT_READ | PROT_WRITE, 65536);
     if (!start)
@@ -73,11 +75,15 @@
