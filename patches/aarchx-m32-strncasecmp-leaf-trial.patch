+/* A genuine i386 import stub called from translated cdecl guest code. */
+static void plant_string_compare(uint32_t entry, uint32_t slot, uint32_t iterations)
+{
+    const uint8_t code[] = {
+        0x55, 0x89, 0xe5, 0x53,             /* push ebp; mov ebp,esp; push ebx */
+        0xbb, 0, 0, 0, 0,                  /* mov ebx,iterations */
+        0xff, 0x75, 0x10,                   /* push [ebp+16]: count */
+        0xff, 0x75, 0x0c,                   /* push [ebp+12]: right */
+        0xff, 0x75, 0x08,                   /* push [ebp+8]: left */
+        0xe8, 9, 0, 0, 0,                  /* call the import stub */
+        0x83, 0xc4, 0x0c,                   /* add esp,12 */
+        0x4b, 0x75, 0xec,                   /* dec ebx; jne loop */
+        0x5b, 0x5d, 0xc3,                   /* pop ebx; pop ebp; ret */
+        0xff, 0x25, 0, 0, 0, 0             /* jmp [slot] */
+    };
+    memcpy(m32_h(entry), code, sizeof code);
+    m32_wr(entry + 5, iterations);
+    m32_wr(entry + 34, slot);
+}
+
+static void test_strncasecmp_leaf(void)
+{
+    static const struct { const char *left, *right; uint32_t limit; } cases[] = {
+        { "ArCaNe", "arcane", 10 },
+        { "ArcShadow", "aRCana", 3 },
+        { "apple", "Bomb", 5 },
+        { "zebra", "APPLE", 5 },
+        { "anything", "different", 0 },
+        { "arcane", "arcanes", 7 },
+    };
+    const uint32_t entry = CODE + 0x3800;
+    const uint32_t bench = CODE + 0x3900;
+    const uint32_t slot = DATA + 0x4440;
+    const uint32_t left = DATA + 0x4600;
+    const uint32_t right = DATA + 0x4700;
+    const uint32_t trap = m32_export("/usr/lib/libSystem.B.dylib", "_strncasecmp");
+    check("resolve real libc string comparison", trap != 0);
+    if (!trap)
+        return;
+    const char *enabled = getenv("OCERZ_M32_STRNCASECMP_LEAF");
+    const int wants_leaf = enabled && strcmp(enabled, "1") == 0;
+    const M32Leaf *leaf = m32_leaf_for(trap);
+    check("select the typed libc leaf only when requested", (leaf != NULL) == wants_leaf);
+    m32_wr(slot, trap);
+    enum { COUNT = 200000, SAMPLES = 7, WARMUP = 4 };
+    const int benchmark = getenv("OCERZ_BENCH_M32_STRNCASECMP") != NULL;
+    plant_string_compare(entry, slot, 1);
+    if (benchmark)
+        plant_string_compare(bench, slot, COUNT);
+    const int saved_jit = g_vm.jit_enabled, saved_active = m32_active;
+    const uint64_t saved_stack = cpu()->gpr[OCERZ_RSP];
+    cpu()->gpr[OCERZ_RSP] = STACK;
+    g_vm.jit_enabled = m32_active = 1;
+    for (size_t i = 0; i < sizeof cases / sizeof cases[0]; ++i) {
+        put_str(left, cases[i].left);
+        put_str(right, cases[i].right);
+        uint32_t args[] = { left, right, cases[i].limit };
+        const uint32_t want = (uint32_t)strncasecmp(cases[i].left, cases[i].right, cases[i].limit);
+        const uint32_t got = m32_call(&g_vm, entry, args, 3, NULL, NULL);
+        check("translated comparison preserves the native signed result and length bound", got == want);
+    }
+    check("compared through a translated i386 import", g_vm.jit != NULL);
+    if (benchmark) {
+        put_str(left, "Glowing-luminous-raid-spell");
+        put_str(right, "GLOWING-LUMINOUS-RAID-SPELL");
+        uint32_t args[] = {left, right, 31};
+        for (int i = 0; i < WARMUP + SAMPLES; ++i) {
+            const uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+            const uint32_t result = m32_call(&g_vm, bench, args, 3, NULL, NULL);
+            const uint64_t elapsed = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start;
+            check("repeated translated string comparisons return zero", result == 0);
+            if (i >= WARMUP)
+                printf("compare_ns %llu calls %u\n", (unsigned long long)elapsed, (unsigned)COUNT);
+        }
+    }
+    g_vm.jit_enabled = saved_jit;
+    m32_active = saved_active;
+    cpu()->gpr[OCERZ_RSP] = saved_stack;
 }

