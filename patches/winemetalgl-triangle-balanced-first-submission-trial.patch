+bool CommandStream::balanceTriangleSplit() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_TRIANGLE_SPLIT");
+        return value && value[0] == '1';
+    }();
+    return enabled;
+}
+
+static FILE* triangleSplitLog() {
+    static FILE* file = []() -> FILE* {
+        const char* path = std::getenv("WINEMETALGL_TRIANGLE_SPLIT_LOG");
+        return path && *path ? std::fopen(path, "w") : nullptr;
+    }();
+    return file;
+}
+
+bool CommandStream::traceTriangleSplit() {
+    return triangleSplitLog() != nullptr;
+}
