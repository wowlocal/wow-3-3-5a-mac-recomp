+/* The four bounds reductions each reconverge after a single optional store. */
+static uint64_t m32_quad_end(uint64_t start)
+{
+    switch (start) {
+    case 0x881709: return 0x881755;
+    case 0x8817f1: return 0x88183d;
+    case 0x8818ec: return 0x881934;
+    case 0x8819cf: return 0x881a17;
+    default: return 0;
+    }
+}
+
+static int m32_quad_store_join(const X86Insn *cmp, const X86Insn *branch, uint64_t end)
+{
+    if (cmp->op != OCERZ_OP_UCOMISS || cmp->rip + cmp->len != branch->rip ||
+        branch->op != OCERZ_OP_JCC || branch->cc != OCERZ_CC_BE ||
+        branch->ops[0].kind != OCERZ_OPK_IMM)
+        return 0;
+    uint64_t fall = branch->rip + branch->len;
+    uint64_t join = branch->ops[0].imm;
+    X86Insn store;
+    return join > fall && join <= end &&
+           jit_decode(fall, &store, 1) == OCERZ_OK && store.rip + store.len == join &&
+           store.op == OCERZ_OP_MOVSS && store.nops == 2 && store.seg == OCERZ_SEG_NONE &&
+           store.ops[0].kind == OCERZ_OPK_MEM && store.ops[0].size == 4 &&
+           store.ops[1].kind == OCERZ_OPK_XMM;
+}
