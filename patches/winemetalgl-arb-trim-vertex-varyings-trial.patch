+ARB_TEST(arb_vertex_varyings_follow_fragment_stage) {
+    identity();
+    load(GL_VERTEX_PROGRAM_ARB,
+         "!!ARBvp1.0\n"
+         "PARAM red = {1,0,0,1};\n"
+         "PARAM blue = {0,0,1,1};\n"
+         "MOV result.position, vertex.position;\n"
+         "MOV result.color, red;\n"
+         "MOV result.texcoord[3], blue;\n"
+         "END\n");
+    const GLuint color = load(GL_FRAGMENT_PROGRAM_ARB, "!!ARBfp1.0\nMOV result.color, fragment.color;\nEND\n");
+    const GLuint tex = load(GL_FRAGMENT_PROGRAM_ARB, "!!ARBfp1.0\nMOV result.color, fragment.texcoord[3];\nEND\n");
+    glEnable(GL_VERTEX_PROGRAM_ARB);
+    glEnable(GL_FRAGMENT_PROGRAM_ARB);
+    clear();
+    glBindProgramARB(GL_FRAGMENT_PROGRAM_ARB, color);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+    glBindProgramARB(GL_FRAGMENT_PROGRAM_ARB, tex);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kBlue));
+    glBindProgramARB(GL_FRAGMENT_PROGRAM_ARB, color);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+    glDisable(GL_FRAGMENT_PROGRAM_ARB);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+    glDisable(GL_VERTEX_PROGRAM_ARB);
+    CHECK_GL();
+}
