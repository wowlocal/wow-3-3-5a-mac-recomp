diff --git a/src/m32_bridge.c b/src/m32_bridge.c
--- a/src/m32_bridge.c
+++ b/src/m32_bridge.c
@@ -10,4 +10,5 @@
 #include <stdlib.h>
 #include <string.h>
+#include <time.h>

 #include <dlfcn.h>
@@ -465,4 +466,61 @@
 static int trap_dispatch(struct OcerzVM *vm, OcerzCPU *cpu);

+int m32_afp_trace_enabled;
+
+enum { AFP_CROSSING_REPORT_INTERVAL = 256, AFP_CROSSING_LEAF_SLOTS = 128 };
+static _Thread_local uint32_t afp_traps[M32_ID_LIMIT];
+static _Thread_local struct {
+    const char *name;
+    uint32_t count;
+} afp_leaves[AFP_CROSSING_LEAF_SLOTS];
+static _Thread_local uint64_t afp_swaps, afp_callbacks;
+static _Thread_local uint32_t afp_leaf_overflow, afp_other_traps;
+
+void m32_afp_trace_leaf(const char *name)
+{
+    for (unsigned i = 0; i < AFP_CROSSING_LEAF_SLOTS; ++i) {
+        if (!afp_leaves[i].name)
+            afp_leaves[i].name = name;
+        if (afp_leaves[i].name == name) {
+            ++afp_leaves[i].count;
+            return;
+        }
+    }
+    ++afp_leaf_overflow;
+}
+
+void m32_afp_trace_callback(void)
+{
+    ++afp_callbacks;
+}
+
+void m32_afp_trace_swap(void)
+{
+    if (++afp_swaps % AFP_CROSSING_REPORT_INTERVAL)
+        return;
+    uint64_t thread = 0;
+    pthread_threadid_np(NULL, &thread);
+    fprintf(stderr, "AFP_CROSS begin thread=%llu swaps=%llu uptime_ns=%llu callbacks=%llu leaf_overflow=%u other_traps=%u\n",
+            (unsigned long long)thread, (unsigned long long)afp_swaps,
+            (unsigned long long)clock_gettime_nsec_np(CLOCK_UPTIME_RAW), (unsigned long long)afp_callbacks,
+            afp_leaf_overflow, afp_other_traps);
+    for (uint32_t id = 0; id < M32_ID_LIMIT; ++id) {
+        if (!afp_traps[id]) continue;
+        M32Export *e = m32_export_by_id(id);
+        const char *name = e && e->name ? e->name : "<runtime>";
+        const char *kind = !e ? "runtime" : e->special ? "special" : "generic";
+        fprintf(stderr, "AFP_CROSS trap %s %s %u\n", kind, name, afp_traps[id]);
+        afp_traps[id] = 0;
+    }
+    for (unsigned i = 0; i < AFP_CROSSING_LEAF_SLOTS; ++i) {
+        if (!afp_leaves[i].count) continue;
+        fprintf(stderr, "AFP_CROSS leaf %s %u\n", afp_leaves[i].name, afp_leaves[i].count);
+        afp_leaves[i].count = 0;
+    }
+    afp_callbacks = afp_leaf_overflow = afp_other_traps = 0;
+    fprintf(stderr, "AFP_CROSS end thread=%llu swaps=%llu\n",
+            (unsigned long long)thread, (unsigned long long)afp_swaps);
+}
+
 /* every call the guest makes into the host: host code runs without FPCR.AH (src/cpu.c ocerz_afp_host) */
 int m32_trap(struct OcerzVM *vm, OcerzCPU *cpu)
@@ -472,4 +530,9 @@
         m32_signals_deliver(vm);   /* a signal's guest handler runs before the call */
     uint64_t fpcr = ocerz_afp_host();
+    if (m32_afp_trace_enabled && (fpcr & 2)) {
+        uint64_t id = cpu->rip - OCERZ_DYLDAPI_LO;
+        if (id < M32_ID_LIMIT) ++afp_traps[id];
+        else ++afp_other_traps;
+    }
     int r = trap_dispatch(vm, cpu);
     ocerz_afp_restore(fpcr);
