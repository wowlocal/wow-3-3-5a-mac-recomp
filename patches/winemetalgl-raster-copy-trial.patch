+id<MTLRenderPipelineState> mailboxCopyPipeline(MTLPixelFormat format) {
+    if (format != MTLPixelFormatRGBA8Unorm) return nil;
+    static id<MTLRenderPipelineState> pipeline = []() -> id<MTLRenderPipelineState> {
+        const char* value = std::getenv("OCERZ_WMGL_MAILBOX_RASTER_COPY");
+        if (!value || value[0] != '1' || value[1]) return nil;
+        id<MTLLibrary> library = Device::get().utilityLibrary();
+        MTLRenderPipelineDescriptor* desc = [MTLRenderPipelineDescriptor new];
+        desc.vertexFunction = [library newFunctionWithName:@"wmgl_fullscreen_vs"];
+        desc.fragmentFunction = [library newFunctionWithName:@"wmgl_mailbox_copy_fs"];
+        desc.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+        return [Device::get().mtl() newRenderPipelineStateWithDescriptor:desc error:nil];
+    }();
+    return pipeline;
+}
