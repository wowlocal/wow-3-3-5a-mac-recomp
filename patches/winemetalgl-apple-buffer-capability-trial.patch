diff --git a/src/core/api/buffer.mm b/src/core/api/buffer.mm
index 3b5d558..05b2e0d 100644
--- a/src/core/api/buffer.mm
+++ b/src/core/api/buffer.mm
@@ -1,6 +1,7 @@
 // Buffer objects (GL 3.3 section 2.9).
 
 #include <algorithm>
+#include <atomic>
 #include <cstdlib>
 #include <cstring>
 #include <mutex>
@@ -527,10 +528,20 @@ void BufferSubData(Context& ctx, GLenum target, GLintptr offset, GLsizeiptr size
         }
     }
     auto* destination = static_cast<uint8_t*>(buffer->mtl.contents) + offset;
-    if (applicationSynchronized)
+    if (applicationSynchronized) {
+        static const bool traceAppleSubData = [] {
+            const char* value = std::getenv("OCERZ_WMGL_TRACE_APPLE_SUBDATA");
+            return value && value[0] == '1' && !value[1];
+        }();
+        if (traceAppleSubData) {
+            static std::atomic_flag reported;
+            if (!reported.test_and_set(std::memory_order_relaxed))
+                WMGL_INFO(Buffer, "first direct upload to the application-synchronized 2 MiB vertex buffer");
+        }
         std::memmove(destination, data, static_cast<size_t>(size));
-    else
+    } else {
         std::memcpy(destination, data, static_cast<size_t>(size));
+    }
     buffer->shadowWrite(offset, size, data);
     ++buffer->version;
 }
