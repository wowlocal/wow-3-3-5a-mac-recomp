 bool Queue::isComplete(uint64_t serial) {
+    const bool fast = completedPrefixEnabled() && serial <= completedPrefix_.load(std::memory_order_acquire);
+    static const bool report = [] {
+        const char* value = std::getenv("WINEMETALGL_COMPLETED_SERIAL_LOG");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (report) {
+        static thread_local unsigned long long queries = 0, hits = 0;
+        hits += fast;
+        if ((++queries & 16383) == 0)
+            std::fprintf(stderr, "winemetalgl: completed prefix queries=%llu hits=%llu\n", queries, hits);
+    }
+    if (fast) return true;
     std::lock_guard<std::mutex> lock(mutex_);
     return !inflight_.count(serial) && !reserved_.count(serial);
