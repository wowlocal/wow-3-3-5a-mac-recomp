+namespace {
+bool completedPrefixEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_COMPLETED_SERIAL_FAST_PATH");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+bool deferredCommitEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_DEFER_METAL_COMMIT");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+FILE* commitTimingLog() {
+    static FILE* log = []() -> FILE* {
+        const char* path = std::getenv("OCERZ_WMGL_COMMIT_LOG");
+        if (!path || !*path) return nullptr;
+        FILE* file = std::fopen(path, "wx");
+        if (!file) std::perror("cannot create WineMetalGL commit timing log");
+        return file;
+    }();
+    return log;
+}
+}  // namespace
+
+// Only advance past serials with neither a reservation nor an in-flight
+// buffer. These sets can contain holes and can retire out of order.
+void Queue::publishCompletedPrefix() {
+    if (!completedPrefixEnabled()) return;
+    uint64_t firstPending = next_;
+    if (!reserved_.empty()) firstPending = std::min(firstPending, *reserved_.begin());
+    if (!inflight_.empty()) firstPending = std::min(firstPending, *inflight_.begin());
+    completedPrefix_.store(firstPending - 1, std::memory_order_release);
+}
+
 Queue::Queue() {
     queue_ = [Device::get().mtl() newCommandQueueWithMaxCommandBufferCount:256];
     queue_.label = @"WineMetalGL";
+    if (deferredCommitEnabled())
+        commitQueue_ = dispatch_queue_create("org.winemetalgl.commit",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INITIATED, 0));
 }

