+int ocerz_jit_m32_wrap_fault(const struct OcerzVM *vm, const void *host_pc,
+                            uint64_t host_base_register, uint64_t fault_address, uint64_t *out_rip)
+{
+    const uint32_t *pc = host_pc;
+    const JitBlock *b = fault_block(vm ? vm->jit : NULL, pc);
+    if (!b || !b->m32_wrap_stop || !b->insn_off) return 0;
+    int index = fault_insn_index(b, pc);
+    if (index < 0 || index >= b->m32_wrap_stop) return 0;
+
+    // The load-only prefix uses these immediate forms with JMEMBASE (x17).
+    uint32_t word = *pc;
+    if ((word >> 5 & 31u) != JMEMBASE) return 0;
+    int displacement;
+    if ((word & 0xffc00000u) == 0xb9400000u) {      /* LDR W, [X, #scaled] */
+        displacement = (int)((word >> 10 & 0xfffu) * 4u);
+    } else if ((word & 0xffe00c00u) == 0xb8400000u || /* LDUR W */
+               (word & 0xffe00c00u) == 0x99400000u) { /* LDAPUR W */
+        displacement = (int)(word >> 12 & 0x1ffu);
+        if (displacement & 256) displacement -= 512;
+    } else {
+        return 0;
+    }
+    if (displacement < -256 || displacement > 255) return 0;
+    uint64_t start = host_base_register + displacement;
+    if (!ocerz_m32_wrap_guard_address(start) || fault_address - start >= 4) return 0;
+    *out_rip = blk_insn_rip(b, index);
+    return 1;
+}
