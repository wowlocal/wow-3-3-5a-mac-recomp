+static int test_wrap_fault(const char *mode)
+{
+    uint32_t base;
+    int8_t first, second;
+    if (!strcmp(mode, "upper")) {
+        base = 0xfffffffcu;
+        first = 8;
+        second = 12;
+    } else if (!strcmp(mode, "lower")) {
+        base = 4;
+        first = -8;
+        second = -12;
+    } else if (!strcmp(mode, "inside")) {
+        base = M32_DATA + 0x40;
+        first = -4;
+        second = 8;
+    } else {
+        return 2;
+    }
+    if (ocerz_mem_init(0, M32_WINDOW) != OCERZ_OK ||
+        ocerz_map_fixed(0, 0x1000, PROT_READ | PROT_WRITE) != OCERZ_OK ||
+        ocerz_map_fixed(WRAP_PAGE, 0x1000, PROT_READ | PROT_WRITE) != OCERZ_OK ||
+        ocerz_map_fixed(M32_CODE, 0x200000, PROT_READ | PROT_WRITE | PROT_EXEC) != OCERZ_OK)
+        return 2;
+
+    ocerz_vm_init(&g_vm);
+    ocerz_vm_install_handlers(&g_vm);
+    m32_active = 1;
+    ocerz_ldt_install(CS32, 0, 0xfffff, 0xfb, 1, 0, 1);
+    load_start_state(M32_STACK);
+
+    uint8_t entry[] = { 0xbb, 0,0,0,0, 0xbe, 7,0,0,0, 0xe9, 0,0,0,0 };
+    int32_t jump = 0x1000 - (int32_t)sizeof entry;
+    memcpy(entry + 1, &base, 4);
+    memcpy(entry + 11, &jump, 4);
+    uint8_t body[] = {
+        0x46,                           /* inc esi */
+        0x8b, 0x43, (uint8_t)first,    /* mov eax,[ebx+first] */
+        0x8b, 0x53, (uint8_t)second,   /* mov edx,[ebx+second] */
+        0x31, 0xd0,                     /* xor eax,edx */
+        0x31, 0xf0,                     /* xor eax,esi */
+        0xc3,                           /* ret */
+    };
+    memcpy(ocerz_g2h(M32_CODE), entry, sizeof entry);
+    memcpy(ocerz_g2h(M32_CODE + 0x1000), body, sizeof body);
+    const uint32_t a = 0x13579bdf, b = 0x02468ace;
+    memcpy(ocerz_g2h((uint32_t)(base + first)), &a, 4);
+    memcpy(ocerz_g2h((uint32_t)(base + second)), &b, 4);
+
+    uint32_t result = m32_call(&g_vm, M32_CODE, NULL, 0, NULL, NULL);
+    if (result != (a ^ b ^ 8u)) {
+        fprintf(stderr, "FAIL %s: result %#x, expected %#x\n", mode, result, a ^ b ^ 8u);
+        return 1;
+    }
+    printf("  ok  guard-page load %s\n", mode);
+    return 0;
+}
