@@ -26,6 +29,86 @@
     void *(*proc)(const char *);
 } driver;
 static int format;
+static int guestBufferStorage;
+
+typedef struct GuestBuffer {
+    uint32_t start;
+    size_t size;
+    struct GuestBuffer *next;
+} GuestBuffer;
+static GuestBuffer *guestBuffers;
+static pthread_mutex_t guestBuffersLock = PTHREAD_MUTEX_INITIALIZER;
+
+static void *allocate_guest_buffer(size_t size)
+{
+    // The live raid trace identified a single 2 MiB rolling vertex buffer.
+    // Metal supplies ordinary allocations for the other sizes in this trial.
+    if (size != 2 * 1024 * 1024 || !ocerz_guest_base)
+        return NULL;
+    uint64_t start = ocerz_map_anywhere_aligned(size, PROT_READ | PROT_WRITE, 65536);
+    if (!start)
+        return NULL;
+    if (start >= M32_HANDLE_LO || size > M32_HANDLE_LO - start ||
+        ((ocerz_guest_base + start) & 65535) != 0) {
+        ocerz_unmap(start, size);
+        return NULL;
+    }
+    GuestBuffer *buffer = malloc(sizeof(*buffer));
+    if (!buffer) {
+        ocerz_unmap(start, size);
+        return NULL;
+    }
+    pthread_mutex_lock(&guestBuffersLock);
+    *buffer = (GuestBuffer){ .start = (uint32_t)start, .size = size, .next = guestBuffers };
+    guestBuffers = buffer;
+    pthread_mutex_unlock(&guestBuffersLock);
+    static unsigned allocations;
+    if (__atomic_add_fetch(&allocations, 1, __ATOMIC_RELAXED) == 1)
+        fprintf(stderr, "ocerz: WineMetalGL allocated its first guest-backed 2 MiB buffer\n");
+    return m32_h((uint32_t)start);
+}
+
+static void release_guest_buffer(void *host, size_t size)
+{
+    pthread_mutex_lock(&guestBuffersLock);
+    GuestBuffer **link = &guestBuffers;
+    while (*link && (host != m32_h((*link)->start) || size != (*link)->size))
+        link = &(*link)->next;
+    GuestBuffer *buffer = *link;
+    if (buffer)
+        *link = buffer->next;
+    pthread_mutex_unlock(&guestBuffersLock);
+
+    if (buffer) {
+        if (ocerz_unmap(buffer->start, buffer->size) != OCERZ_OK)
+            fprintf(stderr, "ocerz: could not release WineMetalGL guest buffer storage\n");
+        free(buffer);
+    }
+}
+
+int m32_wmgl_guest_storage_enabled(void) { return guestBufferStorage; }
+
+uint32_t m32_wmgl_guest_buffer(const void *host, size_t size)
+{
+    if (!guestBufferStorage || !host || !size)
+        return 0;
+    const uint64_t address = (uintptr_t)host;
+    if (address <= ocerz_guest_base || address - ocerz_guest_base >= M32_HANDLE_LO)
+        return 0;
+
+    const uint64_t guest = address - ocerz_guest_base;
+    uint32_t found = 0;
+    pthread_mutex_lock(&guestBuffersLock);
+    for (GuestBuffer *buffer = guestBuffers; buffer; buffer = buffer->next) {
+        if (guest >= buffer->start && size <= buffer->size &&
+            guest - buffer->start <= buffer->size - size) {
+            found = (uint32_t)guest;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&guestBuffersLock);
+    return found;
+}
 
