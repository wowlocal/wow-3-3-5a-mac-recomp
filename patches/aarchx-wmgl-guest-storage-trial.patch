+static void bench_wmgl_mapped_writes(const char *gl, unsigned target)
+{
+    enum { WARMUP = 2000, TIMED = 40000, STRIDE = 65536, RANGES = 32 };
+    cross(gl, "_glBufferParameteriAPPLE", 3, (uint32_t[]){ target, 0x8A13, 0 });
+    cross(gl, "_glBufferParameteriAPPLE", 3, (uint32_t[]){ target, 0x8A12, 0 });
+    check("configure explicit Apple range flushes", cross(gl, "_glGetError", 0, NULL) == 0);
+
+    uint64_t start = 0;
+    for (unsigned i = 0; i < WARMUP + TIMED; i++) {
+        if (i == WARMUP)
+            start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        uint32_t offset = (i % RANGES) * STRIDE;
+        uint32_t size = i % 20 == 0 ? 24064 : 320;
+        uint32_t guest = call("_glMapBuffer", 2, (uint32_t[]){ target, 0x88B9 /* GL_WRITE_ONLY */ });
+        if (!guest) {
+            check("map a range for the mapped-write measurement", 0);
+            return;
+        }
+        memset(m32_h(guest + offset), i & 255, size);
+        call("_glFlushMappedBufferRangeAPPLE", 3, (uint32_t[]){ target, offset, size });
+        if (call("_glUnmapBuffer", 1, (uint32_t[]){ target }) != 1) {
+            check("unmap during the mapped-write measurement", 0);
+            return;
+        }
+    }
+    const uint64_t elapsed = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start;
+    const unsigned last = WARMUP + TIMED - 1;
+    cross(gl, "_glGetBufferSubData", 4, (uint32_t[]){ target, (last % RANGES) * STRIDE, 4, DATA + 0xc64 });
+    check("read back the final measured upload", m32_rd(DATA + 0xc64) == 0x01010101u * (last & 255));
+    printf("wmgl-storage: %u mapped writes in %llu ns (%.1f ns per write)\n",
+           TIMED, (unsigned long long)elapsed, (double)elapsed / TIMED);
+}
+
+static void test_wmgl_storage(void)
+{
+    enum { ARRAY = 0x8892, DYNAMIC = 0x88E8, READ_WRITE = 0x88BA, SIZE = 2 * 1024 * 1024 };
+    const char *gl = "/System/Library/Frameworks/OpenGL.framework/Versions/A/OpenGL";
+    const char *option = getenv("OCERZ_WMGL_GUEST_STORAGE");
+    const int wantsDirect = option && !strcmp(option, "1");
+    if (!getenv("OCERZ_WMGL_LIBRARY")) {
+        check("WineMetalGL library was selected", 0);
+        return;
+    }
+    const uint32_t attrs[] = { 4 /* AGL_RGBA */, 5 /* AGL_DOUBLEBUFFER */, 0 };
+    memcpy(m32_h(DATA + 0xc00), attrs, sizeof attrs);
+    uint32_t pf = call("_aglChoosePixelFormat", 3, (uint32_t[]){ 0, 0, DATA + 0xc00 });
+    check("choose the offscreen trial's AGL pixel format", pf != 0);
+    uint32_t ctx = pf ? call("_aglCreateContext", 2, (uint32_t[]){ pf, 0 }) : 0;
+    check("create an AGL context and Metal pbuffer", ctx != 0);
+    if (!ctx) return;
+    check("make the offscreen WineMetalGL context current",
+          call("_aglSetCurrentContext", 1, (uint32_t[]){ ctx }) == 1);
+
+    cross(gl, "_glGenBuffers", 2, (uint32_t[]){ 2, DATA + 0xc30 });
+    uint32_t large = m32_rd(DATA + 0xc30);
+    uint32_t small = m32_rd(DATA + 0xc34);
+    check("create both driver buffers", large && small && large != small);
+    cross(gl, "_glBindBuffer", 2, (uint32_t[]){ ARRAY, large });
+    call("_glBufferData", 4, (uint32_t[]){ ARRAY, SIZE, 0, DYNAMIC });
+    uint32_t guest = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+    check("map the rolling buffer in the guest address space", guest && guest < M32_HANDLE_LO);
+    if (!guest) return;
+    check("the rolling buffer follows the selected storage mode",
+          (m32_wmgl_guest_buffer(m32_h(guest), SIZE) == guest) == wantsDirect);
+    check("storage lookup rejects a range that exceeds its backing",
+          !m32_wmgl_guest_buffer(m32_h(guest), SIZE + 1));
+    call("_glGetBufferPointerv", 3, (uint32_t[]){ ARRAY, 0x88BD, DATA + 0xc40 });
+    check("the driver's mapped pointer round-trips", m32_rd(DATA + 0xc40) == guest);
+    const float triangle[] = { -1, -1, 1, -1, 0, 1 };
+    memcpy(m32_h(guest), triangle, sizeof triangle);
+    m32_wr(guest + 124, 0x10203040);
+    check("unmap the whole rolling buffer", call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) == 1);
+    call("_glGetBufferPointerv", 3, (uint32_t[]){ ARRAY, 0x88BD, DATA + 0xc40 });
