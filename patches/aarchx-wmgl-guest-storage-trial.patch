+    check("unmap the written subrange", call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) == 1);
+    cross(gl, "_glGetBufferSubData", 4, (uint32_t[]){ ARRAY, 124, 8, DATA + 0xc48 });
+    check("subrange upload preserves neighboring bytes",
+          m32_rd(DATA + 0xc48) == 0x10203040 && m32_rd(DATA + 0xc4c) == 0x50607080);
+
+    cross(gl, "_glViewport", 4, (uint32_t[]){ 0, 0, 1, 1 });
+    cross(gl, "_glClear", 1, (uint32_t[]){ 0x4000 /* GL_COLOR_BUFFER_BIT */ });
+    cross(gl, "_glEnableClientState", 1, (uint32_t[]){ 0x8074 /* GL_VERTEX_ARRAY */ });
+    cross(gl, "_glVertexPointer", 4, (uint32_t[]){ 2, 0x1406 /* GL_FLOAT */, 0, 0 });
+    cross(gl, "_glColor4ub", 4, (uint32_t[]){ 17, 201, 43, 255 });
+    cross(gl, "_glDrawArrays", 3, (uint32_t[]){ 4 /* GL_TRIANGLES */, 0, 3 });
