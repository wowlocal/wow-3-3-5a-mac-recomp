+static void test_x86_cpu_features(void)
+{
+    const char *library = "/usr/lib/libSystem.B.dylib";
+    const uint32_t name = DATA + 0x4800, value = DATA + 0x4900, length = DATA + 0x4904;
+    uint32_t args[] = { name, value, length, 0, 0 };
+    put_str(name, "hw.optional.sse2");
+    m32_wr(value, 0xa5a5a5a5);
+    m32_wr(length, 4);
+    const char *cpu_features = getenv("OCERZ_M32_X86_CPU_FEATURES");
+    if (!cpu_features || strcmp(cpu_features, "1")) {
+        int host = 0;
+        size_t size = sizeof(host);
+        int rc = sysctlbyname("hw.optional.sse2", &host, &size, NULL, 0);
+        check("the ordinary path keeps native feature discovery",
+              cross(library, "_sysctlbyname", 5, args) == (uint32_t)rc);
+        return;
+    }
+    check("i386 reads SSE2 from the emulated CPU",
+          cross(library, "_sysctlbyname", 5, args) == 0 && m32_rd(value) == 1 && m32_rd(length) == 4);
+    put_str(name, "hw.optional.avx2_0");
+    check("unsupported x86 capabilities keep their emulated value",
+          cross(library, "_sysctlbyname", 5, args) == 0 && m32_rd(value) == 0);
+    put_str(name, "hw.optional.sse");
+    m32_wr(length, 1);
+    m32_wr(value, 0xa5a5a5a5);
+    check("short buffers fail without overwriting the result buffer",
+          cross(library, "_sysctlbyname", 5, args) == UINT32_MAX &&
+          m32_rd(value) == 0xa5a5a5a5 && m32_rd(length) == 0);
+    args[1] = 0;
+    check("a size-only probe returns the 32-bit feature width",
+          cross(library, "_sysctlbyname", 5, args) == 0 && m32_rd(length) == 4);
+    put_str(name, "hw.physicalcpu");
+    args[1] = value;
+    int host = 0;
+    size_t size = sizeof(host);
+    check("get the native physical CPU count", sysctlbyname("hw.physicalcpu", &host, &size, NULL, 0) == 0);
+    check("non-feature lookups delegate to native sysctlbyname",
+          cross(library, "_sysctlbyname", 5, args) == 0 && m32_rd(value) == (uint32_t)host);
+}
