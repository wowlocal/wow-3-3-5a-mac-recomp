+static int m32_x86_cpu_sysctlbyname(const char *name, void *old, size_t *oldlen, void *new_value, size_t newlen)
+{
+    const char *string;
+    uint64_t value;
+    unsigned width;
+    if (!name || strncmp(name, "hw.optional.", 12) || !oldlen || new_value || newlen ||
+        !ocerz_sysctl_x86_value(name, &string, &value, &width) || string || width != sizeof(uint32_t))
+        return sysctlbyname(name, old, oldlen, new_value, newlen);
+    if (old && *oldlen < width) {
+        *oldlen = 0;
+        errno = ENOMEM;
+        return -1;
+    }
+    if (old) {
+        const uint32_t feature = (uint32_t)value;
+        memcpy(old, &feature, sizeof(feature));
+    }
+    *oldlen = width;
+    return 0;
+}

