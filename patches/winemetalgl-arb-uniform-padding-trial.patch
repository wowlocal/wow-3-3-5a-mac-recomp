+ARB_TEST(arb_mixed_local_padding_keeps_guest_parameters_separate) {
+    identity();
+    load(GL_VERTEX_PROGRAM_ARB,
+         "!!ARBvp1.0\n"
+         "ADDRESS a;\n"
+         "PARAM selector = program.env[0];\n"
+         "PARAM colors[17] = { program.local[0..15], {0,1,0,1} };\n"
+         "ARL a.x, selector.x;\n"
+         "MOV result.position, vertex.position;\n"
+         "MOV result.color, colors[a.x];\n"
+         "END\n");
+    glProgramLocalParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 0, 0, 1, 1);
+    glProgramLocalParameter4fARB(GL_VERTEX_PROGRAM_ARB, 15, 1, 1, 1, 1);
+    glProgramLocalParameter4fARB(GL_VERTEX_PROGRAM_ARB, 16, 1, 0, 0, 1);
+    glEnable(GL_VERTEX_PROGRAM_ARB);
+    clear();
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, -1, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kBlue));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 15, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kWhite));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 17, 0, 0, 0);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kGreen));
+    GLfloat guestLocal[4] = {};
+    glGetProgramLocalParameterfvARB(GL_VERTEX_PROGRAM_ARB, 16, guestLocal);
+    CHECK_EQ(guestLocal[0], 1.0f);
+    CHECK_EQ(guestLocal[1], 0.0f);
+    glDisable(GL_VERTEX_PROGRAM_ARB);
+    CHECK_GL();
+}
