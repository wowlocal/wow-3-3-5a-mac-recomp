+           array.segmentLength >= 16 && array.elements.size() - array.segmentLength <= 32;
+}
+
+bool finiteLiteral(const std::string& expression, std::array<float, 4>& values) {
+    if (expression.compare(0, 5, "vec4(") != 0) return false;
+    const char* next = expression.c_str() + 5;
+    for (size_t i = 0; i < values.size(); ++i) {
+        char* end;
+        const float value = std::strtof(next, &end);
+        const bool last = i + 1 == values.size();
+        if (end == next || !std::isfinite(value) || *end != (last ? ')' : ',')) return false;
+        values[i] = value;
+        next = end + 1;
+    }
+    return *next == '\0';
+}
