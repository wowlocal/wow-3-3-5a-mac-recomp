+TransientAllocator::Chunk& TransientAllocator::reservedChunk(size_t index, id<MTLBuffer> buffer) {
+    if (index < chunks_.size() && chunks_[index].buffer == buffer) return chunks_[index];
+    // Retiring an unrelated oversized chunk can shift later indices.
+    for (Chunk& chunk : chunks_)
+        if (chunk.buffer == buffer) return chunk;
+    std::abort();
+}
+
+TransientAllocator::Reservation::Reservation(TransientAllocator& owner, size_t size, size_t alignment)
+    : owner_(owner), allocation_(owner.allocate(size, 0, alignment)) {
+    if (allocation_.buffer) {
+        chunk_ = owner_.current_;
+        ++owner_.chunks_[chunk_].reservations;
+    }
+}
+
+TransientAllocator::Reservation::~Reservation() {
+    if (allocation_.buffer) --owner_.reservedChunk(chunk_, allocation_.buffer).reservations;
+}
+
+void TransientAllocator::Reservation::usedBy(uint64_t serial) {
+    auto& chunk = owner_.reservedChunk(chunk_, allocation_.buffer);
+    chunk.lastSerial = std::max(chunk.lastSerial, serial);
+}
