+    static uint32_t host_state;
+    host_state = 0;
+    uint32_t host_handle = m32_handle(&host_state);
+    uint32_t reference = 0, guest_state = DATA + 0x2250;
+    m32_wr(guest_state, 0);
+    m32_wr(guest_state + 4, 0x1ee7cafe);
+    const uint16_t codes[] = { 1, 13 | 0x0200, 14 | 0x0800, 1, 53 };
+    for (size_t i = 0; i < sizeof codes / sizeof codes[0]; i++) {
+        uint16_t code = codes[i];
