+        if (i)
+            parameter(ARRAY, FLUSHING_UNMAP_APPLE, 0);
+        uint32_t guest = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, READ_WRITE });
+        check("a mapping contains its own buffer data", guest &&
+              !memcmp(m32_h(guest), initial, sizeof initial));
+        if (!guest)
+            continue;
+        call("_glGetBufferPointerv", 3, (uint32_t[]){ ARRAY, 0x88BD, DATA + 0xc60 });
+        check("the ordinary shadow pointer round-trips through the GL query", m32_rd(DATA + 0xc60) == guest);
+        m32_wr(guest, 90u + (uint32_t)i);
+        if (i)
+            call("_glFlushMappedBufferRangeAPPLE", 3, (uint32_t[]){ ARRAY, 0, sizeof(uint32_t) });
+        check("the buffer unmaps through the guest bridge",
+              (call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) & 0xff) == 1);
+        read(ARRAY, 0, sizeof result, result);
+        initial[0] = 90u + (uint32_t)i;
+        check("host readback preserves writes and untouched data", !memcmp(result, initial, sizeof result));
+    }
+    memcpy(m32_h(DATA + 0xc50), names, sizeof names);
+    call("_glDeleteBuffers", 2, (uint32_t[]){ 2, DATA + 0xc50 });
+}
