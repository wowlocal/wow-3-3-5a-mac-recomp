+    long (*variable)(short) = carbon ? dlsym(carbon, "GetScriptManagerVariable") : NULL;
+    uint32_t (*translate)(const void *, uint16_t, uint32_t *) =
+        carbon ? dlsym(carbon, "KeyTranslate") : NULL;
+    long native = variable && translate ? variable(38) : 0;
+    if (native <= 0)
+        return;
+
+    const void *layout = (const void *)(uintptr_t)native;
+    setenv("OCERZ_M32_LEGACY_KEY_LAYOUT", "1", 1);
+    uint32_t guest = call("_GetScriptManagerVariable", 1, (uint32_t[]){ 38 });
+    unsetenv("OCERZ_M32_LEGACY_KEY_LAYOUT");
+    check("the KCHR handle preserves the full native pointer", guest && m32_host(guest) == layout);
+    if (!guest)
+        return;
