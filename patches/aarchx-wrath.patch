+/* Opt-in entry and return timestamps for on-screen AGL buffer swaps. */
+static FILE *g_frame_times;
+static os_log_t g_frame_trace;
+static pthread_once_t g_frame_times_once = PTHREAD_ONCE_INIT;
+
+static void open_frame_times(void)
+{
+    const char *path = getenv("OCERZ_M32_FRAME_TIMES");
+    if (!path || !*path)
+        return;
+    g_frame_times = fopen(path, "w");
+    if (!g_frame_times) {
+        perror("ocerz: cannot open frame timing log");
+        return;
+    }
+    setvbuf(g_frame_times, NULL, _IOLBF, 0);
+    const char *trace = getenv("OCERZ_M32_TRACE_SWAPS");
+    if (trace && strcmp(trace, "1") == 0)
+        g_frame_trace = os_log_create("org.local.wrath-trial", OS_LOG_CATEGORY_POINTS_OF_INTEREST);
+}
+
+static int agl_SwapBuffers(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    (void)vm;
+    if (ready() && A(0)) {
+        static int dump = -1;
+        if (dump < 0) {
+            const char *log = getenv("OCERZ_M32LOG");
+            dump = log && strstr(log, "framedump");
+        }
+        if (dump)
+            m32_dump_gl_frame();
+        Obj ctx = H(0);
+        pthread_once(&g_frame_times_once, open_frame_times);
+        int timed = g_frame_times && m32_qd_port_window(drawable_of(ctx));
+        uint64_t entry = timed ? clock_gettime_nsec_np(CLOCK_MONOTONIC) : 0;
+        agl.swap_buffers(ctx);
+        if (timed) {
+            uint64_t returned = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+            if (g_frame_trace)
+                os_signpost_event_emit(g_frame_trace, OS_SIGNPOST_ID_EXCLUSIVE, "AGL Swap",
+                                       "monotonic_ns=%{public}llu", (unsigned long long)returned);
+            fprintf(g_frame_times, "%" PRIu64 " %" PRIu64 "\n", entry, returned);
+        }
+    }
+    RET(0);
+}
 
