+int m32_carbon_agl_content_click(uint32_t guest_event)
+{
+    enum { MOUSE_DOWN = 1, MOUSE_UP = 2, IN_CONTENT = 3 };
+    typedef struct { int16_t v, h; } CarbonPoint;
+    uint32_t (*event_class)(void *) = (uint32_t (*)(void *))carbon_fn("GetEventClass");
+    uint32_t (*event_kind)(void *) = (uint32_t (*)(void *))carbon_fn("GetEventKind");
+    void *event = guest_event ? m32_host(guest_event) : NULL;
+    if (!event || !event_class || !event_kind || event_class(event) != FOUR('m','o','u','s'))
+        return 0;
+    uint32_t kind = event_kind(event);
+    if ((kind != MOUSE_DOWN && kind != MOUSE_UP) || !ev_ready())
+        return 0;
+
+    void *render_window = m32_agl_current_window();
+    void *window = NULL;
+    int16_t part = 0;
+    if (ev.get(event, FOUR('w','i','n','d'), FOUR('w','i','n','d'), NULL, sizeof window, NULL, &window) ||
+        ev.get(event, FOUR('w','p','a','r'), FOUR('w','p','a','r'), NULL, sizeof part, NULL, &part)) {
+        CarbonPoint location;
+        int16_t (*find_window)(CarbonPoint, void **) =
+            (int16_t (*)(CarbonPoint, void **))carbon_fn("FindWindow");
+        window = NULL;
+        if (find_window && !ev.get(event, FOUR('m','l','o','c'), FOUR('Q','D','p','t'), NULL,
+                                   sizeof location, NULL, &location))
+            part = find_window(location, &window);
+    }
+    int content = render_window && window == render_window && part == IN_CONTENT;
+    fprintf(stderr, "ocerz: AGL mouse %s part=%d window=%p drawable=%p %s\n",
+            kind == MOUSE_DOWN ? "down" : "up", part, window, render_window,
+            content ? "game handles click" : "Carbon handles click");
+    return content;
+}
