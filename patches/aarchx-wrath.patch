+static void test_agl_guest_unpack_alias(void)
+{
+    enum { UNPACK = 0x88EC, STREAM_DRAW = 0x88E0, WRITE_ONLY = 0x88B9,
+           FLUSHING_UNMAP_APPLE = 0x8A13, SIZE = 8 * 1024 * 1024 };
+    void (*gen)(int, uint32_t *) = (void (*)(int, uint32_t *))dlsym(RTLD_DEFAULT, "glGenBuffers");
+    void (*bind)(unsigned, uint32_t) = (void (*)(unsigned, uint32_t))dlsym(RTLD_DEFAULT, "glBindBuffer");
+    void (*data)(unsigned, intptr_t, const void *, unsigned) =
+        (void (*)(unsigned, intptr_t, const void *, unsigned))dlsym(RTLD_DEFAULT, "glBufferData");
+    void *(*map)(unsigned, unsigned) = (void *(*)(unsigned, unsigned))dlsym(RTLD_DEFAULT, "glMapBuffer");
+    unsigned char (*unmap)(unsigned) = (unsigned char (*)(unsigned))dlsym(RTLD_DEFAULT, "glUnmapBuffer");
+    void (*parameter)(unsigned, unsigned, int) =
+        (void (*)(unsigned, unsigned, int))dlsym(RTLD_DEFAULT, "glBufferParameteriAPPLE");
+    void (*flush)(unsigned, intptr_t, intptr_t) =
+        (void (*)(unsigned, intptr_t, intptr_t))dlsym(RTLD_DEFAULT, "glFlushMappedBufferRangeAPPLE");
+    void (*read)(unsigned, intptr_t, intptr_t, void *) =
+        (void (*)(unsigned, intptr_t, intptr_t, void *))dlsym(RTLD_DEFAULT, "glGetBufferSubData");
+    void (*remove)(int, const uint32_t *) = (void (*)(int, const uint32_t *))dlsym(RTLD_DEFAULT, "glDeleteBuffers");
+    check("guest unpack alias test entry points", gen && bind && data && map && unmap && parameter && flush && read && remove);
+    if (!gen || !bind || !data || !map || !unmap || !parameter || !flush || !read || !remove)
+        return;
+    uint8_t *sentinel = malloc(SIZE);
+    check("allocate unpack test data", sentinel != NULL);
+    if (!sentinel)
+        return;
+    memset(sentinel, 0x25, SIZE);
+    uint32_t names[2] = { 0 };
+    gen(2, names);
+    size_t page = (size_t)getpagesize();
+    for (int explicit_flush = 0; explicit_flush < 2; explicit_flush++) {
+        bind(UNPACK, names[explicit_flush]);
+        data(UNPACK, SIZE, sentinel, STREAM_DRAW);
+        if (explicit_flush)
+            parameter(UNPACK, FLUSHING_UNMAP_APPLE, 0);
+        void *host = map(UNPACK, WRITE_ONLY);
+        check("the driver returns a whole aligned 8 MiB unpack mapping", host && (uintptr_t)host % page == 0);
+        if (!host)
+            continue;
+        uint64_t guest = ocerz_map_donate(SIZE);
+        check("reserve an isolated i386 address range", guest && guest <= M32_HANDLE_LO - SIZE);
+        if (guest && guest <= M32_HANDLE_LO - SIZE && (uintptr_t)host % page == 0) {
+            mach_vm_address_t target = (uintptr_t)m32_h((uint32_t)guest);
+            mach_vm_address_t alias = target;
+            vm_prot_t current = VM_PROT_NONE, max = VM_PROT_NONE;
+            kern_return_t kr = mach_vm_remap(mach_task_self(), &alias, SIZE, 0,
+                                             VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, mach_task_self(), (uintptr_t)host,
+                                             FALSE, &current, &max, VM_INHERIT_NONE);
+            int writable = kr == KERN_SUCCESS && alias == target && (current & VM_PROT_WRITE) && !(current & VM_PROT_EXECUTE);
+            check("alias whole writable PBO pages into the isolated guest range", writable);
+            if (writable) {
+                const uint32_t offset = SIZE - (uint32_t)page + 64;
+                m32_wr((uint32_t)guest + offset, 0x85421355);
+                if (explicit_flush)
+                    flush(UNPACK, offset, sizeof(uint32_t));
+                check("revoke the guest alias while the native map is valid", ocerz_unmap(guest, SIZE) == OCERZ_OK &&
+                      !ocerz_addr_committed(guest));
+                check("the native unpack buffer still unmaps normally", unmap(UNPACK) != 0);
+                uint32_t pixels[3] = { 0 };
+                read(UNPACK, offset - sizeof(uint32_t), sizeof pixels, pixels);
+                check("guest address writes appear with neighboring bytes intact",
+                      pixels[0] == 0x25252525 && pixels[1] == 0x85421355 && pixels[2] == 0x25252525);
+                continue;
+            }
+        }
+        if (guest)
+            ocerz_unmap(guest, SIZE);
+        unmap(UNPACK);
+    }
+    remove(2, names);
+    free(sentinel);
+}
