+static uint32_t test_live_agl_unpack_alias(void)
+{
+    enum { UNPACK = 0x88EC, ARRAY = 0x8892, STREAM_DRAW = 0x88E0, WRITE_ONLY = 0x88B9,
+           POINTER = 0x88BD, FLUSHING_UNMAP_APPLE = 0x8A13, SIZE = 8 * 1024 * 1024, OFFSET = SIZE - 16400 };
+    void (*gen)(int, uint32_t *) = (void (*)(int, uint32_t *))dlsym(RTLD_DEFAULT, "glGenBuffers");
+    void (*bind)(unsigned, uint32_t) = (void (*)(unsigned, uint32_t))dlsym(RTLD_DEFAULT, "glBindBuffer");
+    void (*data)(unsigned, intptr_t, const void *, unsigned) =
+        (void (*)(unsigned, intptr_t, const void *, unsigned))dlsym(RTLD_DEFAULT, "glBufferData");
+    void (*read)(unsigned, intptr_t, intptr_t, void *) =
+        (void (*)(unsigned, intptr_t, intptr_t, void *))dlsym(RTLD_DEFAULT, "glGetBufferSubData");
+    void (*parameter)(unsigned, unsigned, int) =
+        (void (*)(unsigned, unsigned, int))dlsym(RTLD_DEFAULT, "glBufferParameteriAPPLE");
+    unsigned (*get_error)(void) = (unsigned (*)(void))dlsym(RTLD_DEFAULT, "glGetError");
+    void (*begin)(unsigned) = (void (*)(unsigned))dlsym(RTLD_DEFAULT, "glBegin");
+    void (*end)(void) = (void (*)(void))dlsym(RTLD_DEFAULT, "glEnd");
+    check("runtime alias test entry points", gen && bind && data && read && parameter && get_error && begin && end);
+    if (!gen || !bind || !data || !read || !parameter || !get_error || !begin || !end)
+        return 0;
+    uint8_t *sentinel = malloc(SIZE);
+    check("allocate runtime alias test data", sentinel != NULL);
+    if (!sentinel)
+        return 0;
+    memset(sentinel, 0x47, SIZE);
+    if (getenv("OCERZ_M32_TEST_GL_SHADOW_BATCH")) {
+        const unsigned array_size = SIZE / 4, offset = 128, count = 300;
+        uint32_t buffers[2] = { 0 };
+        gen(2, buffers);
+        bind(ARRAY, buffers[0]);
+        data(ARRAY, array_size, sentinel, STREAM_DRAW);
+        parameter(ARRAY, FLUSHING_UNMAP_APPLE, 0);
+        bind(UNPACK, buffers[1]);
+        data(UNPACK, SIZE, sentinel, STREAM_DRAW);
+        parameter(UNPACK, FLUSHING_UNMAP_APPLE, 0);
+
+        unsigned complete = 0;
+        uint64_t started = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+        for (; complete < count; complete++) {
+            uint32_t guest = call("_glMapBuffer", 2, (uint32_t[]){ ARRAY, WRITE_ONLY });
+            if (!guest)
+                break;
+            int intact = m32_rd(guest + offset - 4) == 0x47474747 &&
+                         m32_rd(guest + offset + 4) == 0x47474747;
+            m32_wr(guest + offset, complete);
+            call("_glFlushMappedBufferRangeAPPLE", 3, (uint32_t[]){ ARRAY, offset, 4 });
+            if (!call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) || !intact)
+                break;
+            guest = call("_glMapBuffer", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+            if (!guest)
+                break;
+            m32_wr(guest + offset, complete);
+            call("_glFlushMappedBufferRangeAPPLE", 3, (uint32_t[]){ UNPACK, offset, 4 });
+            if (!call("_glUnmapBuffer", 1, (uint32_t[]){ UNPACK }) || ocerz_addr_committed(guest))
+                break;
+        }
+        double elapsed_ms = (clock_gettime_nsec_np(CLOCK_MONOTONIC) - started) / 1e6;
+        fprintf(stderr, "AGL shadow batch: %u pairs in %.3f ms\n", complete, elapsed_ms);
+        check("alternate array shadows and unpack aliases", complete == count);
+        const uint32_t expected[] = { 0x47474747, count - 1, 0x47474747 };
+        uint32_t array[3] = { 0 }, unpack[3] = { 0 };
+        read(ARRAY, offset - 4, sizeof array, array);
+        read(UNPACK, offset - 4, sizeof unpack, unpack);
+        check("alternating maps preserve vertex and upload data",
+              !memcmp(array, expected, sizeof array) && !memcmp(unpack, expected, sizeof unpack) && get_error() == 0);
+        memcpy(m32_h(DATA + 0xc50), buffers, sizeof buffers);
+        call("_glDeleteBuffers", 2, (uint32_t[]){ 2, DATA + 0xc50 });
+    }
+    uint32_t names[2] = { 0 };
+    gen(2, names);
+    uint32_t query[] = { UNPACK, POINTER, DATA + 0xc64 };
+    for (int i = 0; i < 2; i++) {
+        bind(UNPACK, names[i]);
+        data(UNPACK, SIZE, sentinel, STREAM_DRAW);
+        if (i)
+            parameter(UNPACK, FLUSHING_UNMAP_APPLE, 0);
+        uint32_t guest = call("_glMapBufferARB", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+        check("the upload uses a page-aligned guest alias", guest && guest % getpagesize() == 0);
+        if (!guest)
+            continue;
+        call("_glGetBufferPointervARB", 3, query);
+        check("the pointer query returns the exact active guest alias", m32_rd(query[2]) == guest);
+        m32_wr(guest + OFFSET, 0xa3875213);
+        if (i)
+            call("_glFlushMappedBufferRangeAPPLE", 3, (uint32_t[]){ UNPACK, OFFSET, sizeof(uint32_t) });
+        check("normal unmap revokes the shared guest pages",
+              call("_glUnmapBufferARB", 1, (uint32_t[]){ UNPACK }) == 1 && !ocerz_addr_committed(guest));
+        uint32_t out[3] = { 0 };
+        read(UNPACK, OFFSET - 4, sizeof out, out);
+        check("the native buffer kept both its write and its neighbors",
+              out[0] == 0x47474747 && out[1] == 0xa3875213 && out[2] == 0x47474747);
+    }
+    free(sentinel);
+    bind(UNPACK, names[0]);
+    uint32_t alias = call("_glMapBuffer", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+    bind(ARRAY, names[0]);
+    call("_glBufferDataARB", 4, (uint32_t[]){ ARRAY, UINT32_MAX, 0, STREAM_DRAW });
+    unsigned error = get_error();
+    check("a rejected alternate-target allocation preserves the mapping and GL error",
+          alias && ocerz_addr_committed(alias) && error != 0);
+    call("_glBufferData", 4, (uint32_t[]){ ARRAY, SIZE, 0, STREAM_DRAW });
+    error = get_error();
+    call("_glGetBufferPointerv", 3, query);
+    if (error) {
+        /* The M4 legacy renderer rejects reallocation of a live mapping. */
+        check("the driver still exposes the original alias after it rejects resizing",
+              alias && ocerz_addr_committed(alias) && m32_rd(query[2]) == alias);
+        check("unmapping through another target revokes the shared buffer",
+              call("_glUnmapBuffer", 1, (uint32_t[]){ ARRAY }) == 1 && !ocerz_addr_committed(alias));
+        call("_glBufferData", 4, (uint32_t[]){ ARRAY, SIZE, 0, STREAM_DRAW });
+        call("_glGetBufferPointerv", 3, query);
+    }
+    check("reallocation leaves no committed old alias or current mapping",
+          alias && !ocerz_addr_committed(alias) && m32_rd(query[2]) == 0 && get_error() == 0);
+    alias = call("_glMapBuffer", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+    m32_wr(DATA + 0xc50, names[0]);
+    begin(0 /* GL_POINTS */);
+    call("_glDeleteBuffers", 2, (uint32_t[]){ 1, DATA + 0xc50 });
+    end();
+    error = get_error();
+    check("a rejected delete retains the live mapping and driver error",
+          alias && ocerz_addr_committed(alias) && error == 0x0502 /* GL_INVALID_OPERATION */);
+    call("_glDeleteBuffersARB", 2, (uint32_t[]){ 1, DATA + 0xc50 });
+    check("deleting the mapped object revokes its alias", alias && !ocerz_addr_committed(alias));
+    bind(UNPACK, names[1]);
+    data(UNPACK, 65536, NULL, STREAM_DRAW);
+    parameter(UNPACK, FLUSHING_UNMAP_APPLE, 1);
+    uint32_t copied = call("_glMapBuffer", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+    check("a small upload maps through the copied fallback", copied != 0);
+    if (copied) {
+        m32_wr(copied + 4, 0xc34b142d);
+        call("_glGetBufferPointerv", 3, query);
+        check("the pointer query addresses the upload fallback", m32_rd(query[2]) == copied);
+        check("the upload fallback unmaps", call("_glUnmapBuffer", 1, (uint32_t[]){ UNPACK }) == 1);
+        uint32_t saved = 0;
+        read(UNPACK, 4, sizeof saved, &saved);
+        check("the fallback preserves the guest's native upload bytes", saved == 0xc34b142d);
+    }
+    data(UNPACK, SIZE, NULL, STREAM_DRAW);
+    alias = call("_glMapBuffer", 2, (uint32_t[]){ UNPACK, WRITE_ONLY });
+    check("a final alias is live before context destruction", alias && ocerz_addr_committed(alias));
+    return alias;
+}
