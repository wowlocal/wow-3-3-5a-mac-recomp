+static void test_agl_click_scope(uint32_t port)
+{
+    void *hi = dlopen(CARBON, RTLD_LAZY);
+    int32_t (*create)(void *, uint32_t, uint32_t, double, uint32_t, void **) =
+        (int32_t (*)(void *, uint32_t, uint32_t, double, uint32_t, void **))dlsym(hi, "CreateEvent");
+    int32_t (*set)(void *, uint32_t, uint32_t, unsigned long, const void *) =
+        (int32_t (*)(void *, uint32_t, uint32_t, unsigned long, const void *))dlsym(hi, "SetEventParameter");
+    void (*release)(void *) = (void (*)(void *))dlsym(hi, "ReleaseEvent");
+    void *window = m32_qd_port_window(port);
+    uint32_t mouse = FOUR('m','o','u','s'), wind = FOUR('w','i','n','d'), wpar = FOUR('w','p','a','r');
+    for (uint32_t kind = 1; kind <= 2; ++kind) {
+        void *event = NULL;
+        check("create a mouse-button event for a window", create(NULL, mouse, kind, 0, 0, &event) == 0);
+        if (!event)
+            continue;
+        int16_t part = 3;  /* inContent */
+        check("set mouse-button window and part", set(event, wind, wind, sizeof window, &window) == 0 &&
+                                                set(event, wpar, wpar, sizeof part, &part) == 0);
+        uint32_t guest_event = m32_handle(event);
+        int scoped = m32_carbon_agl_content_click(guest_event);
+        check("AGL click scope includes mouse down and up in its content", scoped);
+        if (scoped) {
+            setenv("OCERZ_PROBE_AGL_CONTENT_CLICKS", "1", 1);
+            uint32_t args[] = { 0, guest_event };
+            check("CallNextEventHandler returns eventNotHandledErr to the guest",
+                  (int32_t)cross(CARBON, "_CallNextEventHandler", 2, args) == -9874);
+            unsetenv("OCERZ_PROBE_AGL_CONTENT_CLICKS");
+        }
+        part = 4;  /* inDrag (title bar) */
+        check("AGL click scope excludes the title bar", set(event, wpar, wpar, sizeof part, &part) == 0 &&
+                                                       !m32_carbon_agl_content_click(guest_event));
+        void *other_window = NULL;
+        part = 3;
+        check("AGL click scope requires the drawable window", set(event, wind, wind, sizeof other_window, &other_window) == 0 &&
+                                                              set(event, wpar, wpar, sizeof part, &part) == 0 &&
+                                                              !m32_carbon_agl_content_click(guest_event));
+        release(event);
+    }
+}
