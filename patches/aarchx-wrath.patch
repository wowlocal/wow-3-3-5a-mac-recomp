+        uint32_t result = call("_KeyTranslate", 3, (uint32_t[]){ guest, code, guest_state });
+        check("KeyTranslate preserves modifiers and 32-bit guest state",
+              result == expected && m32_rd(guest_state) == reference &&
+              m32_rd(guest_state + 4) == 0x1ee7cafe);
+        result = call("_KeyTranslate", 3, (uint32_t[]){ guest, code, host_handle });
+        check("KeyTranslate updates host-backed state through its handle",
+              result == expected && host_state == reference);
