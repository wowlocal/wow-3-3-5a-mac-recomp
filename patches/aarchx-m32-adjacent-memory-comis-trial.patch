diff --git a/tests/unit/test_jit32.c b/tests/unit/test_jit32.c
--- a/tests/unit/test_jit32.c
+++ b/tests/unit/test_jit32.c
@@ -72,4 +72,5 @@
 static int g_ebp_case = -1;
 static int g_shared_base_case = -1;
+static int g_adjacent_comis_case = -1;
 static OcerzVM g_vm;
 static OcerzCPU *cpu(void) { return &g_vm.cpu; }
@@ -115,4 +116,11 @@
     memset(&cpu()->xmm[0], 0x5a, sizeof cpu()->xmm[0]);
     memset(&cpu()->xmm[1], 0xa5, sizeof cpu()->xmm[1]);
+    if (g_adjacent_comis_case >= 0) {
+        static const uint64_t left[] = {
+            0x3f000000, 0x3f800000, 0x7fc00000, 0x7fc00000,
+            0x4000000000000000ull, 0x3f800000, 0x3f800000,
+        };
+        memcpy(&cpu()->xmm[0], &left[g_adjacent_comis_case], sizeof left[0]);
+    }
     if (g_fpb_case >= 0) {
         static const uint32_t values[3][2][4] = {
@@ -138,4 +146,8 @@
     for (size_t i = 0; i < DATA_WIN; i++)
         d[i] = (uint8_t)(0x40 + (i * 7));
+    if (g_adjacent_comis_case >= 0) {
+        uint64_t right = g_adjacent_comis_case == 4 ? 0x3ff0000000000000ull : 0x3f800000;
+        memcpy(d, &right, sizeof right);
+    }
     uint8_t *s = (uint8_t *)ocerz_g2h(M32_STACK - 0x100);
     for (size_t i = 0; i < 0x200; i++)
@@ -442,4 +454,40 @@
             break;
         }
+        return g_failures != 0;
+    }
+
+    const char *adjacent_comis = getenv("OCERZ_TEST_JIT32_COMIS_ADJACENT");
+    if (adjacent_comis) {
+        if (adjacent_comis[0] < '0' || adjacent_comis[0] > '6' || adjacent_comis[1]) return 2;
+        g_adjacent_comis_case = adjacent_comis[0] - '0';
+        static const uint8_t jcc[] = { 0x72, 0x74, 0x74, 0x75, 0x77, 0x7b, 0x74 };
+        static const uint8_t compare[] = { 0x0f,0x2e,0x05,0x00,0x00,0x50,0x00 };
+        static const uint8_t separated[] = { 0xbb,0x08,0x00,0x00,0x00 };
+        static const uint8_t paths[] = {
+            0x31,0xc9, 0xb8,1,0,0,0, 0xeb,7,
+            0x31,0xc9, 0xb8,2,0,0,0,
+        };
+        uint8_t code[40];
+        size_t length = 0;
+        if (g_adjacent_comis_case == 4)
+            code[length++] = 0x66;
+        memcpy(code + length, compare, sizeof compare);
+        length += sizeof compare;
+        if (g_adjacent_comis_case == 5) {
+            memcpy(code + length, separated, sizeof separated);
+            length += sizeof separated;
+        }
+        code[length++] = jcc[g_adjacent_comis_case];
+        code[length++] = g_adjacent_comis_case == 6 ? 2 : 9;
+        if (g_adjacent_comis_case == 6) {
+            // Both routes consume the compare flags, so the rewrite is ineligible.
+            code[length++] = 0x9c; code[length++] = 0x5a;  // pushfd; pop edx
+            code[length++] = 0x9c; code[length++] = 0x58;  // pushfd; pop eax
+        }
+        memcpy(code + length, paths, sizeof paths);
+        length += sizeof paths;
+        char label[80];
+        snprintf(label, sizeof label, "memory COMIS with an adjacent branch (case %d)", g_adjacent_comis_case);
+        run_case(label, M32_CODE, M32_STACK, code, length);
         return g_failures != 0;
     }
