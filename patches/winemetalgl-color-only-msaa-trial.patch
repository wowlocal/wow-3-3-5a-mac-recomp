+TEST(arb_msaa_color_pass_preserves_depth_and_stencil) {
+    gpu::Fixture fixture(64, 64, false, 33, false, 24, false, 4);
+    CHECK(fixture.ok);
+    if (!fixture.ok) return;
+    loadArb();
+    identity();
+    GLint samples = 0;
+    glGetIntegerv(GL_SAMPLES, &samples);
+    CHECK_EQ(samples, 4);
+
+    const auto rectangle = [](float left, float right, float depth) {
+        glBegin(GL_QUADS);
+        glVertex3f(left, -1, depth);
+        glVertex3f(right, -1, depth);
+        glVertex3f(right, 1, depth);
+        glVertex3f(left, 1, depth);
+        glEnd();
+    };
+    glClearColor(0, 0, 0, 1);
+    glClearStencil(0);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    glEnable(GL_STENCIL_TEST);
+    glStencilMask(0xff);
+    glStencilFunc(GL_ALWAYS, 7, 0xff);
+    glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
+    glColor4f(0, 0, 1, 1);
+    rectangle(-1, 0, 0);
+    CHECK(wmgl_surface_swap(fixture.surface));
+
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glColor4f(0, 1, 0, 1);
+    rectangle(0, 1, 0);
+    CHECK(pixel(16, 16, kBlue, 0));
+    CHECK(pixel(48, 16, kGreen, 0));
+
+    // Reattach the original depth and stencil while the color pass is open.
+    rectangle(0, 1, 0);
+    glEnable(GL_DEPTH_TEST);
+    glDepthMask(GL_FALSE);
+    glColor4f(1, 0, 0, 1);
+    rectangle(-1, 1, 0.5f);
+    glEnable(GL_STENCIL_TEST);
+    glStencilFunc(GL_EQUAL, 7, 0xff);
+    glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);
+    glColor4f(0, 1, 0, 1);
+    rectangle(-1, 1, -0.5f);
+    CHECK(pixel(16, 16, kGreen, 0));
+    CHECK(pixel(48, 16, kRed, 0));
+
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glColor4f(1, 0, 0, 1);
+    rectangle(-1, 1, 0);
+    glClearStencil(9);
+    glClear(GL_STENCIL_BUFFER_BIT);
+    glEnable(GL_STENCIL_TEST);
+    glStencilFunc(GL_EQUAL, 9, 0xff);
+    glColor4f(0, 0, 1, 1);
+    rectangle(-1, 1, 0);
+    CHECK(pixel(16, 16, kBlue, 0));
+    CHECK(pixel(48, 16, kBlue, 0));
+    CHECK_GL();
