+void DrawState::selectDrawAttachments(RenderTargetDesc& target, TargetFormats& formats, const LinkedProgram& program) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_COLOR_ONLY_MSAA");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    const ContextState& state = ctx_.state;
+    if (!enabled || !target.colorResolve || !target.color[0].texture ||
+        !(formats.depthAttached || formats.stencilAttached) || state.depthTest || state.stencilTest ||
+        !ffProgram_ || ffProgram_->linked.get() != &program) return;
+    // Keep an open full pass and honor pending clears on the original
+    // framebuffer. A later draw that needs either attachment will reopen a
+    // full pass and load the same surface storage.
+    const CommandStream& stream = ctx_.stream();
+    if (stream.continuesPass(target) || stream.hasPendingClear()) return;
+    if (state.fixed.fragmentProgram) {
+        const auto& fragment = compat::arbBound(ctx_, 1);
+        if (!fragment.parsed || fragment.parsed->depthWritten) return;
+    }
+    target.depth = {};
+    target.stencil = {};
+    formats.depth = formats.stencil = MTLPixelFormatInvalid;
+    formats.depthAttached = formats.stencilAttached = false;
+}
