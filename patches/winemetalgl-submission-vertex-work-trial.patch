+FILE* vertexWorkLog() {
+    static FILE* log = []() -> FILE* {
+        const char* path = std::getenv("OCERZ_WMGL_VERTEX_WORK_LOG");
+        if (!path || !*path || !submissionLog()) return nullptr;
+        FILE* file = std::fopen(path, "wx");
+        if (!file) std::perror("cannot create WineMetalGL vertex work log");
         return file;
     }();
     return log;
@@ -653,6 +664,21 @@
     lastPrelude_ = nil;
 }

+bool CommandStream::vertexWorkProfileEnabled() {
+    return vertexWorkLog() != nullptr;
+}
+
+void CommandStream::noteVertexWork(uint64_t program, uint32_t instructions, uint32_t parameters,
+                                   uint64_t references) {
+    for (VertexWork& work : vertexWork_) {
+        if (work.program != program) continue;
+        ++work.draws;
+        work.references += references;
+        return;
+    }
+    vertexWork_.push_back({program, instructions, parameters, 1, references});
+}
