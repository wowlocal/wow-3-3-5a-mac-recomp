+static void test_trap_diagnostics(void)
+{
+    const char *names[] = { "_task_set_exception_ports", "_thread_set_exception_ports",
+                            "_Gestalt", "_GestaltOther", "_CallNextEventHandler" };
+    for (size_t index = 0; index < sizeof names / sizeof names[0]; ++index)
+        check("publish the diagnostic fixture export", m32_export_special(names[index], diagnostic_stub) != 0);
+
+    unsetenv("OCERZ_DIAG_KEEP_HOST_EXCEPTIONS");
+    check("ordinary task exception trap reaches its handler", cross("(m32)", names[0], 0, NULL) == 0xa13eu);
+    setenv("OCERZ_DIAG_KEEP_HOST_EXCEPTIONS", "1", 1);
+    check("diagnostic task exception override", cross("(m32)", names[0], 0, NULL) == 0);
+    check("diagnostic thread exception override", cross("(m32)", names[1], 0, NULL) == 0);
+    unsetenv("OCERZ_DIAG_KEEP_HOST_EXCEPTIONS");
+    check("ordinary thread exception trap reaches its handler", cross("(m32)", names[1], 0, NULL) == 0xa13eu);
+
+    const uint32_t request[] = { 0x7174696d, DATA };
+    m32_wr(DATA, 0x1234);
+    unsetenv("OCERZ_DIAG_QUICKTIME_VERSION");
+    check("ordinary Gestalt trap reaches its handler", cross("(m32)", names[2], 2, request) == 0xa13eu &&
+          m32_rd(DATA) == 0x1234);
+    setenv("OCERZ_DIAG_QUICKTIME_VERSION", "1", 1);
+    check("diagnostic QuickTime selector writes the version", cross("(m32)", names[2], 2, request) == 0 &&
+          m32_rd(DATA) == 0x06518000);
+    check("another Gestalt selector reaches its handler",
+          cross("(m32)", names[2], 2, (uint32_t[]){ 0x74657374, DATA }) == 0xa13eu);
+    check("similarly named export reaches its handler", cross("(m32)", names[3], 2, request) == 0xa13eu);
+    unsetenv("OCERZ_DIAG_QUICKTIME_VERSION");
+    setenv("OCERZ_PROBE_AGL_CONTENT_CLICKS", "1", 1);
+    check("a null event falls through to the event handler",
+          cross("(m32)", names[4], 2, (uint32_t[]){ 0, 0 }) == 0xa13eu);
+    unsetenv("OCERZ_PROBE_AGL_CONTENT_CLICKS");
 }

