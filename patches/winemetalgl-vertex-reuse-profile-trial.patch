+struct CommandStream::VertexReuse {
+    std::array<std::unordered_set<uint64_t>, 4> current, previous;
+    std::array<uint64_t, 4> sameFrame{}, previousFrame{};
+    uint64_t draws = 0, references = 0;
+    uint64_t trackedDraws = 0, trackedReferences = 0, completeReferences = 0;
+};
+
+static FILE* vertexReuseLog() {
+    static FILE* file = []() -> FILE* {
+        const char* path = std::getenv("OCERZ_WMGL_VERTEX_REUSE_LOG");
+        if (!path || !*path) return nullptr;
+        FILE* result = std::fopen(path, "wx");
+        if (!result) std::perror("cannot create WineMetalGL vertex reuse log");
+        return result;
+    }();
+    return file;
+}
+
+bool CommandStream::vertexReuseProfileEnabled() {
+    return vertexReuseLog() != nullptr;
+}
+
+void CommandStream::noteVertexReuse(uint64_t references, const uint64_t* keys, int keyCount) {
+    if (!vertexReuse_) vertexReuse_ = std::make_unique<VertexReuse>();
+    VertexReuse& frame = *vertexReuse_;
+    ++frame.draws;
+    frame.references += references;
+    if (keyCount >= 2) {
+        ++frame.trackedDraws;
+        frame.trackedReferences += references;
+    }
+    if (keyCount == 4) frame.completeReferences += references;
+    for (int i = 0; i < keyCount; ++i) {
+        if (!frame.current[i].insert(keys[i]).second) frame.sameFrame[i] += references;
+        if (frame.previous[i].count(keys[i])) frame.previousFrame[i] += references;
+    }
+}
+
+void CommandStream::finishVertexReuseFrame(uint64_t stream, uint64_t sequence, uint64_t draws) {
+    if (!vertexReuse_) return;
+    VertexReuse& frame = *vertexReuse_;
+    std::fprintf(vertexReuseLog(), "%d %llu %llu %llu %llu %llu %llu %llu %llu",
+                 getpid(), (unsigned long long)stream, (unsigned long long)sequence,
+                 (unsigned long long)draws, (unsigned long long)frame.draws,
+                 (unsigned long long)frame.references, (unsigned long long)frame.trackedDraws,
+                 (unsigned long long)frame.trackedReferences, (unsigned long long)frame.completeReferences);
+    for (uint64_t count : frame.sameFrame) std::fprintf(vertexReuseLog(), " %llu", (unsigned long long)count);
+    for (uint64_t count : frame.previousFrame) std::fprintf(vertexReuseLog(), " %llu", (unsigned long long)count);
+    std::fputc('\n', vertexReuseLog());
+    for (int i = 0; i < 4; ++i) {
+        frame.previous[i].swap(frame.current[i]);
+        frame.current[i].clear();
+    }
+    frame.sameFrame = {};
+    frame.previousFrame = {};
+    frame.draws = frame.references = frame.trackedDraws = frame.trackedReferences = frame.completeReferences = 0;
+}
