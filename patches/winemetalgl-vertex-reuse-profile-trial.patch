+        mix(address, reinterpret_cast<uintptr_t>((__bridge void*)source.mtl));
+        mix(address, source.size);
+        mix(version, source.version);
+        mix(version, source.lastWriteSerial);
+        tracked = tracked && !source.mapped && !source.pinned;
