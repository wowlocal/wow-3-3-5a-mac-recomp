+        mix(address, static_cast<uint32_t>(input.location));
+        mix(address, static_cast<uint32_t>(input.source()));
+        mix(address, static_cast<uint8_t>(input.kind));
+        mix(address, static_cast<uint32_t>(input.part));
+        mix(address, static_cast<uint32_t>(input.byteOffset));
+        mix(address, attrib.enabled);
+        if (!attrib.enabled) {
