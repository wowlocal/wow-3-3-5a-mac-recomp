+        if (parsed.localCount)
+            mix(keys[2], bytes(obj.local.data(), static_cast<size_t>(parsed.localCount) * sizeof(compat::Vec4)));
+        for (int i = 0; i < FixedState::kProgramMatrices; ++i) {
+            if (!((parsed.programMatrices | parsed.programMatrixInverses) & (1u << i))) continue;
+            const auto& matrix = ctx_.state.fixed.programMatrix[static_cast<size_t>(i)].back();
+            mix(keys[2], bytes(&matrix, sizeof(matrix)));
+        }
+        for (uint64_t field : {uint64_t(key.geometryPass), uint64_t(key.positionOnly),
+                               uint64_t(key.borders[0]), uint64_t(key.cull)})
+            mix(keys[2], field);
