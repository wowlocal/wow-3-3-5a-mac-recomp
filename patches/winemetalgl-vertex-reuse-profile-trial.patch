+TEST(arb_vertex_reuse_probe_tracks_uniform_changes) {
+    gpu::Fixture fixture(64, 64, false);
+    CHECK(fixture.ok);
+    if (!fixture.ok) return;
+    loadArb();
+    identity();
+    load(GL_VERTEX_PROGRAM_ARB,
+         "!!ARBvp1.0\n"
+         "MOV result.position, vertex.position;\n"
+         "MOV result.color, program.env[0];\n"
+         "END\n");
+    GLuint buffers[2] = {};
+    glGenBuffers(2, buffers);
+    const GLfloat vertices[] = {-1, -1, 1, -1, 0, 1};
+    const uint16_t indices[] = {0, 1, 2};
+    glBindBuffer(GL_ARRAY_BUFFER, buffers[0]);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
+    glVertexPointer(2, GL_FLOAT, 0, nullptr);
+    glEnableClientState(GL_VERTEX_ARRAY);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, buffers[1]);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indices), indices, GL_STATIC_DRAW);
+    glEnable(GL_VERTEX_PROGRAM_ARB);
+    clear();
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 1, 0, 0, 1);
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, nullptr);
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, nullptr);
+    CHECK(pixel(32, 32, kRed));
+    CHECK(wmgl_surface_swap(fixture.surface));
+    glProgramEnvParameter4fARB(GL_VERTEX_PROGRAM_ARB, 0, 0, 0, 1, 1);
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, nullptr);
+    CHECK(pixel(32, 32, kBlue));
+    CHECK(wmgl_surface_swap(fixture.surface));
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, nullptr);
+    CHECK(pixel(32, 32, kBlue));
+    CHECK(wmgl_surface_swap(fixture.surface));
+    load(GL_FRAGMENT_PROGRAM_ARB, "!!ARBfp1.0\nMOV result.color, fragment.color;\nEND\n");
+    glEnable(GL_FRAGMENT_PROGRAM_ARB);
+    glDrawElements(GL_TRIANGLES, 3, GL_UNSIGNED_SHORT, nullptr);
+    CHECK(pixel(32, 32, kBlue));
+    CHECK(wmgl_surface_swap(fixture.surface));
+    glDisable(GL_FRAGMENT_PROGRAM_ARB);
+    glDisable(GL_VERTEX_PROGRAM_ARB);
+    glDisableClientState(GL_VERTEX_ARRAY);
+    glDeleteBuffers(2, buffers);
+    CHECK_GL();
+}
