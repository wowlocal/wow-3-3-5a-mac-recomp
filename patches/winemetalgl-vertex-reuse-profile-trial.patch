+                               uint64_t(attrib.size), uint64_t(attrib.divisor), uint64_t(attrib.normalized),
+                               uint64_t(attrib.integer), uint64_t(attrib.isDouble)})
+            mix(address, field);
+        if (attrib.buffer) buffer(*attrib.buffer);
+        else tracked = false;
+    }
+    uint64_t keys[4] = {address, version, 0, 0};
+    mix(keys[1], address);
