+        if (vertex.usesDefaultUniforms) {
+            if (const Program* owner = stageProgram(program, static_cast<int>(Stage::Vertex))) {
+                if (!owner->uniformData.empty()) linkedUniforms = bytes(owner->uniformData.data(), owner->uniformData.size());
+            } else {
