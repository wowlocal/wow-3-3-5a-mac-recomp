--- /dev/null
+++ b/src/core/metal/queued_render_encoder.h
@@ -0,0 +1,12 @@
+#pragma once
+
+#import <Metal/Metal.h>
+#include <dispatch/dispatch.h>
+
+namespace wmgl {
+
+bool queuedRenderEnabled();
+id<MTLRenderCommandEncoder> makeQueuedRenderEncoder(id<MTLRenderCommandEncoder> encoder,
+                                                     dispatch_queue_t queue);
+
