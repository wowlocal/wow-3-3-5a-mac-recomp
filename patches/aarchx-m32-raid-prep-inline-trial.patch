+enum { PREP_INLINE_CALL = 4, PREP_INLINE_RET = 5 };
+
+static int prep_inline_site(uint64_t call, uint64_t target)
+{
+    if ((call == 0x965473 && target == 0x8c17c0) ||
+        (call == 0x96548f && target == 0x8c1e90))
+        return 1;
+    return ENV_ON("OCERZ_TEST_JIT32_PREP_INLINE") &&
+           call >= 0x400200 && call < 0x400300 && target >= 0x400300 && target < 0x400400;
+}
+
+static int splice_prep_i386(uint64_t target, uint64_t return_pc, X86Insn *scratch, int *next)
+{
+    const int first = *next;
+    uint64_t pc = target;
+    for (int i = first; i < JIT_MAX_BLOCK_INSNS - 1 && i - first < 300; i++) {
+        X86Insn *in = &scratch[i];
+        if (jit_decode(pc, in, 1) != OCERZ_OK || in->seg != OCERZ_SEG_NONE)
+            return 0;
+        switch (in->op) {
+        case OCERZ_OP_MOV: case OCERZ_OP_MOVSS: case OCERZ_OP_ADDSS: case OCERZ_OP_MULSS:
+        case OCERZ_OP_PUSH: case OCERZ_OP_LEAVE: case OCERZ_OP_SUB: case OCERZ_OP_ADD:
+        case OCERZ_OP_STC: case OCERZ_OP_CLC: case OCERZ_OP_NOP:
+            break;
+        case OCERZ_OP_RET:
+            if ((in->opsize && in->opsize != 4) || in->nops > 1 ||
+                (in->nops == 1 && (in->ops[0].kind != OCERZ_OPK_IMM || in->ops[0].imm > 4091)))
+                return 0;
+            g_ic_kind[i] = PREP_INLINE_RET;
+            g_ic_expect[i] = return_pc;
+            if (ENV_ON("OCERZ_M32_PREP_INLINE_LOG"))
+                fprintf(stderr, "ocerz: i386 prep inline callee=%#llx ret=%#llx insns=%d\n",
+                        (unsigned long long)target, (unsigned long long)pc, i - first + 1);
+            *next = i + 1;
+            return 1;
+        default:
+            return 0;
+        }
+        pc = (uint32_t)(pc + in->len);
+    }
     return 0;
 }

