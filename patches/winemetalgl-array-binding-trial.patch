--- a/src/core/driver.mm
+++ b/src/core/driver.mm
@@ -11,6 +11,7 @@
 #include <mutex>
 #include <string>
 
+#include "core/compat/immediate.h"
 #include "core/context.h"
 #include "core/metal/device.h"
 #include "core/util/settings.h"
@@ -379,6 +380,16 @@ WMGL_EXPORT int wmgl_make_current(wmgl_context* handle, wmgl_surface* draw, wmgl
 
 WMGL_EXPORT void* wmgl_get_proc_address(const char* name) { return lookupProc(name); }
 
+WMGL_EXPORT int wmgl_array_buffer_binding(unsigned int* name) {
+    Context* ctx = currentContext();
+    if (!ctx || !name || g_traceCalls || g_captureCalls || stats::g_enabled) return 0;
+    ShareLock lock(*ctx);
+    if (ctx->immediate && ctx->immediate->active) return 0;
+    const auto& binding = ctx->state.arrayBuffer;
+    *name = binding ? binding->name : 0;
+    return 1;
+}
