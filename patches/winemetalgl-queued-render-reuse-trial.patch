+
+struct BatchReleaser {
+    void operator()(Batch* batch) const {
+        if (!batch->occupied) {
+            delete batch;
+            return;
+        }
+        batch->commands.clear();
+        batch->payload.clear();
+        batch->viewports.clear();
+        batch->scissors.clear();
+        batch->encoder = nil;
+        batch->occupied->store(false, std::memory_order_release);
+    }
+};
+
+using BatchPtr = std::unique_ptr<Batch, BatchReleaser>;
+
+class BatchPool {
+public:
+    Batch* acquire(id<MTLRenderCommandEncoder> encoder) {
+        auto& slot = slots_[next_];
+        next_ = (next_ + 1) % slots_.size();
+        if (slot.occupied.load(std::memory_order_acquire)) return nullptr;
+        if (slot.batch) {
+            slot.batch->encoder = encoder;
+            slot.batch->reused = true;
+        } else {
+            slot.batch = std::make_unique<Batch>(encoder);
+            slot.batch->occupied = &slot.occupied;
+        }
+        slot.occupied.store(true, std::memory_order_relaxed);
+        return slot.batch.get();
+    }
+
+private:
+    struct Slot {
+        std::atomic_bool occupied{false};
+        std::unique_ptr<Batch> batch;
+    };
+    std::array<Slot, kReusableBatches> slots_;
+    size_t next_ = 0;
+};
+
+BatchPool* batchPool(dispatch_queue_t queue) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_QUEUED_RENDER_REUSE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled) return nullptr;
+    static char key;
+    auto* pool = static_cast<BatchPool*>(dispatch_queue_get_specific(queue, &key));
+    if (!pool) {
+        pool = new BatchPool;
+        dispatch_queue_set_specific(queue, &key, pool, [](void* context) {
+            delete static_cast<BatchPool*>(context);
+        });
+    }
+    return pool;
+}

