--- a/src/m32_gl.c
+++ b/src/m32_gl.c
@@ -479,6 +479,12 @@ static int map_common(struct OcerzVM *vm, OcerzCPU *cpu, unsigned target, uint32
             entry->direct = 1;
             if (whole)
                 entry->bufsize = size;
+            if (g_log_map_stats && whole && target == 0x88EC && size == 8 * 1024 * 1024) {
+                static uint64_t unpackDirectMaps;
