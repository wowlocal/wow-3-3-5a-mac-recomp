+PositionInputs collectPositionInputs(const Parsed& program) {
+    PositionInputs result;
+    uint64_t hash = 0xcbf29ce484222325ull;
+    const auto add = [&](uint64_t n) { hash = (hash ^ n) * 0x100000001b3ull; };
+    const auto text = [&](std::string_view value) { add(std::hash<std::string_view>{}(value)); };
+    if (program.positionInvariant) {
+        text("position-invariant");
+        result.signature = hash;
+        result.fixed = true;
+        result.complete = true;
+        return result;
+    }
+    std::set<int> env, local;
+    const auto expression = [&](const std::string& value) {
+        text(value);
+        const auto parameter = [&](bool environment, std::set<int>& indices) {
+            const std::string prefix = std::string(envName(program.kind, environment)) + "[";
+            size_t start = 0;
+            while ((start = value.find(prefix, start)) != std::string::npos) {
+                start += prefix.size();
+                char* end;
+                const long index = std::strtol(value.c_str() + start, &end, 10);
+                const int limit = environment ? Limits::kEnvParameters : Limits::kLocalParameters;
+                if (end != value.c_str() + start && *end == ']' && index >= 0 && index < limit)
+                    indices.insert(static_cast<int>(index));
+            }
+        };
+        parameter(true, env);
+        parameter(false, local);
+        if (value.find("gl_") != std::string::npos) result.fixed = true;
+        if (value.find("arb_pm") != std::string::npos)
+            result.matrices = program.programMatrices | program.programMatrixInverses;
+    };
+    const Body& body = *program.body;
+    std::array<uint8_t, Limits::kTemporaries> temps{};
+    unsigned needPosition = 15;
+    bool needAddress = false;
+    for (auto it = body.code.rbegin(); it != body.code.rend(); ++it) {
+        const Instruction& in = *it;
+        const Dest& dest = in.dst;
+        unsigned live = 0;
+        if (dest.base == Dest::Out && dest.output == Output::Position) {
+            live = needPosition & dest.mask;
+            needPosition &= ~live;
+        } else if (dest.base == Dest::Temp) {
+            live = temps[dest.index] & dest.mask;
+            temps[dest.index] &= ~live;
+        } else if (dest.base == Dest::Address) {
+            live = needAddress;
+            needAddress = false;
+        }
+        if (!live) continue;
+        add(static_cast<uint8_t>(in.op)); add(dest.base); add(dest.index); add(dest.mask); add(live);
+        for (int n = 0; n < in.sourceCount; ++n) {
+            const Operand& src = in.src[n];
+            add(src.base);
+            add(src.negate); add(src.extended);
+            for (int c = 0; c < 4; ++c) {
+                add(src.swizzle[c]); add(src.extSelect[c]); add(src.extNegate[c]);
+            }
+            switch (src.base) {
+            case Operand::Temp:
+                add(src.index);
+                // Track whole source registers. Multi-lane instructions can read
+                // a lane other than the component they write.
+                temps[src.index] = 15;
+                break;
+            case Operand::Address: needAddress = true; break;
+            case Operand::In:
+                add(static_cast<uint8_t>(src.input)); add(src.index);
+                break;
+            case Operand::Static: expression(src.expr); break;
+            case Operand::Array: {
+                const auto& array = body.arrays[static_cast<size_t>(src.index)];
+                add(src.relative >= 0);
+                if (src.relative < 0) expression(array.elements[static_cast<size_t>(src.offset)]);
+                else {
+                    add(src.offset);
+                    add(array.elements.size());
+                    needAddress = true;
+                    for (const auto& value : array.elements) expression(value);
+                }
+                break;
+            }
+            }
+        }
+    }
+    result.complete = needPosition == 0;
+    result.signature = hash;
+    result.env.assign(env.begin(), env.end());
+    result.local.assign(local.begin(), local.end());
+    return result;
+}
