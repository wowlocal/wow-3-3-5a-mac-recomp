+        }
+        ++entry.draws;
+        entry.references += static_cast<uint64_t>(count) * instances;
+    }
     const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
     if (!totals.first) totals.first = now;
     if (now - totals.first >= 4'000'000'000ull) {
