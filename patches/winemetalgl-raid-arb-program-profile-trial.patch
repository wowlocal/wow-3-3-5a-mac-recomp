@@ -2248,7 +2249,15 @@
     if (!enabled) return;

     enum Path { PROGRAMMABLE, FIXED_UNLIT, FIXED_OTHER_LIGHT, FIXED_DIRECTIONAL, INDIRECT, PATH_COUNT };
+    struct ProgramTotal {
+        GLuint name = 0;
+        int instructions = 0, temporaries = 0, parameters = 0;
+        unsigned inputs = 0;
+        bool positionInvariant = false;
+        uint64_t draws = 0, references = 0;
+    };
     struct Totals {
+        std::map<uint64_t, ProgramTotal> arb;
         uint64_t draws[PATH_COUNT] = {};
         uint64_t vertexReferences[PATH_COUNT] = {};
         uint64_t first = 0;
@@ -2256,10 +2265,11 @@
     static thread_local Totals totals;
     const auto& state = context.state;
     const auto& fixed = state.fixed;
+    const bool arbVertex = !indirect && compat::arbVertexProgramActive(context);
     Path path;
     if (indirect)
         path = INDIRECT;
