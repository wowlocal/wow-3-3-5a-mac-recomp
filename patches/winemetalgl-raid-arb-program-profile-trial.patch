@@ -2274,6 +2284,21 @@
     ++totals.draws[path];
     if (!indirect && count > 0 && instances > 0)
         totals.vertexReferences[path] += static_cast<uint64_t>(count) * instances;
+    if (arbVertex && count > 0 && instances > 0) {
+        const auto& object = compat::arbBound(context, 0);
+        auto& entry = totals.arb[object.serial];
+        if (!entry.draws) {
