+        unsigned w, h;
+        char extra;
+        if (size && sscanf(size, "%ux%u%c", &w, &h, &extra) == 2 &&
+            w > 0 && h > 0 && w <= 16384 && h <= 16384) {
+            requested_width = w;
+            requested_height = h;
+        }
+        parsed = 1;
+    }
+    if (!requested_width) return 0;
+    *width = requested_width;
+    *height = requested_height;
+    return 1;
+}
