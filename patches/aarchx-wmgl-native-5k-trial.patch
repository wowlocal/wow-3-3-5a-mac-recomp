+static CFDictionaryRef native_trial_mode(uint32_t display)
+{
+    static CFDictionaryRef result;
+    if (result) return result;
+    int width, height;
+    if (!m32_headless_native_size(&width, &height)) return NULL;
+    pthread_once(&graphics_modes_once, load_modes);
+    CFDictionaryRef current = g_mode.current ? g_mode.current(display) : NULL;
+    if (!current || !g_mode.string) return NULL;
+    CFMutableDictionaryRef (*copy)(CFAllocatorRef, CFIndex, CFDictionaryRef) =
+        dlsym(RTLD_DEFAULT, "CFDictionaryCreateMutableCopy");
+    CFNumberRef (*number)(CFAllocatorRef, CFNumberType, const void *) = dlsym(RTLD_DEFAULT, "CFNumberCreate");
+    void (*set)(CFMutableDictionaryRef, const void *, const void *) = dlsym(RTLD_DEFAULT, "CFDictionarySetValue");
+    void (*release)(CFTypeRef) = dlsym(RTLD_DEFAULT, "CFRelease");
+    if (!copy || !number || !set || !release) return NULL;
+    CFMutableDictionaryRef mode = copy(NULL, 0, current);
+    if (!mode) return NULL;
+    const char *keys[] = {"Width", "Height", "PixelWidth", "PixelHeight"};
+    const int values[] = {width, height, width, height};
+    for (unsigned i = 0; i < 4; i++) {
+        CFStringRef key = g_mode.string(NULL, keys[i], kCFStringEncodingASCII);
+        CFNumberRef value = number(NULL, kCFNumberIntType, &values[i]);
+        if (!key || !value) {
+            if (key) release(key);
+            if (value) release(value);
+            release(mode);
+            return NULL;
+        }
+        set(mode, key, value);
+        release(key);
+        release(value);
+    }
+    result = mode;
+    return result;
+}
