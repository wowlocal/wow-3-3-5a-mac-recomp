+static int sp_CGDisplayAvailableModes(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    (void)vm;
+    pthread_once(&graphics_modes_once, load_modes);
+    CFDictionaryRef mode = native_trial_mode(A(0));
+    CFArrayRef available = g_mode.available ? g_mode.available(A(0)) : NULL;
+    if (!mode) RET(m32_handle((void *)available));
+    static CFArrayRef expanded;
+    if (!expanded) {
+        CFArrayRef (*create)(CFAllocatorRef, const void **, CFIndex, const CFArrayCallBacks *) =
+            dlsym(RTLD_DEFAULT, "CFArrayCreate");
+        CFIndex n = available && g_mode.count && g_mode.at ? g_mode.count(available) : 0;
+        const void *modes[257];
+        if (!create || n < 0 || n > 256) RET(0);
+        for (CFIndex i = 0; i < n; i++) modes[i] = g_mode.at(available, i);
+        modes[n++] = mode;
+        expanded = create(NULL, modes, n, NULL);
+    }
+    RET(m32_handle((void *)expanded));
+}
