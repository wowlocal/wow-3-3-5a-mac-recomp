+static void observe_copy_policy(unsigned target, uint32_t size, int whole, int copy, int recent_null)
+{
+    enum { ACCESS_FLAGS = 0x911f, READ = 1, WRITE = 2, INVALIDATE = 12, EXPLICIT = 16,
+           PERSISTENT_OR_COHERENT = 0xc0 };
+    if (copy && size) {
+        int access = -1;
+        if (gl.buffer_iv) gl.buffer_iv(target, ACCESS_FLAGS, &access);
+        __atomic_add_fetch(&g_policy_copies, 1, __ATOMIC_RELAXED);
+        __atomic_add_fetch(&g_policy_input, size, __ATOMIC_RELAXED);
+        if (whole) __atomic_add_fetch(&g_policy_whole, size, __ATOMIC_RELAXED);
+        if (access < 0 || !(access & (READ | WRITE))) {
+            __atomic_add_fetch(&g_policy_unknown, size, __ATOMIC_RELAXED);
+        } else if ((access & (READ | WRITE | PERSISTENT_OR_COHERENT)) == WRITE) {
+            if (access & EXPLICIT)
+                __atomic_add_fetch(&g_policy_explicit, size, __ATOMIC_RELAXED);
+            else if (access & INVALIDATE)
+                __atomic_add_fetch(&g_policy_invalidate, size, __ATOMIC_RELAXED);
+        }
+        if (recent_null) __atomic_add_fetch(&g_policy_recent_null, size, __ATOMIC_RELAXED);
+    }
+    uint64_t maps = __atomic_add_fetch(&g_policy_maps, 1, __ATOMIC_RELAXED);
+    if ((maps & 16383) == 0) {
+        fprintf(stderr, "ocerz: GL map policy maps=%" PRIu64 " copies=%" PRIu64
+                " input=%" PRIu64 " whole=%" PRIu64 " explicit=%" PRIu64 " invalidate=%" PRIu64
+                " unknown=%" PRIu64 " recent_null=%" PRIu64 " unmap=%" PRIu64 " flush=%" PRIu64 "\n",
+                maps, __atomic_load_n(&g_policy_copies, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_input, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_whole, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_explicit, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_invalidate, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_unknown, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_recent_null, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_unmap_bytes, __ATOMIC_RELAXED),
+                __atomic_load_n(&g_policy_flush_bytes, __ATOMIC_RELAXED));
+    }
+}
