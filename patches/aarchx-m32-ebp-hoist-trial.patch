+static int select_m32_ebp_hoist(const X86Insn *insns, int n, uint64_t rip)
+{
+    if (!g_xlat_mode32 || g_pin_class != 3 || g_no_chain || !ocerz_guest_base ||
+        !mem_fast_forms_ok() || g_align_guard || g_no_ldapr || align_test_all() ||
+        ocerz_tcache_mode() != OCERZ_TC_OFF || !ENV_ON("OCERZ_M32_EBP_HOIST") || lowhoist_marked(jit_key(rip, 1)))
+        return 0;
+    const X86Insn *last = &insns[n - 1];
+    const int self_loop = (last->op == OCERZ_OP_JMP || last->op == OCERZ_OP_JCC) &&
+                          last->ops[0].kind == OCERZ_OPK_IMM && last->ops[0].imm == rip;
+    int count = 0, stop = 0;
+    for (; stop < n; ++stop) {
+        const X86Insn *insn = &insns[stop];
+        if (is_terminator(insn->op) || insn_may_write_gpr(insn, OCERZ_RBP) || !m32_inline_ok(insn))
+            break;
+        int supported_form = insn->op == OCERZ_OP_MOV;
+        for (int q = 0; q < insn->nops && !supported_form; ++q)
+            supported_form = insn->ops[q].kind == OCERZ_OPK_XMM;
+        if (supported_form)
+            for (int q = 0; q < insn->nops; ++q)
+                count += m32_ebp_form(insn, &insn->ops[q]);
+    }
+    // A self-edge can skip the entry guard.
+    if (count < 6 || self_loop)
+        return 0;
+    if (ENV_ON("OCERZ_M32_EBP_HOIST_LOG"))
+        fprintf(stderr, "ocerz: i386 EBP hoist rip=%#llx accesses=%d prefix=%d\n",
+                (unsigned long long)rip, count, stop);
+    return stop;
+}
+
+static void emit_m32_ebp_guard(A64Buf *b)
+{
+    if (!g_m32_ebp_stop) return;
+
+    // Reject if the base is within 256 bytes of 0 or 4 GiB. The W subtraction
+    // wraps and the X addition exposes the out-of-range bit without using NZCV.
+    int base = pin_hreg(pin_slot(OCERZ_RBP));
+    a64_sub_imm(b, 0, JTT, base, 256);
+    a64_add_imm(b, 1, JTT, JTT, 512);
+    a64_lsr_imm(b, 1, JTT, JTT, 32);
+    g_llh_bail_cb[g_n_llh_bail_cb++] = a64_label(b);
+    a64_cbnz(b, 0, JTT, 0);
 }

