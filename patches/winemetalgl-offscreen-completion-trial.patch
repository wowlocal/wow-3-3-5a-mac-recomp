 namespace {
 
+uint64_t newCompletionStream() {
+    static std::atomic<uint64_t> next{1};
+    return next.fetch_add(1, std::memory_order_relaxed);
+}
+
+void recordCompletedRender(id<MTLCommandBuffer> finished, uint64_t recordingStream, uint64_t sequence,
+                           uint64_t draws, uint64_t dimensions) {
+    if (!draws || finished.status != MTLCommandBufferStatusCompleted || finished.GPUEndTime <= 0.0)
+        return;
+    static os_log_t completionTrace = []() -> os_log_t {
+        const char* enabled = std::getenv("OCERZ_WMGL_TRACE_COMPLETIONS");
+        return enabled && enabled[0] == '1' && !enabled[1] ?
+            os_log_create("org.local.wrath-trial", OS_LOG_CATEGORY_POINTS_OF_INTEREST) : nullptr;
+    }();
+    // Keep the log for the lifetime of the process and refuse to overwrite a previous run.
+    static FILE* completionFile = []() -> FILE* {
+        const char* path = std::getenv("OCERZ_WMGL_GPU_LOG");
+        if (!path || !*path) return nullptr;
+        FILE* file = std::fopen(path, "wx");
+        if (!file) std::perror("cannot create WineMetalGL completion log");
+        return file;
+    }();
+    const uint64_t end = uint64_t(finished.GPUEndTime * 1e9);
+    if (completionTrace) {
+        os_signpost_event_emit(completionTrace, OS_SIGNPOST_ID_EXCLUSIVE, "WMGL Rendered Output",
+            "sequence=%{public}llu gpu_end_ns=%{public}llu draws=%{public}llu dimensions=%{public}llu",
+            (unsigned long long)sequence, (unsigned long long)end,
+            (unsigned long long)draws, (unsigned long long)dimensions);
+    }
+    if (completionFile) {
+        static const pid_t process = getpid();
+        std::fprintf(completionFile, "%d %llu %llu %llu %llu %llu\n", process,
+            (unsigned long long)recordingStream, (unsigned long long)sequence,
+            (unsigned long long)end, (unsigned long long)draws, (unsigned long long)dimensions);
+    }
+}
+
