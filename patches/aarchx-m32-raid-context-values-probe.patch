+enum { RAID_PREP_BITS = 22, RAID_PREP_STRIDE = 128 };
+
+/* Register holding the live context at each original instruction. */
+static int raid_context_reg(uint64_t pc)
+{
+    switch (pc) {
+    case 0x97d31d: case 0x97d3b3:
+        return OCERZ_RAX;
+    case 0x97d382:
+        return OCERZ_RCX;
+    case 0x97d38d: case 0x97d3fe:
+        return OCERZ_RDX;
+    case 0x979190: case 0x9791ad: case 0x97b9d7: case 0x97cb1c:
+        return OCERZ_RDI;
+    default:
+        return -1;
+    }
+}

