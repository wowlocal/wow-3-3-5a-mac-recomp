 namespace wmgl {

 namespace {
+
+struct OffscreenCaptureRequest {
+    const char* trigger = std::getenv("OCERZ_WMGL_CAPTURE_REQUEST");
+    const char* path = std::getenv("OCERZ_WMGL_CAPTURE_PATH");
+    const unsigned long long minimumDraws = [] {
+        const char* value = std::getenv("OCERZ_WMGL_CAPTURE_MIN_DRAWS");
+        return value ? std::strtoull(value, nullptr, 10) : 1ull;
+    }();
+    std::mutex mutex;
+    const Surface* owner = nullptr;
+    bool attempted = false;
+};
+
+OffscreenCaptureRequest& offscreenCaptureRequest() {
+    static OffscreenCaptureRequest capture;
+    return capture;
+}
+
+void stopOffscreenCapture(const Surface* surface, uint64_t sequence, uint64_t draws) {
+    auto& capture = offscreenCaptureRequest();
+    if (!capture.trigger || !capture.path) return;
+    std::lock_guard<std::mutex> lock(capture.mutex);
+    if (capture.owner != surface) return;
+    [[MTLCaptureManager sharedCaptureManager] stopCapture];
+    capture.owner = nullptr;
+    if (sequence) {
+        std::fprintf(stderr, "WMGL_CAPTURE end sequence=%llu draws=%llu\n",
+                     (unsigned long long)sequence, (unsigned long long)draws);
+    } else {
+        std::fputs("WMGL_CAPTURE cancelled before the next swap\n", stderr);
+    }
+}
+
+void startOffscreenCapture(const Surface* surface, uint64_t recordingStream,
+                           uint64_t sequence, uint64_t draws) {
+    auto& capture = offscreenCaptureRequest();
+    if (!capture.trigger || !capture.path || !draws || draws < capture.minimumDraws) return;
+    std::lock_guard<std::mutex> lock(capture.mutex);
+    if (capture.attempted || ::access(capture.trigger, F_OK) != 0) return;
+    capture.attempted = true;
+
+    struct stat status;
+    if (::lstat(capture.path, &status) == 0 || errno != ENOENT) {
+        std::fputs("WMGL_CAPTURE output already exists or is inaccessible\n", stderr);
+        return;
+    }
+    MTLCaptureManager* manager = [MTLCaptureManager sharedCaptureManager];
+    if (manager.isCapturing || ![manager supportsDestination:MTLCaptureDestinationGPUTraceDocument]) {
+        std::fputs("WMGL_CAPTURE GPU trace destination unavailable\n", stderr);
+        return;
+    }
+    MTLCaptureDescriptor* descriptor = [MTLCaptureDescriptor new];
+    descriptor.captureObject = Device::get().mtl();
+    descriptor.destination = MTLCaptureDestinationGPUTraceDocument;
+    descriptor.outputURL = [NSURL fileURLWithFileSystemRepresentation:capture.path
+                                                          isDirectory:NO relativeToURL:nil];
+    NSError* error = nil;
+    if (!descriptor.outputURL || ![manager startCaptureWithDescriptor:descriptor error:&error]) {
+        const char* reason = error.localizedDescription.UTF8String;
+        std::fprintf(stderr, "WMGL_CAPTURE failed %s\n", reason ? reason : "invalid output path");
+        return;
+    }
+    capture.owner = surface;
+    std::fprintf(stderr, "WMGL_CAPTURE begin stream=%llu after_sequence=%llu draws=%llu\n",
+                 (unsigned long long)recordingStream, (unsigned long long)sequence,
+                 (unsigned long long)draws);
+}

