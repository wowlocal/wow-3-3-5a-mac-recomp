+TEST(arb_env_versions_across_shared_contexts) {
+    gpu::Fixture first(64, 64, false);
+    CHECK(first.ok);
+    if (!first.ok) return;
+    loadArb();
+    identity();
+    const GLuint id = load(GL_FRAGMENT_PROGRAM_ARB, "!!ARBfp1.0\nMOV result.color, program.env[7];\nEND\n");
+    glEnable(GL_FRAGMENT_PROGRAM_ARB);
+    glProgramEnvParameter4fARB(GL_FRAGMENT_PROGRAM_ARB, 7, 1, 0, 0, 1);
+    quad(-1, 1);
+    CHECK(pixel(32, 32, kRed));
+
+    const int attributes[] = {0x2091, 3, 0x2092, 3, 0x9126, 2, 0};
+    int error = 0;
+    wmgl_context* second = wmgl_context_create(first.format, first.context, attributes, &error);
+    CHECK(second != nullptr);
+    if (!second) return;
+    const bool current = wmgl_make_current(second, first.surface, first.surface);
+    CHECK(current);
+    if (current) {
+        identity();
+        glViewport(0, 0, 64, 64);
+        glBindProgramARB(GL_FRAGMENT_PROGRAM_ARB, id);
+        glEnable(GL_FRAGMENT_PROGRAM_ARB);
+        quad(-1, 1);
+        const auto unset = gpu::readRGBA8(32, 32, 1, 1);
+        CHECK(unset.size() == 4 && unset[0] == 0 && unset[1] == 0 && unset[2] == 0);
+        const float green[4] = {0, 1, 0, 1};
+        glProgramEnvParameters4fvEXT(GL_FRAGMENT_PROGRAM_ARB, 7, 1, green);
+        quad(-1, 1);
+        CHECK(pixel(32, 32, kGreen));
+        CHECK_GL();
+
+        CHECK(wmgl_make_current(first.context, first.surface, first.surface));
+        quad(-1, 1);
+        CHECK(pixel(32, 32, kRed));
+        const double blue[4] = {0, 0, 1, 1};
+        glProgramEnvParameter4dvARB(GL_FRAGMENT_PROGRAM_ARB, 7, blue);
+        quad(-1, 1);
+        CHECK(pixel(32, 32, kBlue));
+        CHECK_GL();
+
+        CHECK(wmgl_make_current(second, first.surface, first.surface));
+        quad(-1, 1);
+        CHECK(pixel(32, 32, kGreen));
+        CHECK_GL();
+    }
+    CHECK(wmgl_make_current(first.context, first.surface, first.surface));
+    wmgl_context_destroy(second);
+    glDeleteProgramsARB(1, &id);
     CHECK_GL();
 }

