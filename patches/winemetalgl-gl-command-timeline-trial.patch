+
+struct TimelineState {
+    FILE* file = nullptr;
+    bool attempted = false;
+    bool nestedCall = false;
+    bool overflow = false;
+    unsigned depth = 0;
+    unsigned frames = 0;
+    uint64_t stream = 0;
+    std::vector<TimelineRow> rows;
+};
+
+thread_local TimelineState timeline;
+const char* const timelinePath = std::getenv("OCERZ_WMGL_GL_TIMELINE_PATH");
+const char* const timelineRequest = std::getenv("OCERZ_WMGL_GL_TIMELINE_REQUEST");
+constexpr unsigned timelineFrameLimit = 64;
+constexpr size_t timelineRowLimit = 1024 * 1024;
+
+void addTimelineRow(TimelineRow row) {
+    if (timeline.rows.size() < timelineRowLimit) timeline.rows.push_back(row);
+    else timeline.overflow = true;
+}
+
+}  // namespace
+
+bool glTimelineEnabled() {
+    return timelinePath && *timelinePath && timelineRequest && *timelineRequest;
+}
+
+TimelineCall::TimelineCall(const char* command, TimelineKind kind)
+    : command_(command), kind_(kind), start_(timeline.file ? nowNanos() : 0) {
+    if (!start_) return;
+    nested_ = timeline.depth++ != 0;
+    if (nested_) timeline.nestedCall = true;
+    else timeline.nestedCall = false;
+}
+
+TimelineCall::~TimelineCall() {
+    if (!start_) return;
+    --timeline.depth;
+    if (nested_) return;
+    const TimelineKind result = !context_ || timeline.nestedCall ? TimelineKind::Barrier : kind_;
+    const char* reason = timeline.nestedCall ? "nested" : reason_;
+    addTimelineRow({command_, context_, reason, start_, nowNanos(), 0, 0, result});
+}
+
+void TimelineCall::inspect(const Context& ctx) {
+    context_ = &ctx;
+    if (ctx.state.debugOutput || ctx.listCompiler || (ctx.immediate && ctx.immediate->active)) {
+        kind_ = TimelineKind::Barrier;
+        reason_ = "callback_or_recording";
+        return;
+    }
+    if (kind_ == TimelineKind::VertexPointer) {
+        kind_ = ctx.state.arrayBuffer ? TimelineKind::Scalar : TimelineKind::Barrier;
+        return;
+    }
+    if (kind_ != TimelineKind::ArrayDraw && kind_ != TimelineKind::IndexedDraw) return;
+    const VertexArray* array = ctx.state.vertexArray.get();
+    if (!array) {
+        kind_ = TimelineKind::Barrier;
+        reason_ = "missing_vertex_array";
+        return;
+    }
+    if (kind_ == TimelineKind::IndexedDraw) {
+        const Buffer* index = array->elementBuffer.get();
+        if (!index || index->mapped || index->pinned) {
+            kind_ = TimelineKind::Barrier;
+            reason_ = !index ? "client_indices" : index->mapped ? "mapped_indices" : "pinned_indices";
+            return;
+        }
+    }
+    for (const auto& attribute : array->attribs) {
+        if (!attribute.enabled) continue;
+        const Buffer* input = attribute.buffer.get();
+        if (!input || input->mapped || input->pinned) {
+            kind_ = TimelineKind::Barrier;
+            reason_ = !input ? "enabled_client_array" : input->mapped ? "mapped_array" : "pinned_array";
+            return;
+        }
+    }
+    kind_ = TimelineKind::BufferedDraw;
+}
+
+void timelineOffscreenSwap(uint64_t stream, uint64_t sequence, uint64_t draws, uint64_t entered) {
+    if (!entered || !draws || !stream) return;
+    if (!timeline.file) {
+        if (timeline.attempted || ::access(timelineRequest, F_OK) != 0) return;
+        timeline.attempted = true;
+        timeline.file = std::fopen(timelinePath, "wx");
+        if (!timeline.file) return;
+        timeline.stream = stream;
+        timeline.rows.reserve(timelineRowLimit);
+        std::fprintf(timeline.file, "H %llu %llu %llu\n", (unsigned long long)stream,
+                     (unsigned long long)sequence, (unsigned long long)nowNanos());
+        return;
+    }
+    if (timeline.stream != stream) return;
+    addTimelineRow({nullptr, nullptr, nullptr, entered, nowNanos(), sequence, draws, TimelineKind::Barrier});
+    if (++timeline.frames < timelineFrameLimit) return;
+    for (const auto& row : timeline.rows) {
+        if (row.command)
+            std::fprintf(timeline.file, "C %llu %llu %c %llx %s %s\n",
+                         (unsigned long long)row.start, (unsigned long long)row.end,
+                         static_cast<char>(row.kind),
+                         (unsigned long long)reinterpret_cast<uintptr_t>(row.context), row.command, row.reason);
+        else
+            std::fprintf(timeline.file, "S %llu %llu %llu %llu\n",
+                         (unsigned long long)row.sequence, (unsigned long long)row.start,
+                         (unsigned long long)row.end, (unsigned long long)row.draws);
+    }
+    std::fputs(timeline.overflow ? "X\n" : "F\n", timeline.file);
+    std::fclose(timeline.file);
+    timeline.file = nullptr;
+    timeline.rows.clear();
 }

