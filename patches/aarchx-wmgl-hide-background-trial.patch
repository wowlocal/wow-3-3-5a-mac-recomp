+static void hide_inactive_trial(void *unused)
+{
+    (void)unused;
+    NSApplication *app = [(id)objc_getClass("NSApplication") sharedApplication];
+    NSWorkspace *workspace = [(id)objc_getClass("NSWorkspace") sharedWorkspace];
+    NSRunningApplication *foreground = workspace.frontmostApplication;
+    if (app.hidden || !foreground || foreground.processIdentifier == getpid())
+        return;
+    for (size_t i = 0; i < sizeof contexts / sizeof contexts[0]; i++) {
+        if (contexts[i].carbon && contexts[i].overlay) {
+            // Hide the Carbon backing window along with the Metal image.
+            [app hide:nil];
+            return;
+        }
+    }
 }

