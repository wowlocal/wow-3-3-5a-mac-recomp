--- a/tests/diff32.c
+++ b/tests/diff32.c
@@ -3032,4 +3032,22 @@
 #define EFLAGS_MASK 0x0000000000000cd5ull

+static uint64_t fold_hand_state(uint64_t hash, const Snap *result)
+{
+    Snap canonical;
+    memcpy(&canonical, result, sizeof canonical);
+    canonical.steps = 0;
+    canonical.rflags &= EFLAGS_MASK;
+    for (int i = 0; i < 8; i++) {
+        if (!(canonical.fpr_x_ok & (1u << i))) {
+            canonical.fpr_xm[i] = 0;
+            canonical.fpr_xe[i] = 0;
+        }
+    }
+    const unsigned char *bytes = (const unsigned char *)&canonical;
+    for (size_t i = 0; i < sizeof canonical; i++)
+        hash = (hash ^ bytes[i]) * UINT64_C(1099511628211);
+    return hash;
+}
