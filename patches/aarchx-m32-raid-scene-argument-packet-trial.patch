+#include "ocerz/cpu.h"
+#include "ocerz/flags.h"
+#include "ocerz/interp.h"
+#include "ocerz/types.h"
+
+#include "ocerz/jit.h"
+#include "ocerz/mem.h"
+#include "ocerz/syscall.h"
+#include "ocerz/vm.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+enum {
+    CALL_SITE = 0x9806ae, CONTINUE_AT = 0x980620, CALLEE = 0x964ca0,
+    STACK_PAGE = 0x508000, STACK = 0x508960, DATA = 0x510000, DONE = CONTINUE_AT,
+    CS32 = 0xf, PRESERVED_FLAGS = 0x8d5,
+};
+
+static OcerzVM vm;
+
+static void write_code(uint32_t address, const uint8_t *data, size_t length)
+{
+    memcpy(ocerz_g2h(address), data, length);
+}
+
+static int check_case(const char *name, uint32_t before_sp, uint32_t base, int swap, int uses_packet)
+{
+    OcerzCPU *cpu = &vm.cpu;
+    ocerz_cpu_reset(cpu);
+    cpu->mode32 = 1;
+    cpu->seg_sel[OCERZ_SREG_CS] = cpu->cs_sel = CS32;
+    cpu->gpr[OCERZ_RSP] = before_sp;
+    cpu->gpr[OCERZ_RBP] = base;
+    cpu->gpr[OCERZ_RBX] = 0x67212700;
+    cpu->gpr[OCERZ_RSI] = 0x88320011;
+    cpu->gpr[OCERZ_RDI] = 0x12788244;
+    cpu->rflags = 0xa97;
+    cpu->rip = CALL_SITE;
+
+    memset(ocerz_g2h(STACK_PAGE), 0xe5, 0x4000);
+    memset(ocerz_g2h(DATA), 0xdc, 0x4000);
+    uint32_t a = base - 0xd8, b = base - 0x9c;
+    uint32_t vec_a[] = {0x80000000, 0x7fc02a19, 0x3d15e1c4};
+    uint32_t vec_b[] = {0xc0480000, 0x00000001, 0x7f800000};
+    uint32_t args[] = {DATA, 0x3faf8073, swap ? b : a, swap ? a : b, 0x7fffffff, 0xf016c4de};
+    memcpy(ocerz_g2h(a), vec_a, sizeof vec_a);
+    memcpy(ocerz_g2h(b), vec_b, sizeof vec_b);
+    memcpy(ocerz_g2h(before_sp), args, sizeof args);
+
+    for (unsigned step = 0; step < 64 && cpu->rip != DONE; ++step)
+        if (ocerz_jit_step(&vm, cpu) != OCERZ_STEP_OK)
+            break;
+    ocerz_flags_materialize(cpu);
+
+    const uint32_t *actual = ocerz_g2h(DATA);
+    uint32_t expected_sp = before_sp - (uses_packet ? 64 : 0);
+    uint32_t expected[] = {
+        args[1], args[4], args[5],
+        swap ? vec_b[0] : vec_a[0], swap ? vec_b[1] : vec_a[1], swap ? vec_b[2] : vec_a[2],
+        swap ? vec_a[0] : vec_b[0], swap ? vec_a[1] : vec_b[1], swap ? vec_a[2] : vec_b[2],
+        expected_sp, uses_packet ? expected_sp + 24 : args[2], uses_packet ? expected_sp + 36 : args[3],
+    };
+    if (cpu->rip != DONE || (uint32_t)cpu->gpr[OCERZ_RSP] != before_sp ||
+        (uint32_t)cpu->gpr[OCERZ_RBP] != base ||
+        (uint32_t)cpu->gpr[OCERZ_RBX] != 0x67212700 ||
+        (uint32_t)cpu->gpr[OCERZ_RSI] != 0x88320011 ||
+        (uint32_t)cpu->gpr[OCERZ_RDI] != 0x12788244 ||
+        (cpu->rflags & PRESERVED_FLAGS) != (0xa97 & PRESERVED_FLAGS) ||
+        cpu->raid_scene_args.original_sp ||
+        memcmp(actual, expected, sizeof expected) ||
+        memcmp(ocerz_g2h(before_sp), args, sizeof args) ||
+        memcmp(ocerz_g2h(a), vec_a, sizeof vec_a) ||
+        memcmp(ocerz_g2h(b), vec_b, sizeof vec_b)) {
+        fprintf(stderr, "FAIL %s eip=%#llx sp=%#llx flags=%#llx callee stack=%#x expected=%#x other=%#x\n",
+                name, (unsigned long long)cpu->rip, (unsigned long long)cpu->gpr[OCERZ_RSP],
+                (unsigned long long)cpu->rflags, actual[9], expected_sp, cpu->raid_scene_args.original_sp);
+        return 0;
+    }
+    printf("ok %s packet=%d\n", name, uses_packet);
+    return 1;
+}
+
+int main(void)
+{
+    if (ocerz_mem_init(0x10000, 0x900000000) != OCERZ_OK)
+        return 2;
+    const uint32_t pages[] = {0x980000, 0x964000, STACK_PAGE, DATA};
+    for (unsigned i = 0; i < sizeof pages / sizeof *pages; ++i)
+        if (ocerz_map_fixed(pages[i], 0x4000, PROT_READ | PROT_WRITE) != OCERZ_OK)
+            return 2;
+    ocerz_vm_init(&vm);
+    ocerz_vm_install_handlers(&vm);
+    if (!vm.jit)
+        return 2;
+    ocerz_ldt_install(CS32, 0, 0xfffff, 0xfb, 1, 0, 1);
+
+    static const uint8_t call[] = {0xe8,0xed,0x45,0xfe,0xff, 0xe9,0x68,0xff,0xff,0xff};
+    static const uint8_t end[] = {0xf4};
+    /* A cdecl callee copies all inputs to the result and exposes its stack
+     * and both actual pointers in three additional witness words. */
+    static const uint8_t callee[] = {
+        0x55, 0x89,0xe5, 0x57,                 /* push ebp, mov ebp,esp, push edi */
+        0x8b,0x7d,0x08,                       /* mov edi,[ebp+8] */
+        0x8b,0x45,0x0c, 0x89,0x07,            /* mov eax,[ebp+12], mov [edi],eax */
+        0x8b,0x45,0x18, 0x89,0x47,0x04,
+        0x8b,0x45,0x1c, 0x89,0x47,0x08,
+        0x8b,0x4d,0x10,                       /* vector input one */
+        0x8b,0x01, 0x89,0x47,0x0c,
+        0x8b,0x41,0x04, 0x89,0x47,0x10,
+        0x8b,0x41,0x08, 0x89,0x47,0x14,
+        0x8b,0x55,0x14,                       /* vector input two */
+        0x8b,0x02, 0x89,0x47,0x18,
+        0x8b,0x42,0x04, 0x89,0x47,0x1c,
+        0x8b,0x42,0x08, 0x89,0x47,0x20,
+        0x8d,0x45,0x08, 0x89,0x47,0x24,       /* original argument base as seen by the callee */
+        0x89,0x4f,0x28, 0x89,0x57,0x2c,
+        0x5f, 0xc9, 0xc3,                     /* pop edi, leave, ret */
+    };
+    write_code(CALL_SITE, call, sizeof call);
+    write_code(CONTINUE_AT, end, sizeof end);
+    write_code(CALLEE, callee, sizeof callee);
+    const char *mode = getenv("OCERZ_M32_SCENE_ARGS");
+    int candidate = mode && strcmp(mode, "1") == 0;
+    unsigned passes = 0;
+    passes += check_case("original-layout", STACK, STACK + 0x2d8, 0, candidate);
+    passes += check_case("unaligned-stack", STACK + 4, STACK + 4 + 0x2d8, 0, 0);
+    passes += check_case("mismatched-frame", STACK, STACK + 0x2dc, 0, 0);
+    passes += check_case("alternate-pointers", STACK, STACK + 0x2d8, 1, 0);
+    passes += check_case("low-stack-page", STACK_PAGE + 0x600, STACK_PAGE + 0x600 + 0x2d8, 0, 0);
+    passes += check_case("cross-page-vector", STACK_PAGE + 0xe00, STACK_PAGE + 0xe00 + 0x2d8, 0, 0);
+    printf("test_scene_args: %u checks, %u failed\n", passes, 6 - passes);
+    return passes == 6 ? 0 : 1;
+}
