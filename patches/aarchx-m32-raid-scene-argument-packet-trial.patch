+enum {
+    SCENE_PACKET_CALL = 0x9806ae, SCENE_PACKET_RETURN = 0x9806b3,
+    SCENE_PACKET_RESERVE = 64, SCENE_PACKET_FRAME = 0x2d8,
+    SCENE_PACKET_SCALE = 0x200, SCENE_PACKET_OFFSET = 0x23c,
+};
+
+enum {
+    SCENE_ARGS_ENTRY, SCENE_ARGS_PACKED, SCENE_ARGS_FALLBACK,
+    SCENE_ARGS_RETURNED, SCENE_ARGS_UNEXPECTED_SP, SCENE_ARGS_MISMATCH,
+    SCENE_ARGS_COUNTERS,
+};
+
+#define SCENE_ARGS_OFF(field) ((uint32_t)offsetof(OcerzCPU, raid_scene_args.field))
+_Static_assert(offsetof(OcerzCPU, raid_scene_args.frame) < 16384,
+               "scene arguments must fit the scaled A64 CPU offsets");
+
+static int scene_packet_site(uint64_t pc)
+{
+    return pc == SCENE_PACKET_CALL || pc == SCENE_PACKET_RETURN;
+}
+
+static pthread_once_t scene_args_once = PTHREAD_ONCE_INIT;
+static void *scene_args_log;
+
+static void init_scene_args_log(void)
+{
+    const char *path = getenv("OCERZ_M32_SCENE_ARGS_LOG");
+    if (!path || !*path) return;
+    int lse = 0;
+    size_t len = sizeof lse;
+    if (sysctlbyname("hw.optional.arm.FEAT_LSE", &lse, &len, NULL, 0) || !lse)
+        return;
+    int fd = open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) return;
+    const size_t size = SCENE_ARGS_COUNTERS * sizeof(uint64_t);
+    if (ftruncate(fd, (off_t)size) == 0) {
+        void *mapping = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (mapping != MAP_FAILED)
+            scene_args_log = mapping;
+    }
+    close(fd);
+}
+
+static void emit_scene_args_count(A64Buf *b, unsigned index)
+{
+    if (!scene_args_log) return;
+    a64_mov_imm64(b, JT0, (uint64_t)(uintptr_t)scene_args_log + 8 * index);
+    a64_movz(b, JT1, 1, 0);
+    a64_emit32(b, 0xf82a013fu); /* LDADD X10, XZR, [X9] */
+}
+
+static uint32_t *emit_scene_args_nonzero(A64Buf *b, int reg)
+{
+    uint32_t *branch = a64_label(b);
+    a64_cbnz(b, 0, reg, 0);
+    return branch;
+}
+
+static void emit_scene_args_enter(A64Buf *b)
+{
+    uint32_t *fail[7];
+    unsigned checks = 0;
+    emit_scene_args_count(b, SCENE_ARGS_ENTRY);
+    a64_ldr(b, 4, JTT, 20, SCENE_ARGS_OFF(original_sp));
+    fail[checks++] = emit_scene_args_nonzero(b, JTT);
+    emit_gpr_rd(b, 0, JT0, OCERZ_RSP);
+    emit_gpr_rd(b, 0, JT2, OCERZ_RBP);
+    a64_add_imm(b, 0, JT1, JT0, SCENE_PACKET_FRAME);
+    a64_eor_reg(b, 0, JT1, JT1, JT2, 0);
+    fail[checks++] = emit_scene_args_nonzero(b, JT1);
+    a64_ubfx(b, 0, JT1, JT0, 0, 4);
+    fail[checks++] = emit_scene_args_nonzero(b, JT1);
+
+    /* All inputs and the new packet occupy the same writable stack page.
+     * The lower half-page remains available for the original callee. */
+    a64_ubfx(b, 0, JT1, JT0, 0, 12);
+    a64_sub_imm(b, 0, JTT, JT1, 0x800);
+    a64_lsr_imm(b, 0, JTT, JTT, 31);
+    fail[checks++] = emit_scene_args_nonzero(b, JTT);
+    a64_add_imm(b, 0, JT1, JT1, SCENE_PACKET_OFFSET + 11);
+    a64_lsr_imm(b, 0, JT1, JT1, 12);
+    fail[checks++] = emit_scene_args_nonzero(b, JT1);
+    a64_add_ext_uxtw(b, JTA, JGB, JT0, 0);
+    for (int arg = 0; arg < 2; ++arg) {
+        a64_ldr(b, 4, JTT, JTA, 8 + 4 * arg);
+        a64_add_imm(b, 0, JT1, JT0, arg ? SCENE_PACKET_OFFSET : SCENE_PACKET_SCALE);
+        a64_eor_reg(b, 0, JT1, JT1, JTT, 0);
+        fail[checks++] = emit_scene_args_nonzero(b, JT1);
+    }
+
+    a64_sub_imm(b, 1, JTU, JTA, SCENE_PACKET_RESERVE);
+    for (int word = 0; word < 3; ++word) {
+        a64_ldr(b, 8, JTT, JTA, 8 * word);
+        a64_str(b, 8, JTT, JTU, 8 * word);
+    }
+    for (int word = 0; word < 3; ++word) {
+        a64_ldr(b, 4, JTT, JTA, SCENE_PACKET_SCALE + 4 * word);
+        a64_str(b, 4, JTT, JTU, 24 + 4 * word);
+        a64_ldr(b, 4, JTT, JTA, SCENE_PACKET_OFFSET + 4 * word);
+        a64_str(b, 4, JTT, JTU, 36 + 4 * word);
+    }
+    a64_str(b, 4, JT0, 20, SCENE_ARGS_OFF(original_sp));
+    a64_str(b, 4, JT2, 20, SCENE_ARGS_OFF(frame));
+    a64_sub_imm(b, 0, JT0, JT0, SCENE_PACKET_RESERVE);
+    a64_add_imm(b, 0, JTT, JT0, 24);
+    a64_str(b, 4, JTT, JTU, 8);
+    a64_add_imm(b, 0, JTT, JT0, 36);
+    a64_str(b, 4, JTT, JTU, 12);
+    emit_gpr_wr(b, JT0, OCERZ_RSP);
+    emit_scene_args_count(b, SCENE_ARGS_PACKED);
+    uint32_t *done = a64_label(b); a64_b(b, 0);
+    for (unsigned i = 0; i < checks; ++i)
+        a64_patch_cbz(fail[i], a64_label(b));
+    emit_scene_args_count(b, SCENE_ARGS_FALLBACK);
+    a64_patch_b(done, a64_label(b));
+}
+
+static void emit_scene_args_packet_check(A64Buf *b)
+{
+    /* JTA holds the original host address, JTU the copied host address.
+     * The two pointer arguments are the only intentional differences. */
+    uint32_t *fail[12];
+    unsigned checks = 0;
+    for (int word = 0; word < 6; ++word) {
+        if (word == 2 || word == 3) {
+            a64_add_imm(b, 0, JT1, JT2, word == 2 ? 24 : 36);
+        } else {
+            a64_ldr(b, 4, JT1, JTA, 4 * word);
+        }
+        a64_ldr(b, 4, JTT, JTU, 4 * word);
+        a64_eor_reg(b, 0, JTT, JTT, JT1, 0);
+        fail[checks++] = emit_scene_args_nonzero(b, JTT);
+    }
+    for (int word = 0; word < 6; ++word) {
+        a64_ldr(b, 4, JT1, JTA, word < 3 ? SCENE_PACKET_SCALE + 4 * word
+                                        : SCENE_PACKET_OFFSET + 4 * (word - 3));
+        a64_ldr(b, 4, JTT, JTU, 24 + 4 * word);
+        a64_eor_reg(b, 0, JTT, JTT, JT1, 0);
+        fail[checks++] = emit_scene_args_nonzero(b, JTT);
+    }
+    uint32_t *ok = a64_label(b); a64_b(b, 0);
+    for (unsigned i = 0; i < checks; ++i)
+        a64_patch_cbz(fail[i], a64_label(b));
+    emit_scene_args_count(b, SCENE_ARGS_MISMATCH);
+    a64_patch_b(ok, a64_label(b));
+}
+
+static void emit_scene_args_return(A64Buf *b)
+{
+    a64_ldr(b, 4, JT0, 20, SCENE_ARGS_OFF(original_sp));
+    uint32_t *idle = a64_label(b); a64_cbz(b, 0, JT0, 0);
+    a64_ldr(b, 4, JT1, 20, SCENE_ARGS_OFF(frame));
+    emit_gpr_rd(b, 0, JTT, OCERZ_RBP);
+    a64_eor_reg(b, 0, JTT, JTT, JT1, 0);
+    uint32_t *other_frame = emit_scene_args_nonzero(b, JTT);
+    a64_sub_imm(b, 0, JT2, JT0, SCENE_PACKET_RESERVE);
+    emit_gpr_rd(b, 0, JTT, OCERZ_RSP);
+    a64_eor_reg(b, 0, JTT, JTT, JT2, 0);
+    uint32_t *unexpected = emit_scene_args_nonzero(b, JTT);
+
+    if (scene_args_log) {
+        a64_add_ext_uxtw(b, JTA, JGB, JT0, 0);
+        a64_add_ext_uxtw(b, JTU, JGB, JT2, 0);
+        emit_scene_args_packet_check(b);
+        a64_ldr(b, 4, JT0, 20, SCENE_ARGS_OFF(original_sp));
+    }
+    emit_gpr_wr(b, JT0, OCERZ_RSP);
+    a64_str(b, 4, A64_ZR, 20, SCENE_ARGS_OFF(original_sp));
+    emit_scene_args_count(b, SCENE_ARGS_RETURNED);
+    uint32_t *done = a64_label(b); a64_b(b, 0);
+    a64_patch_cbz(unexpected, a64_label(b));
+    emit_scene_args_count(b, SCENE_ARGS_UNEXPECTED_SP);
+    a64_patch_b(done, a64_label(b));
+    a64_patch_cbz(other_frame, a64_label(b));
+    a64_patch_cbz(idle, a64_label(b));
+}
+
+static void emit_scene_packet(A64Buf *b, const X86Insn *insn)
+{
+    if (g_pin_class != 3 || !jgb_usable() || !ocerz_guest_base || g_lowptr)
+        return;
+    /* Recheck both original instruction encodings in the same guest page. */
+    static const unsigned char sites[] = {0xe8,0xed,0x45,0xfe,0xff,0xe9,0x68,0xff,0xff,0xff};
+    if (memcmp(ocerz_g2h(SCENE_PACKET_CALL), sites, sizeof sites))
+        return;
+    pthread_once(&scene_args_once, init_scene_args_log);
+    if (insn->rip == SCENE_PACKET_CALL)
+        emit_scene_args_enter(b);
+    else
+        emit_scene_args_return(b);
+}
