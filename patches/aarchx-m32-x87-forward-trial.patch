+static int test_fld_fist(const char *requested)
+{
+    static const uint32_t inputs[] = {
+        0x00000000, 0x80000000, 0x3f000000, 0xbf000000, 0x3fc00000, 0xbfc00000,
+        0x4effffff, 0xcf000000, 0x4f000000, 0x7f800000, 0x7fc12345,
+    };
+    const size_t size = sizeof inputs / sizeof inputs[0];
+    char *end;
+    unsigned long index = strtoul(requested, &end, 10);
+    if (!*requested || *end || index >= 4 * size) return 2;
+    unsigned rc = (unsigned)(index / size);
+    size_t i = index % size;
+    uint8_t code[] = {
+                0xc7, 0x03, 0, 0, 0, 0,        /* mov dword [ebx], input */
+                0xc7, 0x43, 0x04, 0, 0, 0, 0,  /* mov dword [ebx+4], control */
+                0xd9, 0x6b, 0x04,              /* fldcw [ebx+4] */
+                0xd9, 0xe8,                    /* fld1 */
+                0xd9, 0x03,                    /* fld dword [ebx] */
+                0xdb, 0x5b, 0x08,              /* fistp dword [ebx+8] */
+                0xdf, 0xe0,                    /* fnstsw ax */
+                0xdd, 0x5b, 0x10,              /* fstp qword [ebx+16] */
+                0xd9, 0x7b, 0x18,              /* fnstcw [ebx+24] */
+    };
+    uint32_t control = 0x037f | (rc << 10);
+    memcpy(code + 2, &inputs[i], sizeof inputs[i]);
+    memcpy(code + 9, &control, sizeof control);
+    char name[80];
+    snprintf(name, sizeof name, "x87 FLD/FISTP RC %u input %08x", rc, inputs[i]);
+    run_case(name, M32_CODE, M32_STACK, code, sizeof code);
+    return g_failures ? 1 : 0;
+}
+
