+static __thread struct {
+    unsigned depth, count, disabled;
+    struct { void *object; unsigned depth; uint64_t frame; } pools[32];
+    uint64_t frame;
+    uint64_t swaps, covered, opened, closed;
+} guestPools;
+
+static int borrow_guest_pools(void)
+{
+    static int enabled = -1;
+    if (!pthread_main_np()) return 0;
+    if (enabled < 0) {
+        const char *headless = getenv("OCERZ_M32_HEADLESS_TRIAL");
+        const char *batch = getenv("OCERZ_M32_HEADLESS_FRAME_BATCH");
+        enabled = headless && !strcmp(headless, "1") && batch && !strcmp(batch, "1");
+    }
+    return enabled && m32_wmgl_enabled() && driver.set_guest_pool_active;
+}
+
+static int current_guest_pool(void)
+{
+    return !guestPools.disabled && guestPools.count &&
+           guestPools.pools[guestPools.count - 1].frame == guestPools.frame;
+}
+
+static void publish_guest_pools(void)
+{
+    driver.set_guest_pool_active(current_guest_pool());
+}
+
+int m32_wmgl_guest_pool_enter(void)
+{
+    if (!borrow_guest_pools()) return 0;
+    ++guestPools.depth;
+    return 1;
+}
+
+void m32_wmgl_guest_pool_leave(void)
+{
+    while (guestPools.count && guestPools.pools[guestPools.count - 1].depth == guestPools.depth)
+        --guestPools.count;
+    --guestPools.depth;
+    publish_guest_pools();
+}
+
+int m32_wmgl_guest_pool_before(void *self, const char *selector)
+{
+    if (!borrow_guest_pools() || guestPools.disabled) return 0;
+    if (!strcmp(selector, "release") || !strcmp(selector, "drain") || !strcmp(selector, "dealloc")) {
+        for (unsigned i = guestPools.count; i > 0; --i) {
+            if (guestPools.pools[i - 1].object != self) continue;
+            guestPools.count = i - 1;
+            ++guestPools.closed;
+            publish_guest_pools();
+            break;
+        }
+        return 0;
+    }
+    if (strcmp(selector, "init") && strcmp(selector, "new")) return 0;
+    const Class pool = objc_getClass("NSAutoreleasePool");
+    if (!pool) return 0;
+    return !strcmp(selector, "new") ? self == pool : object_getClass(self) == pool;
+}
+
+void m32_wmgl_guest_pool_open(void *pool)
+{
+    if (!pool || guestPools.disabled) return;
+    if (guestPools.count == sizeof(guestPools.pools) / sizeof(guestPools.pools[0])) {
+        guestPools.disabled = 1;
+        publish_guest_pools();
+        return;
+    }
+    for (unsigned i = 0; i < guestPools.count; ++i) {
+        if (guestPools.pools[i].object == pool) {
+            guestPools.disabled = 1;
+            publish_guest_pools();
+            return;
+        }
+    }
+    guestPools.pools[guestPools.count].object = pool;
+    guestPools.pools[guestPools.count].depth = guestPools.depth;
+    guestPools.pools[guestPools.count++].frame = guestPools.frame;
+    ++guestPools.opened;
+    publish_guest_pools();
+}
