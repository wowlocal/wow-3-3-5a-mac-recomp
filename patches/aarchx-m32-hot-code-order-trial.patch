+static void m32_pretranslate_hot_order(OcerzJit *jit, uint64_t rip)
+{
+    enum { HOT_ORDER_LIMIT = 1024 };
+    static int state;
+    static uint64_t text_lo, text_hi;
+    static uint32_t entries[HOT_ORDER_LIMIT];
+    static size_t count;
+    if (state < 0)
+        return;
+    if (!state) {
+        state = -1;
+        const char *path = getenv("OCERZ_M32_HOT_ORDER");
+        if (!path || !*path || ocerz_tcache_mode() != OCERZ_TC_OFF)
+            return;
+        FILE *file = fopen(path, "r");
+        if (!file) {
+            perror("ocerz: opening i386 hot code order");
+            return;
+        }
+        unsigned long long lo, hi, entry;
+        int valid = fscanf(file, "%llx %llx", &lo, &hi) == 2 &&
+                    lo && lo < hi && hi <= (1ull << 32);
+        while (valid && fscanf(file, "%llx", &entry) == 1) {
+            valid = entry >= lo && entry < hi && count < HOT_ORDER_LIMIT;
+            if (valid)
+                entries[count++] = (uint32_t)entry;
+        }
+        valid = valid && feof(file) && !ferror(file);
+        fclose(file);
+        if (!valid || !count) {
+            fprintf(stderr, "ocerz: invalid i386 hot code order\n");
+            return;
+        }
+        text_lo = lo;
+        text_hi = hi;
+        state = 1;
+    }
+    if (rip < text_lo || rip >= text_hi)
+        return;
+    state = -1;
+    const uint64_t started = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    const uint32_t *first_word = jit->code_cur;
+    size_t compiled = 0, present = 0;
+    g_plain_mem = jit_plain_now(jit);
+    // Match the compiler's generic entry setup for code with no executing guest state.
+    g_xlat_cpu = NULL;
+    g_xlat_ftop = -1;
+    for (size_t i = 0; i < count && !jit->code_full && !jit_space_low(jit); ++i) {
+        uint64_t entry = entries[i];
+        const int prot = ocerz_addr_prot(entry);
+        if (prot < 0 || (prot & (PROT_READ | PROT_EXEC)) != (PROT_READ | PROT_EXEC))
+            continue;
+        if (cache_lookup(jit, entry, 1)) {
+            ++present;
+            continue;
+        }
+        JitBlock *block = translate(jit, entry, 1);
+        if (block && block->code)
+            ++compiled;
+    }
+    fprintf(stderr, "ocerz: i386 hot code order seeds=%zu compiled=%zu present=%zu bytes=%zu ns=%llu\n",
+            count, compiled, present, (size_t)(jit->code_cur - first_word) * sizeof(*first_word),
+            (unsigned long long)(clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - started));
+}
