+static void math_leaf_call(const M32Leaf *leaf, OcerzCPU *cpu, uint32_t arg0, uint32_t arg1);
+static const M32Leaf direct_math_leaves[MATH_COUNT] = {
+    {"_sinf", math_leaf_call, 1, 0, M32_LEAF_ST0, 1, 1, 0, 1, M32_GL_NONE},
+    {"_cosf", math_leaf_call, 1, 0, M32_LEAF_ST0, 1, 1, 0, 1, M32_GL_NONE},
+    {"_floorf", math_leaf_call, 1, 0, M32_LEAF_ST0, 1, 1, 0, 1, M32_GL_NONE},
+    {"_atan2f", math_leaf_call, 2, 0, M32_LEAF_ST0, 1, 1, 0, 1, M32_GL_NONE},
+};
+
+const M32Leaf *m32_math_leaf_for(const M32Export *export)
+{
+    if (!math_leaf_enabled || !export->special)
+        return NULL;
+    static const M32Special original[MATH_COUNT] = { sp_fast_sinf, sp_fast_cosf, sp_fast_floorf, sp_fast_atan2f };
+    for (unsigned i = 0; i < MATH_COUNT; ++i)
+        if (export->special == original[i])
+            return &direct_math_leaves[i];
+    return NULL;
+}
+
+static void math_leaf_call(const M32Leaf *leaf, OcerzCPU *cpu, uint32_t arg0, uint32_t arg1)
+{
+    const enum MathCall op = (enum MathCall)(leaf - direct_math_leaves);
+    const uint64_t bits = arg0 | (op == MATH_ATAN2F ? (uint64_t)arg1 << 32 : 0);
+    uint64_t fpcr = ocerz_afp_host();
+    m32_load_errno();
+    m32_push_st0(cpu, calculate_math(op, bits));
+    ocerz_afp_restore(fpcr);
+}
+
