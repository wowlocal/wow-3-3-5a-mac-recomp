+static void test_math_leaf(void)
+{
+    static const char *const names[] = { "_sinf", "_cosf", "_floorf", "_atan2f" };
+    static const uint32_t cases[][2] = {
+        { 0, 0x80000000 }, { 0x80000000, 0 }, { 0x3f800000, 0xbf800000 },
+        { 0xc0880000, 0x40e80000 }, { 0x00800000, 0x7f7fffff },
+        { 1, 0x80000001 }, { 0x7f800000, 0xff800000 }, { 0x7fc00023, 0x7f800005 },
+    };
+    const size_t count = sizeof cases / sizeof cases[0];
+    const uint32_t output = DATA + 64, older_st0 = output + 8;
+    m32_active = 1;
+    m32_math_trial_init();
+    ocerz_vm_install_handlers(&g_vm);
+    uint32_t errno_address = call("___error", 0, NULL);
+    const char *mode = getenv("OCERZ_M32_DIRECT_MATH_LEAF");
+    const int direct = mode && strcmp(mode, "1") == 0;
+
+    for (size_t op = 0; op < sizeof names / sizeof names[0]; ++op) {
+        uint32_t trap = m32_export("/usr/lib/libSystem.B.dylib", names[op]);
+        const M32Leaf *binding = m32_leaf_for(trap);
+        check("expected math leaf binding", (binding && binding->ret == M32_LEAF_ST0) == direct);
+        for (size_t index = 0; index < count; ++index) {
+            uint8_t instructions[] = {
+                0xd9,0xe8,                     /* fld1 below the math result */
+                0x68, 0,0,0,0,                 /* push second argument */
+                0x68, 0,0,0,0,                 /* push first argument */
+                0xb8, 0,0,0,0, 0xff,0xd0,      /* mov eax, trap; call eax */
+                0x83,0xc4,0x08,                /* add esp, 8 */
+                0xdd,0x1d,0,0,0,0,             /* fstp qword [output] */
+                0xdd,0x1d,0,0,0,0, 0xc3,       /* fstp qword [older_st0]; ret */
+            };
+            memcpy(instructions + 3, &cases[index][1], 4);
+            memcpy(instructions + 8, &cases[index][0], 4);
+            memcpy(instructions + 13, &trap, 4);
+            memcpy(instructions + 24, &output, 4);
+            memcpy(instructions + 30, &older_st0, 4);
+            uint32_t entry = CODE + 64 * (uint32_t)(op * count + index);
+            memcpy(m32_h(entry), instructions, sizeof instructions);
+            uint64_t values[2];
+            for (int use_jit = 0; use_jit < 2; ++use_jit) {
+                g_vm.jit_enabled = use_jit;
+                cpu()->ftop = 0;
+                m32_wr(errno_address, EINVAL);
+                memset(m32_h(output), 0xa5, 2 * sizeof values[0]);
+                guest_call(entry, 0, NULL);
+                memcpy(&values[use_jit], m32_h(output), sizeof values[0]);
+                check("guest math preserves the saved guest errno", m32_rd(errno_address) == EINVAL);
+                uint64_t older;
+                memcpy(&older, m32_h(older_st0), sizeof older);
+                check("guest math preserves the older x87 stack entry", older == UINT64_C(0x3ff0000000000000));
+            }
+            check("interpreted and translated math result bytes agree",
+                  values[0] == values[1] && values[0] != UINT64_C(0xa5a5a5a5a5a5a5a5));
+        }
+    }
+    check("math fixture translated guest blocks", g_vm.jit && ocerz_jit_blocks(g_vm.jit) > 0);
+}
