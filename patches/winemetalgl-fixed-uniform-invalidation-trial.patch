+bool preciseUniformInvalidation() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("WINEMETALGL_FIXED_UNIFORM_INVALIDATION");
+        return value && !std::strcmp(value, "1");
+    }();
+    return enabled;
+}
+
+// Shader selectors still update FixedState. Only fields read by the uniform
+// packer require a new packed block.
+FixedState& fixedUniformState(Context& ctx) {
+    return preciseUniformInvalidation() ? ctx.state.fixed : fixedState(ctx);
+}
+
+template<typename T>
+void setPackedField(FixedState& state, T& field, T value) {
+    if (preciseUniformInvalidation() && std::memcmp(&field, &value, sizeof(value)) != 0)
+        ++state.version;
+    field = value;
+}
+
+template<size_t N>
+void setPackedFields(FixedState& state, float (&fields)[N], const float* values) {
+    if (preciseUniformInvalidation() && std::memcmp(fields, values, sizeof(fields)) != 0)
+        ++state.version;
+    std::copy_n(values, N, fields);
+}
