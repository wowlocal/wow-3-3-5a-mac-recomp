+/* Local diagnostic for the four bounding-box updates in one i386 client
+ * routine. Each row is published last by storing its one-based sequence. */
+enum { RAID_BOUNDS_BITS = 19, RAID_BOUNDS_STRIDE = 128 };
+
+static int raid_bounds_site(uint64_t rip)
+{
+    switch (rip) {
+    case 0x881709: case 0x8817f1: case 0x8818ec: case 0x8819cf:
+        return 1;
+    case 0x881755: case 0x88183d: case 0x881934: case 0x881a17:
+        return 2;
+    default:
+        return 0;
+    }
+}
+
+static const char *raid_bounds_path(void)
+{
+    static int checked;
+    static const char *path;
+    if (!checked) {
+        path = getenv("OCERZ_M32_RAID_BOUNDS_LOG");
+        checked = 1;
+    }
+    return path && *path ? path : NULL;
+}
+
+static void *raid_bounds_mapping(void)
+{
+    static int initialized;
+    static void *mapping;
+    if (initialized) return mapping;
+    initialized = 1;
+    int lse = 0;
+    size_t len = sizeof lse;
+    unsigned tick_hz;
+    __asm__ volatile("mrs %x0, cntfrq_el0" : "=r" (tick_hz));
+    if (tick_hz != 1000000000u ||
+        sysctlbyname("hw.optional.arm.FEAT_LSE", &lse, &len, NULL, 0) || !lse)
+        return NULL;
+    int fd = open(raid_bounds_path(), O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) return NULL;
+    const size_t bytes = RAID_BOUNDS_STRIDE * ((1u << RAID_BOUNDS_BITS) + 1u);
+    if (ftruncate(fd, (off_t)bytes) == 0) {
+        void *p = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (p != MAP_FAILED) mapping = p;
+    }
+    close(fd);
+    return mapping;
+}
+
+static void emit_raid_bounds(A64Buf *b, const X86Insn *insn, int site)
+{
+    if ((site == 1 && insn->op != OCERZ_OP_UCOMISS) ||
+        (site == 2 && insn->op != OCERZ_OP_MOV) ||
+        g_pin_class != 3 || !jgb_usable() || !ocerz_guest_base ||
+        !xmm_is_pinned(1) || !xmm_is_pinned(2) || !xmm_is_pinned(7))
+        return;
+    void *mapping = raid_bounds_mapping();
+    if (!mapping) return;
+
+    const int bounds = pin_hreg(pin_slot(OCERZ_RBX));
+    const int frame = pin_hreg(pin_slot(OCERZ_RBP));
+    a64_mov_imm64(b, JT0, (uint64_t)(uintptr_t)mapping);
+    a64_ldr(b, 8, JT1, JT0, 8);
+    uint32_t *disabled = a64_label(b); a64_cbz(b, 1, JT1, 0);
+    /* Avoid reading across a guest page boundary solely for the probe. */
+    a64_ubfx(b, 0, JT1, bounds, 0, 12);
+    a64_add_imm(b, 0, JT1, JT1, 23);
+    uint32_t *split_page = a64_label(b); a64_tbnz(b, JT1, 12, 0);
+    a64_movz(b, JT1, 1, 0);
+    /* LDADD X10, X11, [X9] reserves a unique slot without touching flags. */
+    a64_emit32(b, 0xf82a012bu);
+    a64_ubfx(b, 0, JTT, JT2, 0, RAID_BOUNDS_BITS);
+    a64_add_reg(b, 1, JT0, JT0, JTT, 7);
+    a64_add_imm(b, 1, JT0, JT0, RAID_BOUNDS_STRIDE);
+    a64_str(b, 8, A64_ZR, JT0, 0);
+    a64_emit32(b, 0xd53be04au); /* MRS X10, CNTVCT_EL0 */
+    a64_str(b, 8, JT1, JT0, 8);
+    a64_str(b, 8, 20, JT0, 16);
+    a64_mov_imm64(b, JT1, insn->rip);
+    a64_str(b, 4, JT1, JT0, 24);
+    a64_str(b, 4, bounds, JT0, 28);
+    a64_str(b, 4, frame, JT0, 32);
+    a64_str_v(b, 4, xmm_vreg(1), JT0, 36);
+    a64_str_v(b, 4, xmm_vreg(2), JT0, 40);
+    a64_str_v(b, 4, xmm_vreg(7), JT0, 44);
+    a64_mov_reg(b, 0, JTT, bounds);
+    a64_add_reg(b, 1, JTT, JGB, JTT, 0);
+    for (unsigned i = 0; i < 6; i++) {
+        a64_ldr(b, 4, JT1, JTT, 4 * i);
+        a64_str(b, 4, JT1, JT0, 48 + 4 * i);
+    }
+    a64_add_imm(b, 1, JT2, JT2, 1);
+    a64_stlr(b, 8, JT2, JT0);
+    a64_patch_tbz(split_page, a64_label(b));
+    a64_patch_cbz(disabled, a64_label(b));
+}
