+static unsigned emit_m32_bridge_xmms(A64Buf *b, int store)
+{
+    unsigned pairs = 0;
+    for (unsigned r = 0; r < 8; ++r) {
+        if (!xmm_is_pinned(r)) continue;
+        const unsigned off = XMM_BASE_OFF + r * 16;
+        const int first = xmm_vreg(r);
+        if (ENV_ON("OCERZ_M32_BRIDGE_XMM_PAIRS") && r + 1 < 8 && xmm_is_pinned(r + 1) && off <= 1008) {
+            const int second = xmm_vreg(++r);
+            if (store) a64_stp_q_off(b, first, second, 20, (int)off);
+            else a64_ldp_q_off(b, first, second, 20, (int)off);
+            ++pairs;
+        } else if (store) {
+            a64_str_v(b, 16, first, 20, off);
+        } else {
+            a64_ldr_v(b, 16, first, 20, off);
+        }
+    }
+    return pairs;
+}
