+static int bridge_xmm_arguments_seen;
+
+static uint64_t bridge_xmm_mock(uint64_t a, uint64_t b, uint64_t c, uint64_t d,
+                                uint64_t unused0, uint64_t unused1, uint64_t unused2)
+{
+    (void)unused0; (void)unused1; (void)unused2;
+    bridge_xmm_arguments_seen = (a == 1 && b == 2 && c == 3 && d == 4);
+    __asm__ volatile(
+        "movi v16.16b, #0xaa\n"
+        "movi v17.16b, #0xaa\n"
+        "movi v18.16b, #0xaa\n"
+        "movi v19.16b, #0xaa\n"
+        "movi v20.16b, #0xaa\n"
+        "movi v21.16b, #0xaa\n"
+        "movi v22.16b, #0xaa\n"
+        "movi v23.16b, #0xaa\n"
+        ::: "v16", "v17", "v18", "v19", "v20", "v21", "v22", "v23");
+    return 0;
+}
+
+static void test_bridge_xmm(void)
+{
+    const uint32_t trap = m32_export_hostfn((void *)bridge_xmm_mock, "v(uuuu)", "v(uuuu)");
+    M32Export* exported = m32_export_by_id(trap - OCERZ_DYLDAPI_LO);
+    check("a native probe has a guest call address", exported != NULL);
+    if (!exported) return;
+    free(exported->name);
+    exported->name = strdup("_glXmmBridgeProbe");
+    const M32Leaf* leaf = m32_leaf_for(trap);
+    check("the probe uses an i386 SIMD-preserving GL leaf", leaf && leaf->simd && leaf->nargs == 4);
+    if (!leaf || !leaf->simd) return;
+
+    const uint32_t start = CODE, source = DATA + 0x7000, target = source + 0x80;
+    uint8_t code[8 * 7 + 8 + 5 + 3 + 8 * 7 + 3];
+    size_t n = 0;
+    for (int r = 0; r < 8; ++r) {
+        code[n++] = 0x0f; code[n++] = 0x10; /* movups xmmN, [abs32] */
+        code[n++] = 0x05 | (r << 3);
+        uint32_t at = source + (uint32_t)r * 16;
+        memcpy(code + n, &at, 4);
+        n += 4;
+    }
+    for (int a = 4; a > 0; --a) {
+        code[n++] = 0x6a; code[n++] = (uint8_t)a;  /* push four cdecl arguments */
+    }
+    code[n++] = 0xe8;
+    const uint32_t displacement = trap - (start + (uint32_t)n + 4);
+    memcpy(code + n, &displacement, 4);
+    n += 4;
+    code[n++] = 0x83; code[n++] = 0xc4; code[n++] = 16;  /* add esp, 16 */
+    for (int r = 0; r < 8; ++r) {
+        code[n++] = 0x0f; code[n++] = 0x11; /* movups [abs32], xmmN */
+        code[n++] = 0x05 | (r << 3);
+        uint32_t at = target + (uint32_t)r * 16;
+        memcpy(code + n, &at, 4);
+        n += 4;
+    }
+    code[n++] = 0x31; code[n++] = 0xc0; code[n++] = 0xc3; /* xor eax, eax; ret */
+    for (int i = 0; i < 128; ++i) ((uint8_t *)m32_h(source))[i] = (uint8_t)(i * 73 + 9);
+    memset(m32_h(target), 0, 128);
+    memcpy(m32_h(start), code, n);
+    ocerz_vm_install_handlers(&g_vm);
+    m32_active = 1;
+    g_vm.jit_enabled = 1;
+    cpu()->gpr[OCERZ_RSP] = STACK;
+    check("the leaf call returns through the translated guest caller", m32_call(&g_vm, start, NULL, 0, NULL, NULL) == 0);
+    check("the native probe received all four arguments", bridge_xmm_arguments_seen);
+    check("all 128 bytes of xmm0 through xmm7 survive the native call", !memcmp(m32_h(source), m32_h(target), 128));
+    m32_active = 0;
+}
