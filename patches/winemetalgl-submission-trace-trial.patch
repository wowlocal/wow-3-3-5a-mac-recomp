+FILE* submissionLog() {
+    static FILE* log = []() -> FILE* {
+        const char* path = std::getenv("OCERZ_WMGL_SUBMISSION_LOG");
+        if (!path || !*path) return nullptr;
+        FILE* file = std::fopen(path, "wx");
+        if (!file) std::perror("cannot create WineMetalGL submission log");
+        return file;
+    }();
+    return log;
+}
+
+void traceSubmission(FILE* log, id<MTLCommandBuffer> buffer, const char* kind,
+                     uint64_t stream, uint64_t serial, uint32_t draws) {
+    const uint64_t submitted = stats::nowNanos();
+    [buffer addCompletedHandler:^(id<MTLCommandBuffer> finished) {
+        const uint64_t callback = stats::nowNanos();
+        if (finished.status != MTLCommandBufferStatusCompleted || finished.GPUStartTime <= 0.0)
+            return;
+        std::fprintf(log, "%d %s %llu %llu %u %llu %llu %llu %llu %llu %llu\n", getpid(), kind,
+                     (unsigned long long)stream, (unsigned long long)serial, draws,
+                     (unsigned long long)submitted, (unsigned long long)(finished.GPUStartTime * 1e9),
+                     (unsigned long long)(finished.GPUEndTime * 1e9),
+                     (unsigned long long)(finished.kernelStartTime * 1e9),
+                     (unsigned long long)(finished.kernelEndTime * 1e9), (unsigned long long)callback);
+    }];
+}
 }  // namespace
 
+void CommandStream::tracePresentationSubmission(id<MTLCommandBuffer> buffer, uint64_t mailbox, uint64_t sequence) {
+    if (FILE* log = submissionLog()) traceSubmission(log, buffer, "present", mailbox, sequence, 0);
+}
