 inline void count(uint64_t Frame::*field, uint64_t n = 1) {
     if (__builtin_expect(g_enabled, 0)) frame().*field += n;
+    if (field == &Frame::draws && __builtin_expect(g_recordMailboxDraws, 0)) mailboxDraws += n;
 }
 
