@@ -48,6 +48,18 @@ os_log_t signpostLog() {
 
 const bool g_reporting = enabledFromEnvironment();
 bool g_enabled = g_reporting;
+const bool g_recordMailboxDraws = [] {
+    const char* signposts = std::getenv("OCERZ_WMGL_TRACE_COMPLETIONS");
+    const char* path = std::getenv("OCERZ_WMGL_GPU_LOG");
+    return (signposts && signposts[0] == '1' && !signposts[1]) || (path && *path);
+}();
+thread_local uint64_t mailboxDraws = 0;
+
+uint64_t takeMailboxDraws() {
+    const uint64_t count = mailboxDraws;
+    mailboxDraws = 0;
+    return count;
+}
 std::atomic<uint64_t> g_pipelinesPredicted{0}, g_pipelinesArchived{0}, g_predictNanos{0};
 
 Frame& frame() { return thread().frame; }
