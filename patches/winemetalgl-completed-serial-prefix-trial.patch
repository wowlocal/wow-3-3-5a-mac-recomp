+TEST(gpu_completed_serial_prefix_stops_at_reserved_draw) {
+    gpu::Fixture fixture(64, 64, false);
+    CHECK(fixture.ok);
+    if (!fixture.ok) return;
+    loadArb();
+    identity();
+    const GLfloat vertices[] = {-1, -1, 1, -1, 0, 1};
+    GLuint first = 0;
+    glGenBuffers(1, &first);
+    glBindBuffer(GL_ARRAY_BUFFER, first);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
+    glVertexPointer(2, GL_FLOAT, 0, nullptr);
+    glEnableClientState(GL_VERTEX_ARRAY);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    CHECK_EQ(glTestObjectAPPLE(GL_BUFFER_OBJECT_APPLE, first), GL_FALSE);
+
+    const int attrs[] = {0x2091, 3, 0x2092, 3, 0x9126, 2, 0};
+    int error = 0;
+    wmgl_context* other = wmgl_context_create(fixture.format, fixture.context, attrs, &error);
+    wmgl_surface* surface = wmgl_surface_create_pbuffer(fixture.format, 64, 64);
+    CHECK(other != nullptr && surface != nullptr);
+    if (other && surface) {
+        GLboolean earlier = GL_TRUE, later = GL_FALSE;
+        GLenum workerError = GL_NO_ERROR;
+        bool current = false;
+        std::thread worker([&] {
+            current = wmgl_make_current(other, surface, surface);
+            if (!current) return;
+            GLuint second = 0;
+            glGenBuffers(1, &second);
+            glBindBuffer(GL_ARRAY_BUFFER, second);
+            glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
+            glVertexPointer(2, GL_FLOAT, 0, nullptr);
+            glEnableClientState(GL_VERTEX_ARRAY);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            glFinish();
+            earlier = glTestObjectAPPLE(GL_BUFFER_OBJECT_APPLE, first);
+            later = glTestObjectAPPLE(GL_BUFFER_OBJECT_APPLE, second);
+            glDeleteBuffers(1, &second);
+            workerError = glGetError();
+            wmgl_make_current(nullptr, nullptr, nullptr);
+        });
+        worker.join();
+        CHECK(current);
+        CHECK_EQ(workerError, static_cast<GLenum>(GL_NO_ERROR));
+        CHECK_EQ(earlier, GL_FALSE);
+        CHECK_EQ(later, GL_TRUE);
+    }
+    glFinish();
+    CHECK_EQ(glTestObjectAPPLE(GL_BUFFER_OBJECT_APPLE, first), GL_TRUE);
+    if (other) wmgl_context_destroy(other);
+    if (surface) wmgl_surface_destroy(surface);
+    glDeleteBuffers(1, &first);
+    CHECK_GL();
+}
