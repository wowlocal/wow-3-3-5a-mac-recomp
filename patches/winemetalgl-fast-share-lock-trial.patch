diff --git a/src/core/context.mm b/src/core/context.mm
--- a/src/core/context.mm
+++ b/src/core/context.mm
@@ -7,6 +7,7 @@
 #include <algorithm>
 #include <cstdio>
 #include <cstdlib>
+#include <cstring>

 #include "core/compat/display_list.h"
 #include "core/compat/immediate.h"
@@ -29,6 +30,25 @@

 }  // namespace

+const bool g_fastShareLock = [] {
+    const char* value = std::getenv("WINEMETALGL_FAST_SHARE_LOCK");
+    return value && !std::strcmp(value, "1");
+}();
+
+const unsigned g_fastShareLockLogInterval = [] {
+    const char* value = std::getenv("WINEMETALGL_FAST_SHARE_LOCK_LOG");
+    return value && *value ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : 0u;
+}();
+
+void recordShareLockEvent(ShareLockEvent event) {
+    static thread_local unsigned long long counts[3] = {}, events = 0;
+    ++counts[static_cast<unsigned>(event)];
+    if (++events % g_fastShareLockLogInterval == 0)
+        std::fprintf(stderr, "wmgl share lock native=%llu reentrant=%llu yielded=%llu\n",
+                     counts[0], counts[1], counts[2]);
+}
+
+thread_local ShareLock* ShareLock::top_ = nullptr;
 thread_local int ShareLock::depth = 0;
 thread_local int CallPool::depth = 0;

