@@ -65,3 +65,27 @@
     glDisable(GL_DEBUG_OUTPUT);
     CHECK_GL();
 }
+
+GPU_TEST(gpu_khr_debug_reentrant_query) {
+    struct Query {
+        GLint viewport[4] = {};
+        int calls = 0;
+    } query;
+    glEnable(GL_DEBUG_OUTPUT);
+    glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS);
+    glViewport(1, 2, 32, 33);
+    glDebugMessageCallback([](GLenum, GLenum, GLuint, GLenum, GLsizei, const GLchar*, const void* user) {
+        auto* state = static_cast<Query*>(const_cast<void*>(user));
+        glGetIntegerv(GL_VIEWPORT, state->viewport);
+        ++state->calls;
+    }, &query);
+    glEnable(0xFFFFFFFFu);
+    glDebugMessageCallback(nullptr, nullptr);
+    CHECK_EQ(glGetError(), static_cast<GLenum>(GL_INVALID_ENUM));
+    CHECK_EQ(query.calls, 1);
+    CHECK_EQ(query.viewport[0], 1);
+    CHECK_EQ(query.viewport[1], 2);
+    CHECK_EQ(query.viewport[2], 32);
+    CHECK_EQ(query.viewport[3], 33);
+    CHECK_GL();
+}
