+    RAID_SNAPSHOT_PAGES = 32, RAID_SNAPSHOT_MAX_PAGE = 16384,
+    RAID_BATCH_REQUESTS = 16, RAID_BATCH_QUEUED, RAID_BATCH_FINISHED, RAID_BATCH_INPUTS,
+    RAID_BATCH_USED, RAID_BATCH_FALLBACK, RAID_BATCH_PREFIX_MISMATCH, RAID_BATCH_BUSY,
+    RAID_BATCH_SNAPSHOT_NS, RAID_BATCH_WORKER_NS, RAID_BATCH_READS,
+    RAID_BATCH_VM_PAGES, RAID_BATCH_VM_FAILURES,
+};
