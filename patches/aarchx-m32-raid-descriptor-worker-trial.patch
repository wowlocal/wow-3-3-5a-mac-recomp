+static int raid_snapshot_word(uint64_t addr, uint32_t *value)
+{
+    if (addr < 4096 || addr > UINT32_MAX - 3 || (addr & 3))
+        return 0;
+    unsigned page_size = vm_page_size;
+    uint32_t base = (uint32_t)addr & ~(page_size - 1);
+    unsigned page_number = base / page_size;
+    unsigned index = (page_number ^ (page_number >> 5)) & (RAID_SNAPSHOT_PAGES - 1);
+    RaidSnapshotPage *page = &raid_snapshot[index];
+    if (!page->populated || page->page != base) {
+        mach_vm_size_t copied = 0;
+        page->page = base;
+        page->populated = 1;
+        page->valid = mach_vm_read_overwrite(mach_task_self(), (uintptr_t)ocerz_g2h(base), page_size,
+                                             (uintptr_t)page->bytes, &copied) == KERN_SUCCESS && copied == page_size;
+        raid_batch_count(page->valid ? RAID_BATCH_VM_PAGES : RAID_BATCH_VM_FAILURES, 1);
+    }
+    if (!page->valid) return 0;
+    memcpy(value, page->bytes + (uint32_t)addr - base, sizeof *value);
+    return 1;
+}
+
+static void raid_batch_prepare(OcerzCPU *cpu)
+{
+    cpu->raid_descriptor.worker_batch = 0;
+    raid_batch_count(RAID_BATCH_REQUESTS, 1);
+    if (!ocerz_guest_base || ocerz_low_base || !vm_page_size || vm_page_size > RAID_SNAPSHOT_MAX_PAGE ||
+        (vm_page_size & (vm_page_size - 1)))
+        return;
+    uintptr_t nobody = 0;
+    __atomic_compare_exchange_n(&raid_batch_owner, &nobody, (uintptr_t)cpu, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&raid_batch_owner, __ATOMIC_ACQUIRE) != (uintptr_t)cpu)
+        return;
+    pthread_once(&raid_batch_once, raid_batch_start_thread);
+    if (!raid_batch_initialized) return;
+    uint32_t state = __atomic_load_n(&raid_batch.state, __ATOMIC_ACQUIRE);
+    if (state == RAID_BATCH_READY || state == RAID_BATCH_PROCESSING) {
+        raid_batch_count(RAID_BATCH_BUSY, 1);
+        return;
+    }
+    uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    uint32_t frame = (uint32_t)cpu->gpr[OCERZ_RBP];
+    uint32_t context, table, indices, count;
+    for (unsigned i = 0; i < RAID_SNAPSHOT_PAGES; i++)
+        raid_snapshot[i].populated = 0;
+    if (!raid_snapshot_word((uint64_t)frame + 8, &context) || !context ||
+        !raid_snapshot_word((uint64_t)frame + 0x10, &table) || !table ||
+        !raid_snapshot_word((uint64_t)frame + 0x14, &indices) || !indices ||
+        !raid_snapshot_word((uint64_t)frame + 0x18, &count) || !count || count > RAID_BATCH_MAX_ITEMS)
+        return;
+
+    unsigned ready = 0;
+    for (uint32_t index = 0; index < count; index++) {
+        RaidBatchInput *slot = &raid_batch.inputs[index];
+        *slot = (RaidBatchInput){0};
+        uint32_t offset;
+        if (!raid_snapshot_word((uint64_t)indices + 4ull * index, &offset)) continue;
+        uint64_t item = (uint64_t)table + 68ull * offset;
+        if (!raid_snapshot_word(item, &slot->tag) || slot->tag > 4 ||
+            !raid_snapshot_word(item + 4, &slot->material) || !slot->material ||
+            !raid_snapshot_word((uint64_t)slot->material + 0x2c, &slot->material_word) ||
+            (slot->tag <= 2 && !raid_snapshot_word(item + 0x2c, &slot->object_word)))
+            continue;
+        slot->item = (uint32_t)item;
+        ready++;
+    }
+    if (!ready) return;
+    raid_batch.count = count;
+    cpu->raid_descriptor.worker_frame = frame;
+    cpu->raid_descriptor.worker_context = context;
+    cpu->raid_descriptor.worker_batch = (uintptr_t)&raid_batch;
+    raid_batch_count(RAID_BATCH_INPUTS, ready);
+    raid_batch_count(RAID_BATCH_QUEUED, 1);
+    raid_batch_count(RAID_BATCH_SNAPSHOT_NS, clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start);
+    __atomic_store_n(&raid_batch.state, RAID_BATCH_READY, __ATOMIC_RELEASE);
+    dispatch_semaphore_signal(raid_batch_semaphore);
 }

