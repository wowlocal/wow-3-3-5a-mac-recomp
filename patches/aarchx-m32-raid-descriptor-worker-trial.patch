+
+static int raid_batch_instruction(const X86Insn *insn)
+{
+    return insn->mode32 && insn->rip == RAID_BATCH_ENTRY && insn->op == OCERZ_OP_XOR &&
+           insn->nops == 2 && insn->ops[0].kind == OCERZ_OPK_REG && insn->ops[1].kind == OCERZ_OPK_REG &&
+           insn->ops[0].reg == OCERZ_RBX && insn->ops[1].reg == OCERZ_RBX &&
+           insn->ops[0].size == 4 && insn->ops[1].size == 4 && raid_batch_enabled();
+}
+
+static void raid_batch_count(unsigned slot, uint64_t quantity)
+{
+    uint64_t *counters = raid_desc_counters();
+    if (counters) __atomic_fetch_add(counters + slot, quantity, __ATOMIC_RELAXED);
+}
+
+static void *raid_batch_thread(void *opaque)
+{
+    RaidBatch *batch = opaque;
+    pthread_setname_np("raid-descriptor-builder");
+    for (;;) {
+        dispatch_semaphore_wait(raid_batch_semaphore, DISPATCH_TIME_FOREVER);
+        uint32_t state = RAID_BATCH_READY;
+        if (!__atomic_compare_exchange_n(&batch->state, &state, RAID_BATCH_PROCESSING, 0,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+            continue;
+        uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        for (uint32_t index = 0; index < batch->count; index++) {
+            const RaidBatchInput *input = &batch->inputs[index];
+            RaidBatchRow *output = &batch->rows[index];
+            output->item = input->item;
+            output->words[0] = input->tag;
+            output->words[1] = input->material;
+            output->words[2] = input->tag <= 2 ? input->object_word : 0;
+            output->words[3] = input->material_word;
+        }
+        raid_batch_count(RAID_BATCH_WORKER_NS, clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start);
+        raid_batch_count(RAID_BATCH_FINISHED, 1);
+        __atomic_store_n(&batch->state, RAID_BATCH_COMPLETE, __ATOMIC_RELEASE);
+    }
+    return NULL;
+}
+
+static void raid_batch_start_thread(void)
+{
+    raid_batch_semaphore = dispatch_semaphore_create(0);
+    if (!raid_batch_semaphore) return;
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, raid_batch_thread, &raid_batch) == 0) {
+        pthread_detach(thread);
+        raid_batch_initialized = 1;
+    } else {
+        dispatch_release(raid_batch_semaphore);
+    }
+}
