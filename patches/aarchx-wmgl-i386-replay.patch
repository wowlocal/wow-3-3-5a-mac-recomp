 static void bench_wmgl_draw_batch(const char *gl, unsigned target)
 {
     enum { WIDTH = 1365, HEIGHT = 768, SIZE = 2 * 1024 * 1024, STRIDE = 2048,
@@ -1140,6 +1145,19 @@ static void test_wmgl_storage(void)
     check("make the offscreen WineMetalGL context current",
           call("_aglSetCurrentContext", 1, (uint32_t[]){ ctx }) == 1);
 
