diff --git a/src/m32_wmgl.m b/src/m32_wmgl.m
index e2ce5ac..1cb9bcf 100644
--- a/src/m32_wmgl.m
+++ b/src/m32_wmgl.m
@@ -130,6 +130,16 @@ uint32_t m32_wmgl_guest_buffer(const void *host, size_t size)
 static Sidecar contexts[64];
 static __thread Sidecar *current;
 
+int m32_wmgl_resize_pbuffer(int width, int height)
+{
+    if (!current || current->layer || width <= 0 || height <= 0)
+        return 0;
+    driver.flush(current->surface, WMGL_FLUSH_UPDATED, width, height, 0);
+    current->width = width;
+    current->height = height;
+    return 1;
+}
+
 int m32_wmgl_array_buffer_binding(uint32_t *name)
 {
     return current && driver.array_buffer_binding && driver.array_buffer_binding(name);
