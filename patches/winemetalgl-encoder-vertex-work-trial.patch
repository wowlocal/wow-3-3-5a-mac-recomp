+bool CommandStream::vertexWorkProfileEnabled() {
+    return encoderWorkLog() != nullptr;
+}
+
+void CommandStream::noteVertexWork(uint64_t program, uint32_t instructions, uint32_t parameters,
+                                   uint64_t references) {
+    if (!render_ || encoderWork_.empty() || !references) return;
+    auto& programs = encoderWork_.back().programs;
+    for (auto& work : programs) {
+        if (work.program != program) continue;
+        ++work.draws;
+        work.references += references;
+        return;
+    }
+    programs.push_back({program, instructions, parameters, 1, references});
+}
