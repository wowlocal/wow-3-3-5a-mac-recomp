diff --git a/src/core/api/buffer.mm b/src/core/api/buffer.mm
index 29801e0..3b5d558 100644
--- a/src/core/api/buffer.mm
+++ b/src/core/api/buffer.mm
@@ -1,6 +1,7 @@
 // Buffer objects (GL 3.3 section 2.9).
 
 #include <algorithm>
+#include <cstdlib>
 #include <cstring>
 #include <mutex>
 #include <unistd.h>
@@ -496,7 +497,18 @@ void BufferSubData(Context& ctx, GLenum target, GLintptr offset, GLsizeiptr size
     if (buffer->rangeMapped(offset, size)) return ctx.setError(GL_INVALID_OPERATION);
     if (buffer->immutable && !(buffer->storageFlags & GL_DYNAMIC_STORAGE_BIT)) return ctx.setError(GL_INVALID_OPERATION);
     if (!size || !data || !buffer->mtl) return;
-    if (gpuBusy(ctx, *buffer)) {
+    static const bool tryAppleSubData = [] {
+        const char* value = std::getenv("OCERZ_WMGL_APPLE_SUBDATA");
+        return value && value[0] == '1' && !value[1];
+    }();
+    // The compatibility client's APPLE setting makes it responsible for
+    // synchronizing writes. Keep this trial on the measured vertex store
