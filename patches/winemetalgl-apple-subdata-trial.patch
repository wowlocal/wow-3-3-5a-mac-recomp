+        !buffer->appleSerializedModify && !buffer->immutable && !buffer->pinned &&
+        !buffer->mapped && !buffer->lastWriteSerial;
+    if (!applicationSynchronized && gpuBusy(ctx, *buffer)) {
         // Immutable storage keeps its memory (it may be persistently mapped),
         // and so does a mapped buffer.
         if (!buffer->immutable && !buffer->pinned && !buffer->mapped && (size == buffer->size || buffer->size <= (256 << 10))) {
@@ -514,7 +526,11 @@ void BufferSubData(Context& ctx, GLenum target, GLintptr offset, GLsizeiptr size
             return;
         }
     }
-    std::memcpy(static_cast<uint8_t*>(buffer->mtl.contents) + offset, data, static_cast<size_t>(size));
+    auto* destination = static_cast<uint8_t*>(buffer->mtl.contents) + offset;
+    if (applicationSynchronized)
+        std::memmove(destination, data, static_cast<size_t>(size));
+    else
+        std::memcpy(destination, data, static_cast<size_t>(size));
     buffer->shadowWrite(offset, size, data);
     ++buffer->version;
 }
