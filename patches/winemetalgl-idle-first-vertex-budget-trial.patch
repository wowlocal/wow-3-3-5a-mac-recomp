+uint64_t CommandStream::firstSubmissionVertexBudget() {
+    static const uint64_t budget = [] {
+        const char* value = std::getenv("WINEMETALGL_IDLE_FIRST_VERTICES");
+        return value && *value ? uint64_t(std::strtoull(value, nullptr, 10)) : uint64_t(0);
+    }();
+    return budget;
+}
+
+bool CommandStream::needsFirstSubmissionVertices() const {
+    static const bool enabled = firstSubmissionVertexBudget() || firstVertexLog();
+    return enabled && !frameHasDrawSubmission_;
+}
+
+void CommandStream::noteFirstSubmissionVertices(uint64_t references, uint64_t instances) {
+    uint64_t expanded;
+    if (__builtin_mul_overflow(references, instances, &expanded) ||
+        __builtin_add_overflow(firstSubmissionVertexReferences_, expanded, &firstSubmissionVertexReferences_))
+        firstSubmissionVertexReferences_ = UINT64_MAX;
+}
