+int ocerz_m32_raid_matrix(OcerzCPU *cpu, uint32_t dst, uint32_t left, uint32_t right, uint32_t frame, int log)
+{
+    if ((cpu->mxcsr & ~UINT32_C(63)) != UINT32_C(0x1f80) ||
+        ((dst | left | right | frame) & 3) || frame < 104)
+        return 0;
+    uint64_t fpcr;
+    __asm__ volatile("mrs %0, fpcr" : "=r" (fpcr));
+    if (fpcr != 0)
+        return 0;
+    const uint64_t scratch = frame - 104;
+    const uint64_t limit = (uint64_t)frame + 20;
+    const uint64_t args[3] = {dst, left, right};
+    for (unsigned i = 0; i < 3; i++)
+        if (args[i] < limit && args[i] + 64 > scratch)
+            return 0;
+
+    map_lock_acquire();
+    int use_native = 0;
+    if (raid_matrix_span(left, 64, PROT_READ) && raid_matrix_span(right, 64, PROT_READ) &&
+        raid_matrix_span(dst, 64, PROT_WRITE) && raid_matrix_span(scratch, 104, PROT_WRITE)) {
+        float l[16], r[16];
+        memcpy(l, ocerz_g2h(left), sizeof l);
+        memcpy(r, ocerz_g2h(right), sizeof r);
+        if (raid_matrix_input_ok(l) && raid_matrix_input_ok(r)) {
+            float out[16], xmm[8][4], locals[26];
+            _Static_assert(sizeof cpu->xmm[0] == 16, "Guest XMM layout changed");
+            raid_matrix_product(out, xmm, locals, l, r);
+            memcpy(ocerz_g2h(dst), out, sizeof out);
+            memcpy(ocerz_g2h(scratch), locals, sizeof locals);
+            memcpy(cpu->xmm, xmm, sizeof xmm);
+            use_native = 1;
+        }
+    }
+    map_lock_release();
+    if (use_native && log) {
+        static _Thread_local unsigned hits;
+        if (++hits == 1 || (hits & 32767) == 0)
+            fprintf(stderr, "ocerz: raid matrix native calls=%u\n", hits);
+    }
+    return use_native;
+}
