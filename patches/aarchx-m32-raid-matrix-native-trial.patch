+static int raid_matrix_body_matches(void)
+{
+    const uint64_t begin = 0x8c1e90, end = 0x8c23e2;
+    if (!ocerz_addr_readable(begin) || !ocerz_addr_readable(end - 1))
+        return 0;
+    const unsigned char *text = ocerz_g2h(begin);
+    uint64_t hash = UINT64_C(0xcbf29ce484222325);
+    for (uint64_t i = 0; i < end - begin; i++)
+        hash = (hash ^ text[i]) * UINT64_C(0x100000001b3);
+    return hash == UINT64_C(0x487bae2171fe1b67);
+}
