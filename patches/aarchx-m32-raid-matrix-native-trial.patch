+static void emit_raid_matrix_trial(A64Buf *b, uint32_t **epi_sites, int *n_epi)
+{
+    if (g_pin_class != 3 || !jgb_usable() || !ocerz_guest_base || ocerz_low_base ||
+        g_l0_fixed || !raid_matrix_body_matches())
+        return;
+    a64_mov_imm64(b, JTA, (uint64_t)(uintptr_t)&m32_sig_pending);
+    a64_ldr(b, 4, JT0, JTA, 0);
+    a64_ldr(b, 4, JT1, 20, INT_OFF);
+    a64_orr_reg(b, 0, JT0, JT0, JT1, 0);
+    uint32_t *pending = a64_label(b); a64_cbnz(b, 0, JT0, 0);
+    a64_emit32(b, 0xd53b4200u | JT1); /* MRS X10, NZCV */
+    a64_stp_pre(b, JT1, 30, 31, -16);
+    emit_m32_bridge_xmms(b, 1);
+    a64_mov_reg(b, 0, 1, pin_hreg(pin_slot(OCERZ_RAX)));
+    a64_mov_reg(b, 0, 2, pin_hreg(pin_slot(OCERZ_RCX)));
+    a64_mov_reg(b, 0, 3, pin_hreg(pin_slot(OCERZ_RDX)));
+    a64_mov_reg(b, 0, 4, pin_hreg(pin_slot(OCERZ_RBP)));
+    a64_movz(b, 5, ENV_ON("OCERZ_M32_RAID_MATRIX_WITNESS") != 0, 0);
+    a64_mov_reg(b, 1, 0, 20);
+    a64_mov_imm64(b, 16, (uint64_t)(uintptr_t)ocerz_m32_raid_matrix);
+    a64_blr(b, 16);
+    g_callout_seq++;
+    a64_mov_reg(b, 0, JT0, 0);
+    emit_m32_bridge_xmms(b, 0);
+    emit_pk_consts_load(b);
+    emit_reload_jgb(b);
+    emit_reload_mem_base(b);
+    yc_reload_all(b);
+    a64_ldp_post(b, JT1, 30, 31, 16);
+    a64_emit32(b, 0xd51b4200u | JT1); /* MSR NZCV, X10 */
+    uint32_t *declined = a64_label(b); a64_cbz(b, 0, JT0, 0);
+    a64_mov_imm64(b, JT1, 0x8c23de);
+    a64_str(b, 8, JT1, 20, RIP_OFF);
+    a64_mov_imm64(b, 0, OCERZ_STEP_OK);
+    epi_sites[(*n_epi)++] = a64_label(b);
+    a64_b(b, 0);
+    a64_patch_cbz(declined, a64_label(b));
+    a64_patch_cbz(pending, a64_label(b));
+}
