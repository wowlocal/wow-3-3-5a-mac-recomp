+/* Check both the guest slot and the containing host page while map_lock
+ * keeps mappings and executable-page protection stable. */
+static int raid_matrix_span(uint64_t first, uint64_t size, int access)
+{
+    const uint64_t last = first + size;
+    MemRegion *r = region_for_range(round_down(first), round_up(last));
+    if (!r || first < OCERZ_NULL_LIMIT || last > UINT64_C(0x100000000))
+        return 0;
+    for (uint64_t address = guest_round_down(first); address < last; address += OCERZ_GUEST_PAGE) {
+        const size_t page = pg_index(r, address);
+        const uint32_t state = slot_load(r, slot_index(r, address));
+        const int prot = (int)((state & MEM_SLOT_PROT_MASK) >> MEM_SLOT_PROT_SHIFT);
+        if (!slot_is_data(state) || (prot & access) != access || !bit_test(r, page))
+            return 0;
+        if ((access & PROT_WRITE) && ((prot & PROT_EXEC) || (r->armed && r->armed[page])))
+            return 0;
+    }
+    return 1;
+}
