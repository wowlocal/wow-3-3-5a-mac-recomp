+        // A compatible branch already paid for the guard. Shorter EBP
+        // prefixes can reuse it through their alternate entry.
+        if (count[OCERZ_RBP] < 2 || !has_pending_guarded_ebp(jit_key(rip, 1)))
+            return 0;
+        best = OCERZ_RBP;
