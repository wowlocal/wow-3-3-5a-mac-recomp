+static int has_pending_guarded_ebp(uint64_t key)
+{
+    if (!ENV_ON("OCERZ_M32_BASE_HANDOFF") || !ENV_ON("OCERZ_M32_SHORT_EBP_HANDOFF") ||
+        ENV_ON("OCERZ_NO_HOIST_HANDOFF"))
+        return 0;
+    const uint64_t signature = M32_HOIST_GUARDED | M32_HOIST_PRESERVED | ((uint64_t)OCERZ_RBP << 8);
+    unsigned bucket = (unsigned)(hash_key(key) & PEND_MASK);
+    for (const PendingChain *edge = g_pending[bucket]; edge; edge = edge->next) {
+        if (edge->target_key == key && edge->kind == EDGE_BODY &&
+            edge->pin_class == g_pin_class && edge->src_sig == signature)
+            return 1;
+    }
+    return 0;
+}
+
 static void pending_drain(uint64_t key, JitBlock *target)
 {
