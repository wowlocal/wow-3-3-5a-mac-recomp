+static int m32_ebp_guard_cache_enabled(void)
+{
+    // x29 is available in this pinned layout and saved by the host ABI.
+    return ocerz_guest_base && !ocerz_low_base &&
+           ocerz_tcache_mode() == OCERZ_TC_OFF && ENV_ON("OCERZ_M32_EBP_GUARD_CACHE");
+}
+
+static uint64_t *m32_ebp_guard_counters(void)
+{
+    static int initialized;
+    static uint64_t *counters;
+    if (!initialized) {
+        initialized = 1;
+        const char *path = getenv("OCERZ_M32_EBP_GUARD_CACHE_COUNTS");
+        if (!path || !*path)
+            return NULL;
+#if defined(__APPLE__) && defined(__aarch64__)
+        int supported = 0;
+        size_t size = sizeof supported;
+        if (sysctlbyname("hw.optional.arm.FEAT_LSE", &supported, &size, NULL, 0) != 0 || !supported)
+            return NULL;
+        int fd = open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+        if (fd < 0) {
+            perror("ocerz: opening EBP guard counters");
+            return NULL;
+        }
+        const size_t bytes = 2 * sizeof *counters;
+        if (ftruncate(fd, (off_t)bytes) == 0) {
+            void *memory = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+            if (memory != MAP_FAILED)
+                counters = memory;
+        }
+        if (!counters)
+            perror("ocerz: mapping EBP guard counters");
+        close(fd);
+#endif
+    }
+    return counters;
+}
+
+static void emit_m32_ebp_guard_count(A64Buf *b, int index)
+{
+    uint64_t *counters = m32_ebp_guard_counters();
+    if (!counters)
+        return;
+    a64_mov_imm64(b, JT1, (uintptr_t)&counters[index]);
+    a64_movz(b, JT0, 1, 0);
+    // stadd xJT0, [xJT1], the no-result form of relaxed 64-bit LDADD.
+    a64_emit32(b, 0xf820001fu | ((uint32_t)JT0 << 16) | ((uint32_t)JT1 << 5));
+}
+
+static void emit_m32_base_range_check(A64Buf *b)
+{
     // Reject if the base is within 256 bytes of 0 or 4 GiB. The W subtraction
     // wraps and the X addition exposes the out-of-range bit without using NZCV.
@@ -22144,4 +22196,32 @@
     g_llh_bail_cb[g_n_llh_bail_cb++] = a64_label(b);
     a64_cbnz(b, 0, JTT, 0);
+}
+
+static void emit_m32_base_guard(A64Buf *b)
+{
+    if (!g_m32_base_stop)
+        return;
+    if (g_mem_hoist_greg != OCERZ_RBP || !m32_ebp_guard_cache_enabled()) {
+        emit_m32_base_range_check(b);
+        return;
+    }
+    // Compare the full mapped address. This validates EBP even if an
+    // intervening block or a callback changed the guest register.
+    a64_eor_reg(b, 1, JTT, JMEMAUX, JMEMBASE, 0);
+    g_m32_ebp_cache_miss = a64_label(b);
+    a64_cbnz(b, 1, JTT, 0);
+    emit_m32_ebp_guard_count(b, 0);
+    g_m32_ebp_cache_resume = a64_label(b);
+}
+
+static void emit_m32_ebp_guard_miss(A64Buf *b)
+{
+    if (!g_m32_ebp_cache_miss)
+        return;
+    a64_patch_cbz(g_m32_ebp_cache_miss, a64_label(b));
+    emit_m32_ebp_guard_count(b, 1);
+    emit_m32_base_range_check(b);
+    a64_mov_reg(b, 1, JMEMAUX, JMEMBASE);
+    a64_b(b, (int32_t)(g_m32_ebp_cache_resume - a64_label(b)));
 }

