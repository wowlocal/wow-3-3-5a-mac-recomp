+
+COMPAT_TEST(compat_alpha_variant_keeps_color_depth_and_user_discard) {
+    GLuint program = gpu::program(R"(#version 120
+void main() { gl_Position = ftransform(); gl_FrontColor = gl_Color; })",
+                                  R"(#version 120
+uniform bool discardRed;
+void main() {
+    if (discardRed && gl_Color.r > 0.5) discard;
+    gl_FragColor = gl_Color;
+})");
+    glUseProgram(program);
+    const GLint discardRed = glGetUniformLocation(program, "discardRed");
+    CHECK(discardRed >= 0);
+    pixelProjection();
+    glClearDepth(1.0);
+    clear();
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    const auto rectangle = [](float left, float right, float z, bool red) {
+        glColor3f(red ? 1.0f : 0.0f, 0.0f, red ? 0.0f : 1.0f);
+        glBegin(GL_QUADS);
+        glVertex3f(left, 0, z);
+        glVertex3f(right, 0, z);
+        glVertex3f(right, 64, z);
+        glVertex3f(left, 64, z);
+        glEnd();
+    };
+    glDisable(GL_ALPHA_TEST);
+    rectangle(0, 20, 0.5f, true);  // this near fragment must write depth
+    glEnable(GL_ALPHA_TEST);
+    glAlphaFunc(GL_NEVER, 0.0f);
+    rectangle(20, 42, 0.5f, true);  // compatibility discard on the same program
+    glAlphaFunc(GL_ALWAYS, 0.0f);
+    rectangle(0, 64, -0.5f, false);  // passes the alpha test
+    glDisable(GL_ALPHA_TEST);
+    glUniform1i(discardRed, 1);
+    rectangle(42, 64, 0.5f, true);  // shader discard survives specialization
+
+    CHECK(pixel(10, 32, kRed));
+    CHECK(pixel(31, 32, kBlue));
+    CHECK(pixel(52, 32, kBlue));
+    for (int x : {10, 31, 52}) {
+        float depth = -1.0f;
+        glReadPixels(x, 32, 1, 1, GL_DEPTH_COMPONENT, GL_FLOAT, &depth);
+        CHECK(std::fabs(depth - (x == 10 ? 0.25f : 0.75f)) < 1e-5f);
+    }
+    glDisable(GL_DEPTH_TEST);
+    glUseProgram(0);
+    glDeleteProgram(program);
     CHECK_GL();
 }
